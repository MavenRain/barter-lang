    feThen (feAdc (fe0 a) (fe0 b) 0w) (fun (c0 : Prod Word Word) =>
    feThen (feAdc (fe1 a) (fe1 b) (second c0)) (fun (c1 : Prod Word Word) =>
    feThen (feAdc (fe2 a) (fe2 b) (second c1)) (fun (c2 : Prod Word Word) =>
    feThen (feAdc (fe3 a) (fe3 b) (second c2)) (fun (c3 : Prod Word Word) =>
    feThen (feAdc (fe4 a) (fe4 b) (second c3)) (fun (c4 : Prod Word Word) =>
    feThen (feAdc (fe5 a) (fe5 b) (second c4)) (fun (c5 : Prod Word Word) =>
    feThen (feAdc (fe6 a) (fe6 b) (second c5)) (fun (c6 : Prod Word Word) =>
    feThen (feAdc (fe7 a) (fe7 b) (second c6)) (fun (c7 : Prod Word Word) =>
    fe (first c0) (first c1) (first c2) (first c3) (first c4) (first c5) (first c6) (first c7)))))))))
def feSubRaw : Fe -> Fe -> Fe :=
  fun (a : Fe) (b : Fe) =>
    feThen (feSbb (fe0 a) (fe0 b) 0w) (fun (c0 : Prod Word Word) =>
    feThen (feSbb (fe1 a) (fe1 b) (second c0)) (fun (c1 : Prod Word Word) =>
    feThen (feSbb (fe2 a) (fe2 b) (second c1)) (fun (c2 : Prod Word Word) =>
    feThen (feSbb (fe3 a) (fe3 b) (second c2)) (fun (c3 : Prod Word Word) =>
    feThen (feSbb (fe4 a) (fe4 b) (second c3)) (fun (c4 : Prod Word Word) =>
    feThen (feSbb (fe5 a) (fe5 b) (second c4)) (fun (c5 : Prod Word Word) =>
    feThen (feSbb (fe6 a) (fe6 b) (second c5)) (fun (c6 : Prod Word Word) =>
    feThen (feSbb (fe7 a) (fe7 b) (second c6)) (fun (c7 : Prod Word Word) =>
    fe (first c0) (first c1) (first c2) (first c3) (first c4) (first c5) (first c6) (first c7)))))))))
-- feCmp x y k is inr unit when x < y, inl unit when y < x, else k unit.
def feCmp : Word -> Word -> (Unit -> Sum Unit Unit) -> Sum Unit Unit :=
  fun (x : Word) (y : Word) (k : Unit -> Sum Unit Unit) =>
    either (fun (u : Unit) => either k (fun (v : Unit) => feNo) (wLt y x)) (fun (u : Unit) => feYes) (wLt x y)
-- feLt a b is inr unit when a < b. It compares from the top limb down.
def feLt : Fe -> Fe -> Sum Unit Unit :=
  fun (a : Fe) (b : Fe) =>
    feCmp (fe7 a) (fe7 b) (fun (u : Unit) =>
    feCmp (fe6 a) (fe6 b) (fun (u : Unit) =>
    feCmp (fe5 a) (fe5 b) (fun (u : Unit) =>
    feCmp (fe4 a) (fe4 b) (fun (u : Unit) =>
    feCmp (fe3 a) (fe3 b) (fun (u : Unit) =>
    feCmp (fe2 a) (fe2 b) (fun (u : Unit) =>
    feCmp (fe1 a) (fe1 b) (fun (u : Unit) =>
    wLt (fe0 a) (fe0 b))))))))
-- feAll s k is k unit when s is inr unit, else inl unit.
def feAll : Sum Unit Unit -> (Unit -> Sum Unit Unit) -> Sum Unit Unit :=
  fun (s : Sum Unit Unit) (k : Unit -> Sum Unit Unit) => either (fun (u : Unit) => feNo) k s
-- feEq a b is inr unit when the limbs of a and b are equal. For canonical
-- values, this is the field equality.
def feEq : Fe -> Fe -> Sum Unit Unit :=
  fun (a : Fe) (b : Fe) =>
    feAll (wEq (fe0 a) (fe0 b)) (fun (u : Unit) =>
    feAll (wEq (fe1 a) (fe1 b)) (fun (u : Unit) =>
    feAll (wEq (fe2 a) (fe2 b)) (fun (u : Unit) =>
    feAll (wEq (fe3 a) (fe3 b)) (fun (u : Unit) =>
    feAll (wEq (fe4 a) (fe4 b)) (fun (u : Unit) =>
    feAll (wEq (fe5 a) (fe5 b)) (fun (u : Unit) =>
    feAll (wEq (fe6 a) (fe6 b)) (fun (u : Unit) =>
    wEq (fe7 a) (fe7 b))))))))
def feIsZero : Fe -> Sum Unit Unit := fun (a : Fe) => feEq a feZero
-- feCondSub m x is x - m when x is at least m, else x.
def feCondSub : Fe -> Fe -> Fe :=
  fun (m : Fe) (x : Fe) => either (fun (u : Unit) => feSubRaw x m) (fun (u : Unit) => x) (feLt x m)
-- The field add and subtract for the modulus md.
def feAdd : FeMod -> Fe -> Fe -> Fe :=
  fun (md : FeMod) (a : Fe) (b : Fe) => feCondSub (modM md) (feAddRaw a b)
def feSub : FeMod -> Fe -> Fe -> Fe :=
