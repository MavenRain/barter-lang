    lnLet (lnCol (ks2 s) (ks7 s) (ks12 s) (ks17 s) (ks22 s)) (fun (c2 : Lane) =>
    lnLet (lnCol (ks3 s) (ks8 s) (ks13 s) (ks18 s) (ks23 s)) (fun (c3 : Lane) =>
    lnLet (lnCol (ks4 s) (ks9 s) (ks14 s) (ks19 s) (ks24 s)) (fun (c4 : Lane) =>
