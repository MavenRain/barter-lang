    either (fun (u : Unit) =>
      either (fun (u1 : Unit) =>
        jcLet (feMul md (jcY a) (jcY a)) (fun (yy : Fe) =>
        jcLet (feMul md (jcX a) yy) (fun (s1 : Fe) =>
        jcLet (feAdd md s1 s1) (fun (s2 : Fe) =>
        jcLet (feAdd md s2 s2) (fun (s : Fe) =>
        jcLet (feMul md (jcX a) (jcX a)) (fun (xx : Fe) =>
        jcLet (feAdd md (feAdd md xx xx) xx) (fun (mm : Fe) =>
        jcLet (feSub md (feSub md (feMul md mm mm) s) s) (fun (x3 : Fe) =>
        jcLet (feMul md yy yy) (fun (y4 : Fe) =>
        jcLet (feAdd md y4 y4) (fun (y8a : Fe) =>
        jcLet (feAdd md y8a y8a) (fun (y8b : Fe) =>
        jcLet (feMul md (jcY a) (jcZ a)) (fun (yz : Fe) =>
        jac1 x3 (feSub md (feMul md mm (feSub md s x3)) (feAdd md y8b y8b)) (feAdd md yz yz)))))))))))))
      (fun (u1 : Unit) => jcInf)
      (feIsZero (jcY a)))
    (fun (u : Unit) => jcInf)
    (feIsZero (jcZ a))
-- ptMaddGen md a h s is the general case of ptMadd, with H = U - X and
-- R = S - Y (here s) not 0: X3 = R^2 - H^3 - 2 X H^2,
-- Y3 = R (X H^2 - X3) - Y H^3, Z3 = Z H.
def ptMaddGen : FeMod -> Jac1 -> Fe -> Fe -> Jac1 :=
  fun (md : FeMod) (a : Jac1) (h : Fe) (s : Fe) =>
    jcLet (feMul md h h) (fun (hh : Fe) =>
    jcLet (feMul md h hh) (fun (hhh : Fe) =>
    jcLet (feMul md (jcX a) hh) (fun (v : Fe) =>
    jcLet (feSub md (feSub md (feSub md (feMul md s s) hhh) v) v) (fun (x3 : Fe) =>
    jac1 x3 (feSub md (feMul md s (feSub md v x3)) (feMul md (jcY a) hhh)) (feMul md (jcZ a) h)))))
-- ptMadd md a b is a + b for the affine point b (ec0_jac_add_affine):
-- U = b.x Z^2, S = b.y Z^3, H = U - X, R = S - Y. When H = 0, it is 2 a
-- for R = 0, else the point at infinity.
def ptMadd : FeMod -> Jac1 -> Pt1 -> Jac1 :=
  fun (md : FeMod) (a : Jac1) (b : Pt1) =>
    either (fun (u : Unit) =>
      either (fun (u1 : Unit) =>
        jcLet (feMul md (jcZ a) (jcZ a)) (fun (zz : Fe) =>
        jcLet (feSub md (feMul md (ptX b) zz) (jcX a)) (fun (h : Fe) =>
        jcLet (feSub md (feMul md (feMul md (ptY b) zz) (jcZ a)) (jcY a)) (fun (s : Fe) =>
        either (fun (u2 : Unit) => ptMaddGen md a h s)
          (fun (u2 : Unit) => either (fun (u3 : Unit) => jcInf) (fun (u3 : Unit) => ptDbl md a) (feIsZero s))
          (feIsZero h)))))
      (fun (u1 : Unit) => jac1 (ptX b) (ptY b) (modR1 md))
      (feIsZero (jcZ a)))
    (fun (u : Unit) => a)
    (ptIsInf b)
-- ptToAffine md a is (X / Z^2, Y / Z^3) with one inverse (ec0_jac_affine),
-- and (0, 0) for Z = 0.
def ptToAffine : FeMod -> Jac1 -> Pt1 :=
  fun (md : FeMod) (a : Jac1) =>
    either (fun (u : Unit) =>
