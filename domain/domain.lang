-- Montgomery form mod p, as in Pt1.
-- An Fp2 is f2A + f2B u, with u^2 = -1.
family Fp2 := fp2 (f2A : Fe) (f2B : Fe)
-- An Fp6 is f6A + f6B v + f6C v^2, with v^3 = xi and xi = 9 + u.
family Fp6 := fp6 (f6A : Fp2) (f6B : Fp2) (f6C : Fp2)
-- An Fp12 is f12A + f12B w, with w^2 = v.
family Fp12 := fp12 (f12A : Fp6) (f12B : Fp6)
-- A Pt2 is a point of the twist y^2 = x^3 + 3 / xi over Fp2 in affine form.
-- (0, 0) is the point at infinity (EIP-197).
family Pt2 := pt2 (p2X : Fp2) (p2Y : Fp2)
-- A Jac2 is a point (X, Y, Z) of the twist in Jacobian form: the affine
-- point (X / Z^2, Y / Z^3). Z = 0 is the point at infinity.
family Jac2 := jac2 (j2X : Fp2) (j2Y : Fp2) (j2Z : Fp2)
