def f12Mul : (Fe -> Fe -> Fe) -> Fp12 -> Fp12 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (a : Fp12) (b : Fp12) =>
    fp12 (f6Add (f6Mul mul (f12A a) (f12A b)) (f6MulV (f6Mul mul (f12B a) (f12B b))))
      (f6Add (f6Mul mul (f12A a) (f12B b)) (f6Mul mul (f12B a) (f12A b)))
def f12Sqr : (Fe -> Fe -> Fe) -> Fp12 -> Fp12 := fun (mul : Fe -> Fe -> Fe) (a : Fp12) => f12Mul mul a a
def f12Conj : Fp12 -> Fp12 := fun (a : Fp12) => fp12 (f12A a) (f6Neg (f12B a))
-- f12Inv mul (a + b w) is (a - b w) / (a^2 - v b^2). f12InvBy takes the
-- inverse di of that divisor.
def f12InvBy : (Fe -> Fe -> Fe) -> Fp12 -> Fp6 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (a : Fp12) (di : Fp6) => fp12 (f6Mul mul (f12A a) di) (f6Neg (f6Mul mul (f12B a) di))
def f12Inv : (Fe -> Fe -> Fe) -> Fp12 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (a : Fp12) => f12InvBy mul a (f6Inv mul (f6Sub (f6Mul mul (f12A a) (f12A a)) (f6MulV (f6Mul mul (f12B a) (f12B a)))))
-- f12Frob mul a is a^p (the Frobenius map). The part at w^i becomes its
-- conjugate times frobGi. The parts at w^0 to w^5 are f6A (f12A a),
-- f6A (f12B a), f6B (f12A a), f6B (f12B a), f6C (f12A a) and f6C (f12B a).
def f12Frob : (Fe -> Fe -> Fe) -> Fp12 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (a : Fp12) =>
    fp12 (fp6 (f2Conj (f6A (f12A a))) (f2Mul mul (f2Conj (f6B (f12A a))) frobG2) (f2Mul mul (f2Conj (f6C (f12A a))) frobG4))
      (fp6 (f2Mul mul (f2Conj (f6A (f12B a))) frobG1) (f2Mul mul (f2Conj (f6B (f12B a))) frobG3) (f2Mul mul (f2Conj (f6C (f12B a))) frobG5))
-- f12PowFrom mul a e x is x^(2^n) a^e for the n bits of e (the top bit
-- first). f12Pow mul a e is a^e.
def f12PowFrom : (Fe -> Fe -> Fe) -> Fp12 -> FeBits -> Fp12 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (a : Fp12) (e : FeBits) => elim (fun (k : FeBits) => Fp12 -> Fp12)
    (fun (x : Fp12) => x)
    (fun (t : FeBits) (ih : Fp12 -> Fp12) => fun (x : Fp12) => ih (f12Sqr mul x))
    (fun (t : FeBits) (ih : Fp12 -> Fp12) => fun (x : Fp12) => ih (f12Mul mul (f12Sqr mul x) a)) e
def f12Pow : (Fe -> Fe -> Fe) -> Fp12 -> FeBits -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (a : Fp12) (e : FeBits) => f12PowFrom mul a e f12One
def f12Eq : Fp12 -> Fp12 -> Sum Unit Unit := fun (a : Fp12) (b : Fp12) => feAll (f6Eq (f12A a) (f12A b)) (fun (u : Unit) => f6Eq (f12B a) (f12B b))
-- G2 points and the lines of the Miller loop. p2Inf is the affine point at
-- infinity (0, 0). j2Inf is (1, 1, 0), the same as the C jac_infinity.
def p2Inf : Pt2 := pt2 f2Zero f2Zero
def j2Inf : Jac2 := jac2 f2One f2One f2Zero
-- f2IsZero a is inr unit when a is 0. f2MulFe mul a k is a k for the Fe k.
def f2IsZero : Fp2 -> Sum Unit Unit := fun (a : Fp2) => feAll (feIsZero (f2A a)) (fun (u : Unit) => feIsZero (f2B a))
def f2MulFe : (Fe -> Fe -> Fe) -> Fp2 -> Fe -> Fp2 := fun (mul : Fe -> Fe -> Fe) (a : Fp2) (k : Fe) => fp2 (mul (f2A a) k) (mul (f2B a) k)
-- j2Let x k, p2Let x k, lfLet x k and f12Let x k are k x. Each of the first
-- 3 binds one Fp2 value. f12Let binds one Fp12 value.
def j2Let : Fp2 -> (Fp2 -> Jac2) -> Jac2 := fun (x : Fp2) (k : Fp2 -> Jac2) => k x
def p2Let : Fp2 -> (Fp2 -> Pt2) -> Pt2 := fun (x : Fp2) (k : Fp2 -> Pt2) => k x
def lfLet : Fp2 -> (Fp2 -> Fp12) -> Fp12 := fun (x : Fp2) (k : Fp2 -> Fp12) => k x
def f12Let : Fp12 -> (Fp12 -> Fp12) -> Fp12 := fun (x : Fp12) (k : Fp12 -> Fp12) => k x
-- p2IsInf q is inr unit when q is (0, 0). p2Eq a b is inr unit when a and b
-- have the same coordinates.
def p2IsInf : Pt2 -> Sum Unit Unit := fun (q : Pt2) => feAll (f2IsZero (p2X q)) (fun (u : Unit) => f2IsZero (p2Y q))
def p2Eq : Pt2 -> Pt2 -> Sum Unit Unit := fun (a : Pt2) (b : Pt2) => feAll (f2Eq (p2X a) (p2X b)) (fun (u : Unit) => f2Eq (p2Y a) (p2Y b))
-- p2OnCurve mul q is inr unit when each of the 4 Fe of q is less than the
-- modulus and q is the point at infinity or y^2 = x^3 + twistB.
def p2OnCurve : (Fe -> Fe -> Fe) -> Pt2 -> Sum Unit Unit :=
  fun (mul : Fe -> Fe -> Fe) (q : Pt2) =>
    feAll (feLt (f2B (p2X q)) (modM fpMod)) (fun (u : Unit) =>
    feAll (feLt (f2A (p2X q)) (modM fpMod)) (fun (u1 : Unit) =>
    feAll (feLt (f2B (p2Y q)) (modM fpMod)) (fun (u2 : Unit) =>
    feAll (feLt (f2A (p2Y q)) (modM fpMod)) (fun (u3 : Unit) =>
    either (fun (u4 : Unit) => f2Eq (f2Sqr mul (p2Y q)) (f2Add (f2Mul mul (f2Sqr mul (p2X q)) (p2X q)) twistB))
      (fun (u4 : Unit) => feYes)
      (p2IsInf q)))))
-- p2Neg q is -q = (x, -y). p2Psi mul q is (conj(x) frobG2, conj(y) frobG3).
def p2Neg : Pt2 -> Pt2 := fun (q : Pt2) => pt2 (p2X q) (f2Neg (p2Y q))
def p2Psi : (Fe -> Fe -> Fe) -> Pt2 -> Pt2 :=
  fun (mul : Fe -> Fe -> Fe) (q : Pt2) => pt2 (f2Mul mul (f2Conj (p2X q)) frobG2) (f2Mul mul (f2Conj (p2Y q)) frobG3)
-- p2ToJac q is (x, y, 1), and j2Inf for the point at infinity.
def p2ToJac : Pt2 -> Jac2 :=
  fun (q : Pt2) => either (fun (u : Unit) => jac2 (p2X q) (p2Y q) f2One) (fun (u : Unit) => j2Inf) (p2IsInf q)
-- j2Dbl mul t is 2 t (g2_jac_double): M = 3 X^2, S = 4 X Y^2, X3 = M^2 - 2 S,
-- Y3 = M (S - X3) - 8 Y^4, Z3 = 2 Y Z. It has no special case.
def j2Dbl : (Fe -> Fe -> Fe) -> Jac2 -> Jac2 :=
  fun (mul : Fe -> Fe -> Fe) (t : Jac2) =>
    j2Let (f2Sqr mul (j2X t)) (fun (x2 : Fp2) =>
    j2Let (f2Add (f2Add x2 x2) x2) (fun (m : Fp2) =>
    j2Let (f2Sqr mul (j2Y t)) (fun (y2 : Fp2) =>
    j2Let (f2Mul mul (j2X t) y2) (fun (s1 : Fp2) =>
    j2Let (f2Add s1 s1) (fun (s2 : Fp2) =>
    j2Let (f2Add s2 s2) (fun (s : Fp2) =>
    j2Let (f2Sub (f2Sub (f2Sqr mul m) s) s) (fun (x3 : Fp2) =>
    j2Let (f2Sqr mul y2) (fun (y4 : Fp2) =>
    j2Let (f2Add y4 y4) (fun (y8a : Fp2) =>
    j2Let (f2Add y8a y8a) (fun (y8b : Fp2) =>
    j2Let (f2Sub (f2Mul mul m (f2Sub s x3)) (f2Add y8b y8b)) (fun (y3 : Fp2) =>
    j2Let (f2Mul mul (j2Y t) (j2Z t)) (fun (yz : Fp2) =>
    jac2 x3 y3 (f2Add yz yz)))))))))))))
-- j2AddGen mul t h r is the general case of j2AddAff, with H = h and R = r:
-- X3 = R^2 - H^3 - 2 X H^2, Y3 = R (X H^2 - X3) - Y H^3, Z3 = Z H.
def j2AddGen : (Fe -> Fe -> Fe) -> Jac2 -> Fp2 -> Fp2 -> Jac2 :=
  fun (mul : Fe -> Fe -> Fe) (t : Jac2) (h : Fp2) (r : Fp2) =>
    j2Let (f2Sqr mul h) (fun (h2 : Fp2) =>
    j2Let (f2Mul mul h2 h) (fun (h3 : Fp2) =>
    j2Let (f2Mul mul (j2X t) h2) (fun (xh2 : Fp2) =>
    j2Let (f2Sub (f2Sub (f2Sub (f2Sqr mul r) h3) xh2) xh2) (fun (x3 : Fp2) =>
    jac2 x3 (f2Sub (f2Mul mul r (f2Sub xh2 x3)) (f2Mul mul (j2Y t) h3)) (f2Mul mul (j2Z t) h)))))
-- j2AddAff mul t q is t + q for the affine point q (g2_jac_add_affine):
-- U = xQ Z^2, S2 = yQ Z^3, H = U - X, R = S2 - Y. When H = 0, it is 2 t for
-- R = 0, else j2Inf.
def j2AddAff : (Fe -> Fe -> Fe) -> Jac2 -> Pt2 -> Jac2 :=
  fun (mul : Fe -> Fe -> Fe) (t : Jac2) (q : Pt2) =>
    either (fun (u : Unit) =>
      either (fun (u1 : Unit) =>
        j2Let (f2Sqr mul (j2Z t)) (fun (z2 : Fp2) =>
        j2Let (f2Mul mul z2 (j2Z t)) (fun (z3 : Fp2) =>
        j2Let (f2Mul mul (p2X q) z2) (fun (uu : Fp2) =>
        j2Let (f2Mul mul (p2Y q) z3) (fun (s2 : Fp2) =>
        j2Let (f2Sub uu (j2X t)) (fun (h : Fp2) =>
        j2Let (f2Sub s2 (j2Y t)) (fun (r : Fp2) =>
        either (fun (u2 : Unit) => j2AddGen mul t h r)
          (fun (u2 : Unit) => either (fun (u3 : Unit) => j2Inf) (fun (u3 : Unit) => j2Dbl mul t) (f2IsZero r))
          (f2IsZero h))))))))
      (fun (u1 : Unit) => p2ToJac q)
      (f2IsZero (j2Z t)))
    (fun (u : Unit) => t)
    (p2IsInf q)
-- j2ToAff mul t is (X / Z^2, Y / Z^3) with one inverse (g2_jac_affine), and
-- p2Inf for Z = 0.
def j2ToAff : (Fe -> Fe -> Fe) -> Jac2 -> Pt2 :=
  fun (mul : Fe -> Fe -> Fe) (t : Jac2) =>
    either (fun (u : Unit) =>
      p2Let (f2Inv mul (j2Z t)) (fun (zi : Fp2) =>
      p2Let (f2Sqr mul zi) (fun (zi2 : Fp2) =>
      p2Let (f2Mul mul zi2 zi) (fun (zi3 : Fp2) =>
      pt2 (f2Mul mul (j2X t) zi2) (f2Mul mul (j2Y t) zi3)))))
      (fun (u : Unit) => p2Inf)
      (f2IsZero (j2Z t))
-- p2Add mul a b is a + b (g2_add).
def p2Add : (Fe -> Fe -> Fe) -> Pt2 -> Pt2 -> Pt2 :=
  fun (mul : Fe -> Fe -> Fe) (a : Pt2) (b : Pt2) => j2ToAff mul (j2AddAff mul (p2ToJac a) b)
-- lineFp12 c0 c1 c3 is the line value as a full Fp12 (fp12_mul_line):
-- (c0, 0, 0) + (c1, c3, 0) w.
def lineFp12 : Fp2 -> Fp2 -> Fp2 -> Fp12 :=
  fun (c0 : Fp2) (c1 : Fp2) (c3 : Fp2) => fp12 (fp6 c0 f2Zero f2Zero) (fp6 c1 c3 f2Zero)
-- lineDbl mul p t is the tangent at t for the G1 point p, times Z3 Z^2
-- (pairing_line_double): M = 3 X^2, c3 = M X - 2 Y^2, c1 = -(M Z^2 xP),
-- c0 = Z3 Z^2 yP with Z3 = 2 Y Z. The step to 2 t is j2Dbl.
def lineDbl : (Fe -> Fe -> Fe) -> Pt1 -> Jac2 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (p : Pt1) (t : Jac2) =>
    lfLet (f2Sqr mul (j2X t)) (fun (x2 : Fp2) =>
    lfLet (f2Add (f2Add x2 x2) x2) (fun (m : Fp2) =>
    lfLet (f2Sqr mul (j2Y t)) (fun (y2 : Fp2) =>
    lfLet (f2Sqr mul (j2Z t)) (fun (z2 : Fp2) =>
    lfLet (f2Sub (f2Mul mul m (j2X t)) (f2Add y2 y2)) (fun (c3 : Fp2) =>
    lfLet (f2Neg (f2MulFe mul (f2Mul mul m z2) (ptX p))) (fun (c1 : Fp2) =>
    lfLet (f2Mul mul (j2Y t) (j2Z t)) (fun (yz : Fp2) =>
    lineFp12 (f2MulFe mul (f2Mul mul (f2Add yz yz) z2) (ptY p)) c1 c3)))))))
-- lineAddBy mul p q r t2 is the line value of lineAdd with R = r and the sum
-- t2 = t + q: c0 = Z(t2) yP, c1 = -(R xP), c3 = R xQ - yQ Z(t2).
def lineAddBy : (Fe -> Fe -> Fe) -> Pt1 -> Pt2 -> Fp2 -> Jac2 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (p : Pt1) (q : Pt2) (r : Fp2) (t2 : Jac2) =>
    lfLet (f2MulFe mul (j2Z t2) (ptY p)) (fun (c0 : Fp2) =>
    lfLet (f2Neg (f2MulFe mul r (ptX p))) (fun (c1 : Fp2) =>
    lineFp12 c0 c1 (f2Sub (f2Mul mul r (p2X q)) (f2Mul mul (p2Y q) (j2Z t2)))))
-- lineAdd mul p q t is the chord of t and q for the G1 point p, times Z3
-- (pairing_line_add), with R = yQ Z^3 - Y. The step to t + q is j2AddAff.
def lineAdd : (Fe -> Fe -> Fe) -> Pt1 -> Pt2 -> Jac2 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (p : Pt1) (q : Pt2) (t : Jac2) =>
    lineAddBy mul p q (f2Sub (f2Mul mul (p2Y q) (f2Mul mul (f2Sqr mul (j2Z t)) (j2Z t))) (j2Y t)) (j2AddAff mul t q)
-- S8c u3b (D3b): a MilSt is the state of the Miller loop, the value msF and
-- the point msT. milDbl mul p s is one double step: F^2 times lineDbl at T,
-- and 2 T. milAdd mul p q s is one add step: F times lineAdd at T and q,
-- and T + q. Each line value is from T before the step (pairing_miller).
family MilSt := milSt (msF : Fp12) (msT : Jac2)
def milDbl : (Fe -> Fe -> Fe) -> Pt1 -> MilSt -> MilSt :=
  fun (mul : Fe -> Fe -> Fe) (p : Pt1) (s : MilSt) =>
    milSt (f12Mul mul (f12Sqr mul (msF s)) (lineDbl mul p (msT s))) (j2Dbl mul (msT s))
def milAdd : (Fe -> Fe -> Fe) -> Pt1 -> Pt2 -> MilSt -> MilSt :=
  fun (mul : Fe -> Fe -> Fe) (p : Pt1) (q : Pt2) (s : MilSt) =>
    milSt (f12Mul mul (msF s) (lineAdd mul p q (msT s))) (j2AddAff mul (msT s) q)
-- milBits mul p q e s does the steps of the bits of e on s, the top bit
-- first: a double step for each bit, then an add step for a 1 bit.
def milBits : (Fe -> Fe -> Fe) -> Pt1 -> Pt2 -> FeBits -> MilSt -> MilSt :=
  fun (mul : Fe -> Fe -> Fe) (p : Pt1) (q : Pt2) (e : FeBits) => elim (fun (k : FeBits) => MilSt -> MilSt)
    (fun (s : MilSt) => s)
    (fun (t : FeBits) (ih : MilSt -> MilSt) => fun (s : MilSt) => ih (milDbl mul p s))
    (fun (t : FeBits) (ih : MilSt -> MilSt) => fun (s : MilSt) => ih (milAdd mul p q (milDbl mul p s))) e
-- milTail mul p q s is the F of the 2 add steps of the tail: first with
-- q1 = psi(q), then with q2 = -psi(q1).
def milTail : (Fe -> Fe -> Fe) -> Pt1 -> Pt2 -> MilSt -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (p : Pt1) (q : Pt2) (s : MilSt) =>
    msF (milAdd mul p (p2Neg (p2Psi mul (p2Psi mul q))) (milAdd mul p (p2Psi mul q) s))
-- milBitsOf p is millerBits. It is an elim on p: the load evaluates each def
-- below its binders, and for a variable p it stops here. Thus it does not
-- unroll the 64 steps of milBits in miller.
def milBitsOf : Pt1 -> FeBits := fun (p : Pt1) => elim (fun (k : Pt1) => FeBits) (fun (x : Fe) (y : Fe) => millerBits) p
-- miller mul p q is the value of pairing_miller: f12One when p or q is the
-- point at infinity, else milBits over millerBits from (f12One, q), then
-- milTail.
def miller : (Fe -> Fe -> Fe) -> Pt1 -> Pt2 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (p : Pt1) (q : Pt2) =>
    either (fun (u : Unit) =>
      either (fun (u1 : Unit) => milTail mul p q (milBits mul p q (milBitsOf p) (milSt f12One (p2ToJac q))))
        (fun (u1 : Unit) => f12One)
        (p2IsInf q))
      (fun (u : Unit) => f12One)
      (ptIsInf p)
-- finEasy mul f is the value of pairing_final_easy: f^((p^6 - 1)(p^2 + 1)).
-- With f1 = conj(f) / f, it is frob(frob(f1)) f1.
def finEasy : (Fe -> Fe -> Fe) -> Fp12 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (f : Fp12) =>
    f12Let (f12Mul mul (f12Conj f) (f12Inv mul f)) (fun (f1 : Fp12) => f12Mul mul (f12Frob mul (f12Frob mul f1)) f1)
-- finHardBy mul m fx fx2 fx3 is the value of pairing_final_hard for m, with
-- fx = m^x, fx2 = fx^x and fx3 = fx2^x. The order of the operations is the
-- order of the C function: y0 = mp mp2 mp3, y1 = conj(m), y2 = frob(frob(fx2)),
-- y3 = conj(frob(fx)), y4 = conj(fx frob(fx2)), y5 = conj(fx2) and
-- y6 = conj(fx3 frob(fx3)), where mp = frob(m), mp2 = frob(mp), mp3 = frob(mp2).
-- Then t0 = y6^2 y4 y5, t1 = ((y3 y5 t0)^2 t0 y2)^2, and the value is
-- (t1 y1)^2 (t1 y0).
def finHardBy : (Fe -> Fe -> Fe) -> Fp12 -> Fp12 -> Fp12 -> Fp12 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (m : Fp12) (fx : Fp12) (fx2 : Fp12) (fx3 : Fp12) =>
    f12Let (f12Frob mul m) (fun (mp : Fp12) =>
    f12Let (f12Frob mul mp) (fun (mp2 : Fp12) =>
    f12Let (f12Mul mul (f12Mul mul mp mp2) (f12Frob mul mp2)) (fun (y0 : Fp12) =>
    f12Let (f12Conj fx2) (fun (y5 : Fp12) =>
    f12Let (f12Mul mul (f12Mul mul (f12Sqr mul (f12Conj (f12Mul mul fx3 (f12Frob mul fx3)))) (f12Conj (f12Mul mul fx (f12Frob mul fx2)))) y5) (fun (t0 : Fp12) =>
    f12Let (f12Sqr mul (f12Mul mul (f12Sqr mul (f12Mul mul (f12Mul mul (f12Conj (f12Frob mul fx)) y5) t0)) (f12Mul mul t0 (f12Frob mul (f12Frob mul fx2))))) (fun (t1 : Fp12) =>
    f12Mul mul (f12Sqr mul (f12Mul mul t1 (f12Conj m))) (f12Mul mul t1 y0)))))))
-- finXBitsOf a is bnXBits. It is an elim on a: the load evaluates each def
-- below its binders, and for a variable a it stops here. Thus it does not
-- unroll the 64 steps of f12Pow in finHard.
def finXBitsOf : Fp12 -> FeBits := fun (a : Fp12) => elim (fun (k : Fp12) => FeBits) (fun (b : Fp6) (c : Fp6) => bnXBits) a
-- finHard mul m is the value of pairing_final_hard: fx = m^x, fx2 = fx^x and
-- fx3 = fx2^x (x is bnXBits), then finHardBy.
def finHard : (Fe -> Fe -> Fe) -> Fp12 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (m : Fp12) =>
    f12Let (f12Pow mul m (finXBitsOf m)) (fun (fx : Fp12) =>
    f12Let (f12Pow mul fx (finXBitsOf fx)) (fun (fx2 : Fp12) =>
    f12Let (f12Pow mul fx2 (finXBitsOf fx2)) (fun (fx3 : Fp12) => finHardBy mul m fx fx2 fx3)))
-- finalExp mul f is the value of pairing_final: finHard mul (finEasy mul f).
def finalExp : (Fe -> Fe -> Fe) -> Fp12 -> Fp12 := fun (mul : Fe -> Fe -> Fe) (f : Fp12) => finHard mul (finEasy mul f)
-- p2MulFrom mul q e t does the bits of e on t, the top bit first: it
-- doubles t, and a 1 bit then adds q (g2_mul, the ptMulWord form).
def p2MulFrom : (Fe -> Fe -> Fe) -> Pt2 -> FeBits -> Jac2 -> Jac2 :=
  fun (mul : Fe -> Fe -> Fe) (q : Pt2) (e : FeBits) => elim (fun (k : FeBits) => Jac2 -> Jac2)
    (fun (t : Jac2) => t)
    (fun (s : FeBits) (ih : Jac2 -> Jac2) => fun (t : Jac2) => ih (j2Dbl mul t))
    (fun (s : FeBits) (ih : Jac2 -> Jac2) => fun (t : Jac2) => ih (j2AddAff mul (j2Dbl mul t) q)) e
-- p2XBitsOf q is bnXBits. It is an elim on q: the load evaluates each def
-- below its binders, and for a variable q it stops here. Thus it does not
-- unroll the 63 steps of p2MulFrom in p2MulX.
def p2XBitsOf : Pt2 -> FeBits := fun (q : Pt2) => elim (fun (k : Pt2) => FeBits) (fun (x : Fp2) (y : Fp2) => bnXBits) q
-- p2MulX mul q is [x] q (g2_mul with k = x): p2MulFrom over bnXBits from
-- j2Inf, then j2ToAff.
def p2MulX : (Fe -> Fe -> Fe) -> Pt2 -> Pt2 := fun (mul : Fe -> Fe -> Fe) (q : Pt2) => j2ToAff mul (p2MulFrom mul q (p2XBitsOf q) j2Inf)
-- p2SubLet x k is k x (a let for the subgroup test).
def p2SubLet : Pt2 -> (Pt2 -> Sum Unit Unit) -> Sum Unit Unit := fun (x : Pt2) (k : Pt2 -> Sum Unit Unit) => k x
-- p2InSubBy mul q a is the test of g2_in_subgroup for a = [x] q:
-- [x + 1] q + psi(a) + psi^2(a) = psi^3([2 x] q). With b = psi(a),
-- a1 = a + q, c = psi(b), d = (c + b) + a1 and e = psi(c), it compares
-- e + e with d. The order of the operations is the order of the C function.
def p2InSubBy : (Fe -> Fe -> Fe) -> Pt2 -> Pt2 -> Sum Unit Unit :=
  fun (mul : Fe -> Fe -> Fe) (q : Pt2) (a : Pt2) =>
    p2SubLet (p2Psi mul a) (fun (b : Pt2) =>
    p2SubLet (p2Add mul a q) (fun (a1 : Pt2) =>
    p2SubLet (p2Psi mul b) (fun (c : Pt2) =>
    p2SubLet (p2Add mul (p2Add mul c b) a1) (fun (d : Pt2) =>
    p2SubLet (p2Psi mul c) (fun (e : Pt2) =>
    p2Eq (p2Add mul e e) d)))))
-- p2InSub mul q is g2_in_subgroup: q is on the curve (p2OnCurve), and
-- p2InSubBy holds for a = [x] q.
def p2InSub : (Fe -> Fe -> Fe) -> Pt2 -> Sum Unit Unit :=
  fun (mul : Fe -> Fe -> Fe) (q : Pt2) => feAll (p2OnCurve mul q) (fun (u : Unit) => p2InSubBy mul q (p2MulX mul q))
-- pairInputsOk mul l is inr unit when each P of l is on the curve
-- (ptOnCurve) and each Q of l is in the subgroup (p2InSub). The point at
-- infinity passes both checks, as in the C code.
def pairInputsOk : (Fe -> Fe -> Fe) -> PairList -> Sum Unit Unit :=
  fun (mul : Fe -> Fe -> Fe) (l : PairList) => elim (fun (k : PairList) => Sum Unit Unit) feYes
    (fun (p : Pt1) (q : Pt2) (t : PairList) (ih : Sum Unit Unit) => feAll (ptOnCurve fpMod p) (fun (u : Unit) => feAll (p2InSub mul q) (fun (u1 : Unit) => ih))) l
-- millerProdBy mul l f multiplies f by miller P Q for each pair of l, in
-- list order (the loop of pairing_check). millerProd mul l starts at f12One.
def millerProdBy : (Fe -> Fe -> Fe) -> PairList -> Fp12 -> Fp12 :=
  fun (mul : Fe -> Fe -> Fe) (l : PairList) => elim (fun (k : PairList) => Fp12 -> Fp12)
    (fun (f : Fp12) => f)
    (fun (p : Pt1) (q : Pt2) (t : PairList) (ih : Fp12 -> Fp12) => fun (f : Fp12) => ih (f12Mul mul f (miller mul p q))) l
def millerProd : (Fe -> Fe -> Fe) -> PairList -> Fp12 := fun (mul : Fe -> Fe -> Fe) (l : PairList) => millerProdBy mul l f12One
-- f12IsOne a is inr unit when a is f12One (fp12_is_one).
def f12IsOne : Fp12 -> Sum Unit Unit := fun (a : Fp12) => f12Eq a f12One
-- pairExpOf l is finalExp. It is an elim on l: the load evaluates each def
-- below its binders, and for a variable l it stops here. Thus it does not
-- unroll the 3 f12Pow passes of finHard in pairingCheck.
def pairExpOf : PairList -> (Fe -> Fe -> Fe) -> Fp12 -> Fp12 :=
  fun (l : PairList) => elim (fun (k : PairList) => (Fe -> Fe -> Fe) -> Fp12 -> Fp12) finalExp
    (fun (p : Pt1) (q : Pt2) (t : PairList) (ih : (Fe -> Fe -> Fe) -> Fp12 -> Fp12) => finalExp) l
-- pairingCheck mul l is pairing_check with the input checks first: inl unit
-- when an input check fails (no Miller loop and no final power), else
-- f12IsOne of the final power (pairExpOf l) of millerProd.
def pairingCheck : (Fe -> Fe -> Fe) -> PairList -> Sum Unit Unit :=
  fun (mul : Fe -> Fe -> Fe) (l : PairList) =>
    either (fun (u : Unit) => feNo) (fun (u : Unit) => f12IsOne (pairExpOf l mul (millerProd mul l))) (pairInputsOk mul l)
-- The token and the nullifier: one constructor over Nat each. tkEq and
-- nfEq are the equality words (inr unit is "equal").
family Token := token (tokId : Nat)
def tkEq : Token -> Token -> Sum Unit Unit :=
  fun (a : Token) (b : Token) => elim (fun (u : Token) => Sum Unit Unit)
    (fun (i : Nat) => elim (fun (v : Token) => Sum Unit Unit)
      (fun (j : Nat) => flagIf (natEq i j) (inr unit) (inl unit)) b) a
family Nullifier := nullifier (nfId : Nat)
def nfEq : Nullifier -> Nullifier -> Sum Unit Unit :=
  fun (a : Nullifier) (b : Nullifier) => elim (fun (u : Nullifier) => Sum Unit Unit)
    (fun (i : Nat) => elim (fun (v : Nullifier) => Sum Unit Unit)
      (fun (j : Nat) => flagIf (natEq i j) (inr unit) (inl unit)) b) a
-- The opaque types (design sec 3): one constructor over Nat each. Their
-- equality words come with the slice that needs them (S6, S7); Hash comes
-- at S8b.
-- Key and Sig (Q-S8b-6 (a), S8b2): a key holds the point P of G1, and a
-- signature holds the Schnorr pair (R, s).
family Key := key (keyPt : Pt1)
family Sig := sig (sigR : Pt1) (sigS : Fr)
family Commitment := commitment (cmtId : Nat)
family Root := root (rootId : Nat)
-- The swap of design sec 4 (S6). Intent, Quote, Transfer and Fill are
-- records: a family with one constructor, so each field is a projection.
-- A domain field name is global (rule R4), so each field name has the
-- prefix of its record. A program reads an Amount or Height field of a
-- record parameter at its width (Q-S6-1 (a)) and a Window field of a
-- record parameter at the Window widths (Q-S6-2 (a)). The decoy index is
-- a Sealed Height (OI-6).
family Intent := intent (itInTok : Token) (itOutTok : Token) (itAmtIn : Sealed Amount) (itMinOut : Sealed Amount) (itDecoy : Sealed Height) (itStartOut : Amount) (itWindow : Window) (itDeadline : Height) (itNf : Nullifier) (itOwner : Key) (itSig : Sig)
family Quote := quote (qtOut : Sealed Amount) (qtSolver : Key)
family Transfer := transfer (trTok : Token) (trAmt : Amount) (trFrom : Key) (trTo : Key)
family Fill := fill (flIntent : Intent) (flQuote : Quote) (flLegIn : Transfer) (flLegOut : Transfer) (flHeight : Height)
-- The reasons of a rejected settle. S6 uses reused, expired, badPair,
-- badProof and belowFloor. badCert, belowTMin, badPrice and noFunds come
-- with S7, badShare with S8b.
family Reason := badProof | badShare | expired | reused | badPair | belowFloor | badCert | belowTMin | badPrice | noFunds
-- A verdict is accept with a value or reject with a reason. The value
-- field is vdVal, because vdOk is the name of a law of S6.
family Verdict (A : Type 0) := accept (vdVal : A) | reject (vdWhy : Reason)
-- The outcome of a settle is two transfers. unfilled comes with the replay
-- of S7.
family Outcome := settled (stIn : Transfer) (stOut : Transfer) | unfilled
-- The spent nullifiers: the spent field of the Book of S7 (Q-S6-6 (a), Q-S7-5 (a)).
family Spent := spNil | spCons (spHead : Nullifier) (spTail : Spent)
-- vdCheck A s w v is v when s says yes, else reject A w.
def vdCheck : (A : Type 0) -> Sum Unit Unit -> Reason -> Verdict A -> Verdict A :=
  fun (A : Type 0) (s : Sum Unit Unit) (w : Reason) (v : Verdict A) =>
    elim (fun (k : Sum Unit Unit) => Verdict A) (fun (u : Unit) => reject A w) (fun (u : Unit) => v) s
-- spHas n l says yes when the nullifier n is in l.
def spHas : Nullifier -> Spent -> Sum Unit Unit :=
  fun (n : Nullifier) (l : Spent) =>
    elim (fun (k : Spent) => Sum Unit Unit) (inl unit) (fun (g : Nullifier) (t : Spent) (ih : Sum Unit Unit) => sOr (nfEq n g) ih) l
-- sgVrf k g m says yes when the signature g is from the key k on the
-- message m: the Schnorr check (Q-S8b-6 (a), Q-S8b2-2 (a)). sgVrf calls the
-- C builtin schnorrCheckC; the guest schnorrCheck is the specification
-- (Q-S8b2-36 (a)).
def sgVrf : Key -> Sig -> Fe -> Sum Unit Unit :=
  fun (k : Key) (g : Sig) (m : Fe) => elim (fun (u : Key) => Sum Unit Unit)
    (fun (p : Pt1) => elim (fun (v : Sig) => Sum Unit Unit)
      (fun (r : Pt1) (s : Fr) => schnorrCheckC p r s m) g) k
-- encMap2 (Q-S6-3 (a)) maps a word with two arguments over two sealed
-- values: encBind on the first value, encMap on the second value.
def encMap2 : (A : Type 0) -> (B : Type 0) -> (C : Type 0) -> (A -> B -> C) -> Sealed A -> Sealed B -> Sealed C :=
  fun (A : Type 0) (B : Type 0) (C : Type 0) (g : A -> B -> C) (m : Sealed A) (n : Sealed B) =>
    encBind A C m (fun (a : A) => encMap B C (fun (b : B) => g a b) n)
-- wClamp w h is the height h clamped into [wStart w, wStart w + wLen w].
def wClamp : Window -> Height -> Height :=
  fun (w : Window) (h : Height) =>
    htSelect Height h (wStart w) (wStart w)
      (htSelect Height (htAdd (wStart w) (wLen w)) h (htAdd (wStart w) (wLen w)) h)
-- The decay floor of design sec 4 (Q-S6-5 (a)). At the clamped height hc
-- the floor is so - (so - m)(hc - s)/wl, with the window start s, the
-- window length wl, startOut so and minOut m. The test o >= floor is
-- wl*o + hc*so + s*m >= wl*so + hc*m + s*so: it has no subtraction and
-- no division. decayTest wl s hc o so m says yes when the quote output o
-- is at or above the floor. Bounds: wl <= 2^32, s <= 2^32 - 1,
-- hc < 2^33 and each amount <= 2^64 - 1, thus each product is below 2^97
-- and each side is below 2^98, in the word.
def decayTest : Height -> Height -> Height -> Amount -> Amount -> Amount -> Sum Unit Unit :=
  fun (wl : Height) (s : Height) (hc : Height) (o : Amount) (so : Amount) (m : Amount) =>
    amLe (amAdd (amScale wl so) (amAdd (amScale hc m) (amScale s so)))
      (amAdd (amScale wl o) (amAdd (amScale hc so) (amScale s m)))
-- decayAt i h o m is the decay test of the intent i at the height h, for
-- the open quote output o and the open minOut m. It does not use open.
def decayAt : Intent -> Height -> Amount -> Amount -> Sum Unit Unit :=
  fun (i : Intent) (h : Height) (o : Amount) (m : Amount) =>
    decayTest (wLen (itWindow i)) (wStart (itWindow i)) (wClamp (itWindow i) h) o (itStartOut i) m
-- cross i q h is the sealed decay test: the quote output and minOut stay
-- sealed (Q-S6-3 (a)).
def cross : Intent -> Quote -> Height -> Sealed (Sum Unit Unit) :=
  fun (i : Intent) (q : Quote) (h : Height) =>
    encMap2 Amount Amount (Sum Unit Unit) (fun (o : Amount) (m : Amount) => decayAt i h o m) (qtOut q) (itMinOut i)
-- settleOut i q is the two transfers of a fill: amtIn from the owner to
-- the solver, and the quote output from the solver to the owner.
def settleOut : Intent -> Quote -> Outcome :=
  fun (i : Intent) (q : Quote) =>
    settled (transfer (itInTok i) (open Amount (itAmtIn i)) (itOwner i) (qtSolver q))
      (transfer (itOutTok i) (open Amount (qtOut q)) (qtSolver q) (itOwner i))
-- The laws of the swap (S6, design sec 4). vdOk and vdBad are the two
-- steps down a chain of checks: a check with the flag yes gives the rest
-- of the chain, and a check with the flag no gives reject with its reason.
law def vdOk : (A : Type 0) -> (f : Sum Unit Unit) -> (w : Reason) -> (v : Verdict A) -> Path (Sum Unit Unit) f (inr unit) -> Path (Verdict A) (vdCheck A f w v) v :=
  fun (A : Type 0) (f : Sum Unit Unit) (w : Reason) (v : Verdict A) (p : Path (Sum Unit Unit) f (inr unit)) =>
    cong (fun (b : Sum Unit Unit) => vdCheck A b w v) p
law def vdBad : (A : Type 0) -> (f : Sum Unit Unit) -> (w : Reason) -> (v : Verdict A) -> Path (Sum Unit Unit) f (inl unit) -> Path (Verdict A) (vdCheck A f w v) (reject A w) :=
  fun (A : Type 0) (f : Sum Unit Unit) (w : Reason) (v : Verdict A) (p : Path (Sum Unit Unit) f (inl unit)) =>
    cong (fun (b : Sum Unit Unit) => vdCheck A b w v) p
-- S2 (Q-S6-5 (a)): open of a sealed map with two arguments is the map of
-- the open values. Thus the sealed decay test cross gives the decay test
-- of the open quote output and the open minOut.
law def openMap2 : (A : Type 0) -> (B : Type 0) -> (C : Type 0) -> (g : A -> B -> C) -> (m : Sealed A) -> (n : Sealed B) -> Path C (open C (encMap2 A B C g m n)) (g (open A m) (open B n)) :=
  fun (A : Type 0) (B : Type 0) (C : Type 0) (g : A -> B -> C) (m : Sealed A) (n : Sealed B) =>
    elim (fun (s : Sealed A) => Path C (open C (encMap2 A B C g s n)) (g (open A s) (open B n)))
      (fun (a : A) =>
        elim (fun (t : Sealed B) => Path C (open C (encMap2 A B C g (seal A a) t)) (g a (open B t))) (fun (b : B) => refl) n) m
law def s2Cross : (i : Intent) -> (q : Quote) -> (h : Height) -> Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (decayAt i h (open Amount (qtOut q)) (open Amount (itMinOut i))) :=
  fun (i : Intent) (q : Quote) (h : Height) =>
    openMap2 Amount Amount (Sum Unit Unit) (fun (o : Amount) (m : Amount) => decayAt i h o m) (qtOut q) (itMinOut i)
-- S5: the outcome of a fill entry is its two legs. Both legs are in one
-- entry, or the entry is not in the log.
def fillOutcome : Fill -> Outcome :=
  fun (f : Fill) => settled (flLegIn f) (flLegOut f)
law def s5Fill : (f : Fill) -> Path Outcome (fillOutcome f) (settled (flLegIn f) (flLegOut f)) :=
  fun (f : Fill) => refl
-- The governance of design sec 5 (S7). Members is the committee: a list of
-- keys. A Pair is a token pair that the Params admit for a swap.
family Members := mbNil | mbCons (mbHead : Key) (mbTail : Members)
family Pair := tradePair (paIn : Token) (paOut : Token)
family Pairs := paNil | paCons (paHead : Pair) (paTail : Pairs)
-- The price list of langc serve (Q-S0-11 (b), Q-S7-1 (a)): three tiers in
-- cents. The genesis tiers are 1, 5 and 20. Each tier is in the range 1 to
-- 20: pcTier x says yes when 1 <= x <= pcMax, and pcIn says yes when the
-- three tiers are in the range.
family Prices := prices (pcLow : Amount) (pcBuild : Amount) (pcExport : Amount)
def pcMax : Amount :=
  amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc amZero)))))))))))))))))))
-- amCase x is inl unit at zero, else inr of the predecessor. amLeLin x y is
-- amLe x y in about x * y steps. The eval of an elim computes each recursive
-- value first, thus the inner elim of amLe takes about C(x + y, x) steps
-- (amLe 20 20 reaches the arena limit). amLeLin does a case on amCase y in
-- place of the inner elim.
def amCase : Amount -> Sum Unit Amount :=
  fun (x : Amount) => elim (fun (a : Amount) => Sum Unit Amount) (inl unit) (fun (a : Amount) (ih : Sum Unit Amount) => inr a) x
def amLeLin : Amount -> Amount -> Sum Unit Unit :=
  fun (x : Amount) => elim (fun (a : Amount) => Amount -> Sum Unit Unit)
    (fun (y : Amount) => inr unit)
    (fun (a : Amount) (ih : Amount -> Sum Unit Unit) => fun (y : Amount) =>
      elim (fun (s : Sum Unit Amount) => Sum Unit Unit) (fun (u : Unit) => inl unit) (fun (b : Amount) => ih b) (amCase y)) x
def pcTier : Amount -> Sum Unit Unit :=
  fun (x : Amount) => sAnd (amLeLin (amSucc amZero) x) (amLeLin x pcMax)
def pcIn : Prices -> Sum Unit Unit :=
  fun (p : Prices) => sAnd (pcTier (pcLow p)) (sAnd (pcTier (pcBuild p)) (pcTier (pcExport p)))
-- tMin is the static floor of the threshold (Q-S0-9 (a)): 2.
def tMin : Height := htSucc (htSucc htZero)
-- Params (Q-S7-1 (a)): the committee, the threshold prT, the amend quorum
-- prQuorum, the token pairs, the price list and two proof fields. prFloor
-- is the floor tMin <= prT (law G3) and prRange is the price range. A
-- proof field names an earlier field. A closed Params with a proof field
-- that the kernel cannot check gives REFUSE_FLOOR.
family Params := params (prMembers : Members) (prT : Height) (prQuorum : Height) (prPairs : Pairs) (prPrices : Prices) (prFloor : Path (Sum Unit Unit) (htLe tMin prT) (inr unit)) (prRange : Path (Sum Unit Unit) (pcIn prPrices) (inr unit))
-- A statement is what a certificate signs (Q-S7-3 (a)): a fill (the
-- nullifier and the height) or an amendment (the Root digest and the
-- height), or a withdrawal (the key, the token, the amount and the
-- height; USER ruling, S7 session 5). A certificate is a statement and
-- a list of signatures.
family Statement := smFill (smNf : Nullifier) (smAt : Height) | smAmend (smRoot : Root) (smAmAt : Height) | smWithdraw (smWdKey : Key) (smWdTok : Token) (smWdAmt : Amount) (smWdAt : Height)
family Sigs := csNil | csCons (csKey : Key) (csSig : Sig) (csRest : Sigs)
family Certificate := certificate (ctStmt : Statement) (ctSigs : Sigs)
-- The equality words of S7 (inr unit is "equal").
def keyEq : Key -> Key -> Sum Unit Unit :=
  fun (a : Key) (b : Key) => elim (fun (u : Key) => Sum Unit Unit)
    (fun (p : Pt1) => elim (fun (v : Key) => Sum Unit Unit)
      (fun (q : Pt1) => ptEq p q) b) a
def rootEq : Root -> Root -> Sum Unit Unit :=
  fun (a : Root) (b : Root) => elim (fun (u : Root) => Sum Unit Unit)
    (fun (i : Nat) => elim (fun (v : Root) => Sum Unit Unit)
      (fun (j : Nat) => flagIf (natEq i j) (inr unit) (inl unit)) b) a
def htEq : Height -> Height -> Sum Unit Unit :=
  fun (a : Height) (b : Height) => sAnd (htLe a b) (htLe b a)
def amEq : Amount -> Amount -> Sum Unit Unit :=
  fun (a : Amount) (b : Amount) => sAnd (amLeLin a b) (amLeLin b a)
def smEq : Statement -> Statement -> Sum Unit Unit :=
  fun (s : Statement) (t : Statement) =>
    elim (fun (u : Statement) => Sum Unit Unit)
      (fun (n : Nullifier) (h : Height) => elim (fun (v : Statement) => Sum Unit Unit)
        (fun (m : Nullifier) (g : Height) => sAnd (nfEq n m) (htEq h g))
        (fun (r : Root) (g : Height) => inl unit)
        (fun (j : Key) (o : Token) (y : Amount) (g : Height) => inl unit) t)
      (fun (r : Root) (h : Height) => elim (fun (v : Statement) => Sum Unit Unit)
        (fun (m : Nullifier) (g : Height) => inl unit)
        (fun (o : Root) (g : Height) => sAnd (rootEq r o) (htEq h g))
        (fun (j : Key) (o : Token) (y : Amount) (g : Height) => inl unit) t)
      (fun (k : Key) (w : Token) (x : Amount) (h : Height) => elim (fun (v : Statement) => Sum Unit Unit)
        (fun (m : Nullifier) (g : Height) => inl unit)
        (fun (o : Root) (g : Height) => inl unit)
        (fun (j : Key) (o : Token) (y : Amount) (g : Height) => sAnd (keyEq k j) (sAnd (tkEq w o) (sAnd (amEq x y) (htEq h g)))) t) s
-- smMsg s is the message word of the statement s (Q-S8b2-3 (a), Q-S8b2-20
-- (a)): each Nat id goes to Fr by natToFr. smMsg is an opaque def
-- (Q-S8b2-38 (a)): the check does not unfold it.
opaque def smMsg : Statement -> Fe :=
  fun (s : Statement) => elim (fun (t : Statement) => Fe)
    (fun (n : Nullifier) (h : Height) => msFill (elim (fun (u : Nullifier) => Fe) (fun (j : Nat) => natToFr j) n) (htToFr h))
    (fun (r : Root) (h : Height) => msAmend (elim (fun (u : Root) => Fe) (fun (j : Nat) => natToFr j) r) (htToFr h))
    (fun (k : Key) (t : Token) (x : Amount) (h : Height) => elim (fun (u : Key) => Fe)
      (fun (p : Pt1) => msWithdraw p (elim (fun (v : Token) => Fe) (fun (j : Nat) => natToFr j) t) (amToFr x) (htToFr h)) k) s
-- mbHas k m says yes when the key k is in the committee m. csHas k w s says
-- yes when s has a signature from the key k on the message w. An entry does
-- the Schnorr check only when its key is k (S8b2).
def mbHas : Key -> Members -> Sum Unit Unit :=
  fun (k : Key) (m : Members) =>
    elim (fun (t : Members) => Sum Unit Unit) (inl unit) (fun (j : Key) (r : Members) (ih : Sum Unit Unit) => sOr (keyEq k j) ih) m
def csHas : Key -> Fe -> Sigs -> Sum Unit Unit :=
  fun (k : Key) (w : Fe) (s : Sigs) =>
    elim (fun (t : Sigs) => Sum Unit Unit) (inl unit) (fun (j : Key) (g : Sig) (r : Sigs) (ih : Sum Unit Unit) =>
      sOr (elim (fun (b : Sum Unit Unit) => Sum Unit Unit) (fun (u : Unit) => inl unit) (fun (u : Unit) => sgVrf k g w) (keyEq k j)) ih) s
-- ctCount m w s is the count of the distinct members of m with a signature
-- on the message w in s: a member counts once, at its last place in m.
def ctCount : Members -> Fe -> Sigs -> Height :=
  fun (m : Members) (w : Fe) (s : Sigs) =>
    elim (fun (t : Members) => Height) htZero
      (fun (k : Key) (r : Members) (ih : Height) =>
        elim (fun (b : Sum Unit Unit) => Height) (fun (u : Unit) => ih) (fun (u : Unit) => htSucc ih) (sAnd (csHas k w s) (sNot (mbHas k r)))) m
-- ctCheck m k s c (Q-S7-3 (a), gavel-lang checkCert) says yes when the
-- certificate c signs the statement s and at least k distinct members of
-- m signed it.
-- The count (and its Schnorr checks) runs only when c holds the statement
-- s (S8b2). The message is smMsg s.
def ctCheck : Members -> Height -> Statement -> Certificate -> Sum Unit Unit :=
  fun (m : Members) (k : Height) (s : Statement) (c : Certificate) =>
    elim (fun (b : Sum Unit Unit) => Sum Unit Unit) (fun (u : Unit) => inl unit) (fun (u : Unit) => htLe k (ctCount m (smMsg s) (ctSigs c))) (smEq s (ctStmt c))
-- vdWith A s w gives reject A w when s says no. When s says yes, it gives
-- k of the path from s to yes: thus k can build a proof field.
def vdWith : (A : Type 0) -> (s : Sum Unit Unit) -> Reason -> (Path (Sum Unit Unit) s (inr unit) -> Verdict A) -> Verdict A :=
  fun (A : Type 0) (s : Sum Unit Unit) (w : Reason) =>
    elim (fun (b : Sum Unit Unit) => (Path (Sum Unit Unit) b (inr unit) -> Verdict A) -> Verdict A)
      (fun (u : Unit) (g : Path (Sum Unit Unit) (inl u) (inr unit) -> Verdict A) => reject A w)
      (fun (u : Unit) => elim (fun (v : Unit) => (Path (Sum Unit Unit) (inr v) (inr unit) -> Verdict A) -> Verdict A)
        (fun (g : Path (Sum Unit Unit) (inr unit) (inr unit) -> Verdict A) => g refl) u) s
-- certOpen A p c s x is the certified open (Q-S7-3 (a)): reject badCert
-- when c does not give prT p signatures of the members of p on s, else
-- accept of the open value of x.
def certOpen : (A : Type 0) -> Params -> Certificate -> Statement -> Sealed A -> Verdict A :=
  fun (A : Type 0) (p : Params) (c : Certificate) (s : Statement) (x : Sealed A) =>
    vdCheck A (ctCheck (prMembers p) (prT p) s c) badCert (accept A (open A x))
-- The amendment of design sec 5 (Q-S7-2 (a)): the new committee, the
-- threshold, the quorum, the pairs, the prices and the Root digest of the
-- text. It has no proof fields: amend builds them.
family Amendment := amendment (adMembers : Members) (adT : Height) (adQuorum : Height) (adPairs : Pairs) (adPrices : Prices) (adRoot : Root)
-- The log entries (Q-S7-6 (a)): a fill, an amendment, a deposit and a
-- withdrawal, each with its height. The Log is not indexed by Params.
family Entry := enFill (efIntent : Intent) (efQuote : Quote) (efCert : Certificate) (efAt : Height) | enAmend (eaAmend : Amendment) (eaCert : Certificate) (eaAt : Height) | enDeposit (edKey : Key) (edTok : Token) (edAmt : Amount) (edAt : Height) | enWithdraw (ewKey : Key) (ewTok : Token) (ewAmt : Amount) (ewCert : Certificate) (ewAt : Height)
family Log := lgNil | lgCons (lgHead : Entry) (lgTail : Log)
-- The book of S7 (Q-S7-5 (a)): a journal of account rows and the spent
-- nullifiers. A credit adds the row (k, t, x, 0) and a debit adds the row
-- (k, t, 0, x). The balance of the key k at the token t is the sum of the
-- credits less the sum of the debits of the rows of k and t.
family Acct := acct (acKey : Key) (acTok : Token) (acCredit : Amount) (acDebit : Amount)
family Accts := acNil | acCons (acHead : Acct) (acTail : Accts)
family Book := book (bkAccts : Accts) (bkSpent : Spent)
-- The state of the replay: the Params in force, the Params of the next
-- height (G2), the height of the last amendment and the book. The name is
-- GovState, because State is the program state of a guest (USER ruling,
-- S7 session 3).
family GovState := govState (ssCur : Params) (ssNext : Params) (ssAt : Height) (ssBook : Book)
-- acMine k t a says yes when the row a is of the key k and the token t.
-- acIn and acOut are the sums of the credits and of the debits of k and t.
def acMine : Key -> Token -> Acct -> Sum Unit Unit :=
  fun (k : Key) (t : Token) (a : Acct) => sAnd (keyEq k (acKey a)) (tkEq t (acTok a))
def acIn : Key -> Token -> Accts -> Amount :=
  fun (k : Key) (t : Token) (l : Accts) =>
    elim (fun (r : Accts) => Amount) amZero
      (fun (a : Acct) (r : Accts) (ih : Amount) =>
        elim (fun (s : Sum Unit Unit) => Amount) (fun (u : Unit) => ih) (fun (u : Unit) => amAdd (acCredit a) ih) (acMine k t a)) l
def acOut : Key -> Token -> Accts -> Amount :=
  fun (k : Key) (t : Token) (l : Accts) =>
    elim (fun (r : Accts) => Amount) amZero
      (fun (a : Acct) (r : Accts) (ih : Amount) =>
        elim (fun (s : Sum Unit Unit) => Amount) (fun (u : Unit) => ih) (fun (u : Unit) => amAdd (acDebit a) ih) (acMine k t a)) l
-- The book words: bkCredit and bkDebit add a row. bkCan k t x b says yes
-- when k can pay x of t: the debits and x are at most the credits
-- (amLeLin). bkSpend adds a spent nullifier; bkHas says yes when the
-- nullifier is spent.
def bkCredit : Key -> Token -> Amount -> Book -> Book :=
  fun (k : Key) (t : Token) (x : Amount) (b : Book) => book (acCons (acct k t x amZero) (bkAccts b)) (bkSpent b)
def bkDebit : Key -> Token -> Amount -> Book -> Book :=
  fun (k : Key) (t : Token) (x : Amount) (b : Book) => book (acCons (acct k t amZero x) (bkAccts b)) (bkSpent b)
def bkCan : Key -> Token -> Amount -> Book -> Sum Unit Unit :=
  fun (k : Key) (t : Token) (x : Amount) (b : Book) => amLeLin (amAdd (acOut k t (bkAccts b)) x) (acIn k t (bkAccts b))
def bkSpend : Nullifier -> Book -> Book :=
  fun (n : Nullifier) (b : Book) => book (bkAccts b) (spCons n (bkSpent b))
def bkHas : Nullifier -> Book -> Sum Unit Unit :=
  fun (n : Nullifier) (b : Book) => spHas n (bkSpent b)
-- The pair check of settle: the two tokens are not equal and the Params
-- list the pair. paHas a b l says yes when l has the pair (a, b).
def paHas : Token -> Token -> Pairs -> Sum Unit Unit :=
  fun (a : Token) (b : Token) (l : Pairs) =>
    elim (fun (t : Pairs) => Sum Unit Unit) (inl unit) (fun (r : Pair) (s : Pairs) (ih : Sum Unit Unit) => sOr (sAnd (tkEq a (paIn r)) (tkEq b (paOut r))) ih) l
def paOk : Params -> Intent -> Sum Unit Unit :=
  fun (p : Params) (i : Intent) => sAnd (sNot (tkEq (itInTok i) (itOutTok i))) (paHas (itInTok i) (itOutTok i) (prPairs p))
-- The funds of a fill (Q-S7-5 (a)): fdFlag b i q says yes when the owner
-- can pay amtIn of the in token and the solver can pay the quote output
-- of the out token. fdPick f i q is the two transfers of settleOut on yes
-- and unfilled on no.
def fdFlag : Book -> Intent -> Quote -> Sum Unit Unit :=
  fun (b : Book) (i : Intent) (q : Quote) =>
    sAnd (bkCan (itOwner i) (itInTok i) (open Amount (itAmtIn i)) b) (bkCan (qtSolver q) (itOutTok i) (open Amount (qtOut q)) b)
def fdPick : Sum Unit Unit -> Intent -> Quote -> Outcome :=
  fun (f : Sum Unit Unit) (i : Intent) (q : Quote) =>
    elim (fun (s : Sum Unit Unit) => Outcome) (fun (u : Unit) => unfilled) (fun (u : Unit) => settleOut i q) f
-- settle p b i q c h (S7, Q-S7-3 (a), Q-S7-5 (a)) is a chain of checks,
-- with the first check outermost: reused (the spent nullifiers of the
-- book b), expired, badPair (the pairs of the Params p), badProof,
-- badCert, belowFloor. Then the funds tail gives the two transfers or
-- unfilled. Each check has a named tail: settleRest is the checks 2 to 6,
-- settlePair 3 to 6, settleProof 4 to 6, settleCert 5 and 6, settleFloor
-- the check 6 and settleFunds the funds tail. The certificate c signs the
-- fill statement (the nullifier and the height h), and the floor test
-- opens the sealed values only after the certificate check (the shape of
-- certOpen).
def settleFunds : Book -> Intent -> Quote -> Outcome :=
  fun (b : Book) (i : Intent) (q : Quote) => fdPick (fdFlag b i q) i q
def settleFloor : Book -> Intent -> Quote -> Height -> Verdict Outcome :=
  fun (b : Book) (i : Intent) (q : Quote) (h : Height) =>
    vdCheck Outcome (open (Sum Unit Unit) (cross i q h)) belowFloor (accept Outcome (settleFunds b i q))
def settleCert : Params -> Book -> Intent -> Quote -> Certificate -> Height -> Verdict Outcome :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) =>
    vdCheck Outcome (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) badCert (settleFloor b i q h)
-- itMsg i is the message word of the intent i (Q-S8b2-3 (a), Q-S8b2-25
-- (a)): the window gives its two stored fields, and each Nat id goes to Fr
-- by natToFr. itMsg is an opaque def (Q-S8b2-38 (a)): the check does not
-- unfold it.
opaque def itMsg : Intent -> Fe :=
  fun (i : Intent) => elim (fun (v : Window) => Fe)
    (fun (s : Height) (l : Height) => msIntent (elim (fun (u : Nullifier) => Fe) (fun (j : Nat) => natToFr j) (itNf i))
      (elim (fun (u : Token) => Fe) (fun (j : Nat) => natToFr j) (itInTok i)) (elim (fun (u : Token) => Fe) (fun (j : Nat) => natToFr j) (itOutTok i))
      (amToFr (itStartOut i)) (htToFr s) (htToFr l) (htToFr (itDeadline i))) (itWindow i)
def settleProof : Params -> Book -> Intent -> Quote -> Certificate -> Height -> Verdict Outcome :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) =>
    vdCheck Outcome (sgVrf (itOwner i) (itSig i) (itMsg i)) badProof (settleCert p b i q c h)
def settlePair : Params -> Book -> Intent -> Quote -> Certificate -> Height -> Verdict Outcome :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) =>
    vdCheck Outcome (paOk p i) badPair (settleProof p b i q c h)
def settleRest : Params -> Book -> Intent -> Quote -> Certificate -> Height -> Verdict Outcome :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) =>
    vdCheck Outcome (htLe h (itDeadline i)) expired (settlePair p b i q c h)
def settle : Params -> Book -> Intent -> Quote -> Certificate -> Height -> Verdict Outcome :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) =>
    vdCheck Outcome (sNot (bkHas (itNf i) b)) reused (settleRest p b i q c h)
-- govAmend p a c h (design sec 5, Q-S7-2 (a)) gives reject badCert when c
-- does not give prQuorum p signatures of the members of p on the
-- amendment statement (the Root digest of a and the height h), reject
-- belowTMin when the new threshold is below tMin, and reject badPrice
-- when a new price tier is out of the range. Else it gives accept of the
-- new Params, with the two paths of vdWith as the proof fields. The name
-- is govAmend, because amend is a guest name (rule R4, USER ruling, S7
-- session 4).
def govAmend : Params -> Amendment -> Certificate -> Height -> Verdict Params :=
  fun (p : Params) (a : Amendment) (c : Certificate) (h : Height) =>
    vdCheck Params (ctCheck (prMembers p) (prQuorum p) (smAmend (adRoot a) h) c) badCert
      (vdWith Params (htLe tMin (adT a)) belowTMin
        (fun (f : Path (Sum Unit Unit) (htLe tMin (adT a)) (inr unit)) =>
          vdWith Params (pcIn (adPrices a)) badPrice
            (fun (g : Path (Sum Unit Unit) (pcIn (adPrices a)) (inr unit)) =>
              accept Params (params (adMembers a) (adT a) (adQuorum a) (adPairs a) (adPrices a) f g))))
-- S1 on the settle of S7: when the six flags and the funds flag are yes,
-- settle gives accept with the two transfers of settleOut. When the six
-- flags are yes and the funds flag is no, settle gives accept with
-- unfilled. When the flags before a check are yes and the flag of that
-- check is no, settle gives reject with its reason. Each law is a trans
-- chain of vdOk, then one vdBad or one cong on the funds flag.
law def s1Accept : (p : Params) -> (b : Book) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> (h : Height) -> Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit) -> Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit) -> Path (Sum Unit Unit) (paOk p i) (inr unit) -> Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i) (itMsg i)) (inr unit) -> Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inr unit) -> Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (inr unit) -> Path (Sum Unit Unit) (fdFlag b i q) (inr unit) -> Path (Verdict Outcome) (settle p b i q c h) (accept Outcome (settleOut i q)) :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) (p1 : Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit)) (p2 : Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit)) (p3 : Path (Sum Unit Unit) (paOk p i) (inr unit)) (p4 : Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i) (itMsg i)) (inr unit)) (p5 : Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inr unit)) (p6 : Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (inr unit)) (p7 : Path (Sum Unit Unit) (fdFlag b i q) (inr unit)) =>
    trans (Verdict Outcome) (settle p b i q c h) (settleRest p b i q c h) (accept Outcome (settleOut i q))
      (vdOk Outcome (sNot (bkHas (itNf i) b)) reused (settleRest p b i q c h) p1)
      (trans (Verdict Outcome) (settleRest p b i q c h) (settlePair p b i q c h) (accept Outcome (settleOut i q))
        (vdOk Outcome (htLe h (itDeadline i)) expired (settlePair p b i q c h) p2)
        (trans (Verdict Outcome) (settlePair p b i q c h) (settleProof p b i q c h) (accept Outcome (settleOut i q))
          (vdOk Outcome (paOk p i) badPair (settleProof p b i q c h) p3)
          (trans (Verdict Outcome) (settleProof p b i q c h) (settleCert p b i q c h) (accept Outcome (settleOut i q))
            (vdOk Outcome (sgVrf (itOwner i) (itSig i) (itMsg i)) badProof (settleCert p b i q c h) p4)
            (trans (Verdict Outcome) (settleCert p b i q c h) (settleFloor b i q h) (accept Outcome (settleOut i q))
              (vdOk Outcome (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) badCert (settleFloor b i q h) p5)
              (trans (Verdict Outcome) (settleFloor b i q h) (accept Outcome (settleFunds b i q)) (accept Outcome (settleOut i q))
                (vdOk Outcome (open (Sum Unit Unit) (cross i q h)) belowFloor (accept Outcome (settleFunds b i q)) p6)
                (cong (fun (f : Sum Unit Unit) => accept Outcome (fdPick f i q)) p7))))))
law def s1Unfilled : (p : Params) -> (b : Book) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> (h : Height) -> Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit) -> Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit) -> Path (Sum Unit Unit) (paOk p i) (inr unit) -> Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i) (itMsg i)) (inr unit) -> Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inr unit) -> Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (inr unit) -> Path (Sum Unit Unit) (fdFlag b i q) (inl unit) -> Path (Verdict Outcome) (settle p b i q c h) (accept Outcome unfilled) :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) (p1 : Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit)) (p2 : Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit)) (p3 : Path (Sum Unit Unit) (paOk p i) (inr unit)) (p4 : Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i) (itMsg i)) (inr unit)) (p5 : Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inr unit)) (p6 : Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (inr unit)) (z7 : Path (Sum Unit Unit) (fdFlag b i q) (inl unit)) =>
    trans (Verdict Outcome) (settle p b i q c h) (settleRest p b i q c h) (accept Outcome unfilled)
      (vdOk Outcome (sNot (bkHas (itNf i) b)) reused (settleRest p b i q c h) p1)
      (trans (Verdict Outcome) (settleRest p b i q c h) (settlePair p b i q c h) (accept Outcome unfilled)
        (vdOk Outcome (htLe h (itDeadline i)) expired (settlePair p b i q c h) p2)
        (trans (Verdict Outcome) (settlePair p b i q c h) (settleProof p b i q c h) (accept Outcome unfilled)
          (vdOk Outcome (paOk p i) badPair (settleProof p b i q c h) p3)
          (trans (Verdict Outcome) (settleProof p b i q c h) (settleCert p b i q c h) (accept Outcome unfilled)
            (vdOk Outcome (sgVrf (itOwner i) (itSig i) (itMsg i)) badProof (settleCert p b i q c h) p4)
            (trans (Verdict Outcome) (settleCert p b i q c h) (settleFloor b i q h) (accept Outcome unfilled)
              (vdOk Outcome (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) badCert (settleFloor b i q h) p5)
              (trans (Verdict Outcome) (settleFloor b i q h) (accept Outcome (settleFunds b i q)) (accept Outcome unfilled)
                (vdOk Outcome (open (Sum Unit Unit) (cross i q h)) belowFloor (accept Outcome (settleFunds b i q)) p6)
                (cong (fun (f : Sum Unit Unit) => accept Outcome (fdPick f i q)) z7))))))
law def s1Expired : (p : Params) -> (b : Book) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> (h : Height) -> Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit) -> Path (Sum Unit Unit) (htLe h (itDeadline i)) (inl unit) -> Path (Verdict Outcome) (settle p b i q c h) (reject Outcome expired) :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) (p1 : Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit)) (z2 : Path (Sum Unit Unit) (htLe h (itDeadline i)) (inl unit)) =>
    trans (Verdict Outcome) (settle p b i q c h) (settleRest p b i q c h) (reject Outcome expired)
      (vdOk Outcome (sNot (bkHas (itNf i) b)) reused (settleRest p b i q c h) p1)
      (vdBad Outcome (htLe h (itDeadline i)) expired (settlePair p b i q c h) z2)
law def s1BadPair : (p : Params) -> (b : Book) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> (h : Height) -> Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit) -> Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit) -> Path (Sum Unit Unit) (paOk p i) (inl unit) -> Path (Verdict Outcome) (settle p b i q c h) (reject Outcome badPair) :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) (p1 : Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit)) (p2 : Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit)) (z3 : Path (Sum Unit Unit) (paOk p i) (inl unit)) =>
    trans (Verdict Outcome) (settle p b i q c h) (settleRest p b i q c h) (reject Outcome badPair)
      (vdOk Outcome (sNot (bkHas (itNf i) b)) reused (settleRest p b i q c h) p1)
      (trans (Verdict Outcome) (settleRest p b i q c h) (settlePair p b i q c h) (reject Outcome badPair)
        (vdOk Outcome (htLe h (itDeadline i)) expired (settlePair p b i q c h) p2)
        (vdBad Outcome (paOk p i) badPair (settleProof p b i q c h) z3))
law def s1BadProof : (p : Params) -> (b : Book) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> (h : Height) -> Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit) -> Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit) -> Path (Sum Unit Unit) (paOk p i) (inr unit) -> Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i) (itMsg i)) (inl unit) -> Path (Verdict Outcome) (settle p b i q c h) (reject Outcome badProof) :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) (p1 : Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit)) (p2 : Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit)) (p3 : Path (Sum Unit Unit) (paOk p i) (inr unit)) (z4 : Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i) (itMsg i)) (inl unit)) =>
    trans (Verdict Outcome) (settle p b i q c h) (settleRest p b i q c h) (reject Outcome badProof)
      (vdOk Outcome (sNot (bkHas (itNf i) b)) reused (settleRest p b i q c h) p1)
      (trans (Verdict Outcome) (settleRest p b i q c h) (settlePair p b i q c h) (reject Outcome badProof)
        (vdOk Outcome (htLe h (itDeadline i)) expired (settlePair p b i q c h) p2)
        (trans (Verdict Outcome) (settlePair p b i q c h) (settleProof p b i q c h) (reject Outcome badProof)
          (vdOk Outcome (paOk p i) badPair (settleProof p b i q c h) p3)
          (vdBad Outcome (sgVrf (itOwner i) (itSig i) (itMsg i)) badProof (settleCert p b i q c h) z4)))
law def s1BadCert : (p : Params) -> (b : Book) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> (h : Height) -> Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit) -> Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit) -> Path (Sum Unit Unit) (paOk p i) (inr unit) -> Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i) (itMsg i)) (inr unit) -> Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inl unit) -> Path (Verdict Outcome) (settle p b i q c h) (reject Outcome badCert) :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) (p1 : Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit)) (p2 : Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit)) (p3 : Path (Sum Unit Unit) (paOk p i) (inr unit)) (p4 : Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i) (itMsg i)) (inr unit)) (z5 : Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inl unit)) =>
    trans (Verdict Outcome) (settle p b i q c h) (settleRest p b i q c h) (reject Outcome badCert)
      (vdOk Outcome (sNot (bkHas (itNf i) b)) reused (settleRest p b i q c h) p1)
      (trans (Verdict Outcome) (settleRest p b i q c h) (settlePair p b i q c h) (reject Outcome badCert)
        (vdOk Outcome (htLe h (itDeadline i)) expired (settlePair p b i q c h) p2)
        (trans (Verdict Outcome) (settlePair p b i q c h) (settleProof p b i q c h) (reject Outcome badCert)
          (vdOk Outcome (paOk p i) badPair (settleProof p b i q c h) p3)
          (trans (Verdict Outcome) (settleProof p b i q c h) (settleCert p b i q c h) (reject Outcome badCert)
            (vdOk Outcome (sgVrf (itOwner i) (itSig i) (itMsg i)) badProof (settleCert p b i q c h) p4)
            (vdBad Outcome (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) badCert (settleFloor b i q h) z5))))
law def s1BelowFloor : (p : Params) -> (b : Book) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> (h : Height) -> Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit) -> Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit) -> Path (Sum Unit Unit) (paOk p i) (inr unit) -> Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i) (itMsg i)) (inr unit) -> Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inr unit) -> Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (inl unit) -> Path (Verdict Outcome) (settle p b i q c h) (reject Outcome belowFloor) :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) (p1 : Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit)) (p2 : Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit)) (p3 : Path (Sum Unit Unit) (paOk p i) (inr unit)) (p4 : Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i) (itMsg i)) (inr unit)) (p5 : Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inr unit)) (z6 : Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (inl unit)) =>
    trans (Verdict Outcome) (settle p b i q c h) (settleRest p b i q c h) (reject Outcome belowFloor)
      (vdOk Outcome (sNot (bkHas (itNf i) b)) reused (settleRest p b i q c h) p1)
      (trans (Verdict Outcome) (settleRest p b i q c h) (settlePair p b i q c h) (reject Outcome belowFloor)
        (vdOk Outcome (htLe h (itDeadline i)) expired (settlePair p b i q c h) p2)
        (trans (Verdict Outcome) (settlePair p b i q c h) (settleProof p b i q c h) (reject Outcome belowFloor)
          (vdOk Outcome (paOk p i) badPair (settleProof p b i q c h) p3)
          (trans (Verdict Outcome) (settleProof p b i q c h) (settleCert p b i q c h) (reject Outcome belowFloor)
            (vdOk Outcome (sgVrf (itOwner i) (itSig i) (itMsg i)) badProof (settleCert p b i q c h) p4)
            (trans (Verdict Outcome) (settleCert p b i q c h) (settleFloor b i q h) (reject Outcome belowFloor)
              (vdOk Outcome (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) badCert (settleFloor b i q h) p5)
              (vdBad Outcome (open (Sum Unit Unit) (cross i q h)) belowFloor (accept Outcome (settleFunds b i q)) z6)))))
-- N1 (Q-S6-4 (a)): a nullifier that the book has spent gives reject
-- with the reason reused.
law def n1Reused : (p : Params) -> (b : Book) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> (h : Height) -> Path (Sum Unit Unit) (bkHas (itNf i) b) (inr unit) -> Path (Verdict Outcome) (settle p b i q c h) (reject Outcome reused) :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) (z : Path (Sum Unit Unit) (bkHas (itNf i) b) (inr unit)) =>
    vdBad Outcome (sNot (bkHas (itNf i) b)) reused (settleRest p b i q c h) (cong (fun (s : Sum Unit Unit) => sNot s) z)
-- S3: two quotes from one solver with equal open outputs give equal
-- verdicts.
law def s3Quote : (p : Params) -> (b : Book) -> (i : Intent) -> (k : Key) -> (c : Certificate) -> (h : Height) -> (m : Sealed Amount) -> (n : Sealed Amount) -> Path Amount (open Amount m) (open Amount n) -> Path (Verdict Outcome) (settle p b i (quote m k) c h) (settle p b i (quote n k) c h) :=
  fun (p : Params) (b : Book) (i : Intent) (k : Key) (c : Certificate) (h : Height) (m : Sealed Amount) (n : Sealed Amount) =>
    elim (fun (s : Sealed Amount) => Path Amount (open Amount s) (open Amount n) -> Path (Verdict Outcome) (settle p b i (quote s k) c h) (settle p b i (quote n k) c h))
      (fun (a : Amount) =>
        elim (fun (t : Sealed Amount) => Path Amount a (open Amount t) -> Path (Verdict Outcome) (settle p b i (quote (seal Amount a) k) c h) (settle p b i (quote t k) c h))
          (fun (e : Amount) (r : Path Amount a e) => cong (fun (x : Amount) => settle p b i (quote (seal Amount x) k) c h) r) n) m
-- The replay of design sec 5 (S7, Q-S7-6 (a)). vdThen A B v k gives
-- reject B w when v is reject A w, and k x when v is accept A x.
def vdThen : (A : Type 0) -> (B : Type 0) -> Verdict A -> (A -> Verdict B) -> Verdict B :=
  fun (A : Type 0) (B : Type 0) (v : Verdict A) (k : A -> Verdict B) =>
    elim (fun (u : Verdict A) => Verdict B) (fun (x : A) => k x) (fun (w : Reason) => reject B w) v
-- bkZero is the book with no rows and no spent nullifiers. gsCur s h is
-- the Params in force for an entry at the height h: ssNext s when h is
-- above ssAt s, else ssCur s (G2).
def bkZero : Book := book acNil spNil
def gsCur : GovState -> Height -> Params :=
  fun (s : GovState) (h : Height) =>
    elim (fun (f : Sum Unit Unit) => Params) (fun (u : Unit) => ssNext s) (fun (u : Unit) => ssCur s) (htLe h (ssAt s))
-- gsPay t b is the transfer t on the book b: a debit of the payer and a
-- credit of the payee. gsBook n o b is the book after the outcome o of a
-- fill with the nullifier n: on settled, the two transfers and the spent
-- nullifier; on unfilled, the same book (Q-S7-5 (a)).
def gsPay : Transfer -> Book -> Book :=
  fun (t : Transfer) (b : Book) => bkCredit (trTo t) (trTok t) (trAmt t) (bkDebit (trFrom t) (trTok t) (trAmt t) b)
def gsBook : Nullifier -> Outcome -> Book -> Book :=
  fun (n : Nullifier) (o : Outcome) (b : Book) =>
    elim (fun (u : Outcome) => Book) (fun (x : Transfer) (y : Transfer) => bkSpend n (gsPay y (gsPay x b))) b o
-- The four steps, each with the Params in force at the height h. A fill
-- is settle on the book. An amendment is govAmend; its result is the
-- next Params, in force from the height h + 1. A deposit is a credit. A
-- withdrawal needs a certificate on its statement (prT signatures, USER
-- ruling, S7 session 5), then the funds: a debit does not check them.
def gsFill : GovState -> Intent -> Quote -> Certificate -> Height -> Verdict GovState :=
  fun (s : GovState) (i : Intent) (q : Quote) (c : Certificate) (h : Height) =>
    vdThen Outcome GovState (settle (gsCur s h) (ssBook s) i q c h)
      (fun (o : Outcome) => accept GovState (govState (gsCur s h) (ssNext s) (ssAt s) (gsBook (itNf i) o (ssBook s))))
def gsAmend : GovState -> Amendment -> Certificate -> Height -> Verdict GovState :=
  fun (s : GovState) (a : Amendment) (c : Certificate) (h : Height) =>
    vdThen Params GovState (govAmend (gsCur s h) a c h)
      (fun (n : Params) => accept GovState (govState (gsCur s h) n h (ssBook s)))
def gsDeposit : GovState -> Key -> Token -> Amount -> Height -> GovState :=
  fun (s : GovState) (k : Key) (t : Token) (x : Amount) (h : Height) =>
    govState (gsCur s h) (ssNext s) (ssAt s) (bkCredit k t x (ssBook s))
def gsWithdraw : GovState -> Key -> Token -> Amount -> Certificate -> Height -> Verdict GovState :=
  fun (s : GovState) (k : Key) (t : Token) (x : Amount) (c : Certificate) (h : Height) =>
    vdCheck GovState (ctCheck (prMembers (gsCur s h)) (prT (gsCur s h)) (smWithdraw k t x h) c) badCert
      (vdCheck GovState (bkCan k t x (ssBook s)) noFunds
        (accept GovState (govState (gsCur s h) (ssNext s) (ssAt s) (bkDebit k t x (ssBook s)))))
-- govStep s e is the step of the replay. The name is govStep, because
-- step is a guest name (rule R4, USER ruling, S7 session 5).
def govStep : GovState -> Entry -> Verdict GovState :=
  fun (s : GovState) (e : Entry) =>
    elim (fun (u : Entry) => Verdict GovState)
      (fun (i : Intent) (q : Quote) (c : Certificate) (h : Height) => gsFill s i q c h)
      (fun (a : Amendment) (c : Certificate) (h : Height) => gsAmend s a c h)
      (fun (k : Key) (t : Token) (x : Amount) (h : Height) => accept GovState (gsDeposit s k t x h))
      (fun (k : Key) (t : Token) (x : Amount) (c : Certificate) (h : Height) => gsWithdraw s k t x c h) e
-- rpGo l s is the replay of the log l from the state s: the first reject
-- rejects all (Q-S7-6 (a)). govReplay p l starts with the Params p, the
-- height 0 and the empty book. The name is govReplay, because replay is
-- a guest name (rule R4, USER ruling, S7 session 5).
def rpGo : Log -> GovState -> Verdict GovState :=
  fun (l : Log) =>
    elim (fun (r : Log) => GovState -> Verdict GovState)
      (fun (s : GovState) => accept GovState s)
      (fun (e : Entry) (r : Log) (ih : GovState -> Verdict GovState) => fun (s : GovState) => vdThen GovState GovState (govStep s e) ih) l
def govReplay : Params -> Log -> Verdict GovState :=
  fun (p : Params) (l : Log) => rpGo l (govState p p htZero bkZero)
-- G1 (Q-S7-6 (a)): lgAmends l is the amendment entries of l. afStep s e
-- is gsAmend on an amendment entry and accept s on the other entries.
-- amendFold p l is the next Params of the fold of afStep over l.
def lgAmends : Log -> Log :=
  fun (l : Log) =>
    elim (fun (r : Log) => Log) lgNil
      (fun (e : Entry) (r : Log) (ih : Log) =>
        elim (fun (u : Entry) => Log)
          (fun (i : Intent) (q : Quote) (c : Certificate) (h : Height) => ih)
          (fun (a : Amendment) (c : Certificate) (h : Height) => lgCons (enAmend a c h) ih)
          (fun (k : Key) (t : Token) (x : Amount) (h : Height) => ih)
          (fun (k : Key) (t : Token) (x : Amount) (c : Certificate) (h : Height) => ih) e) l
def afStep : GovState -> Entry -> Verdict GovState :=
  fun (s : GovState) (e : Entry) =>
    elim (fun (u : Entry) => Verdict GovState)
      (fun (i : Intent) (q : Quote) (c : Certificate) (h : Height) => accept GovState s)
      (fun (a : Amendment) (c : Certificate) (h : Height) => gsAmend s a c h)
      (fun (k : Key) (t : Token) (x : Amount) (h : Height) => accept GovState s)
      (fun (k : Key) (t : Token) (x : Amount) (c : Certificate) (h : Height) => accept GovState s) e
def afGo : Log -> GovState -> Verdict GovState :=
  fun (l : Log) =>
    elim (fun (r : Log) => GovState -> Verdict GovState)
      (fun (s : GovState) => accept GovState s)
      (fun (e : Entry) (r : Log) (ih : GovState -> Verdict GovState) => fun (s : GovState) => vdThen GovState GovState (afStep s e) ih) l
def amendFold : Params -> Log -> Verdict Params :=
  fun (p : Params) (l : Log) =>
    vdThen GovState Params (afGo l (govState p p htZero bkZero)) (fun (s : GovState) => accept Params (ssNext s))
-- G1 (Q-S7-6 (a)): the replay of the amendment entries of a log gives
-- the same Params as the fold of govAmend over the log. g1Go is the
-- induction on the log. A fill, a deposit or a withdrawal entry drops
-- out on the two sides. On an amendment entry, a case on the verdict of
-- gsAmend: accept gives the step of the induction, reject gives refl.
law def g1Go : (l : Log) -> (s : GovState) -> Path (Verdict GovState) (rpGo (lgAmends l) s) (afGo l s) :=
  fun (l : Log) =>
    elim (fun (r : Log) => (s : GovState) -> Path (Verdict GovState) (rpGo (lgAmends r) s) (afGo r s))
      (fun (s : GovState) => refl)
      (fun (e : Entry) (r : Log) (ih : (s : GovState) -> Path (Verdict GovState) (rpGo (lgAmends r) s) (afGo r s)) => fun (s : GovState) =>
        elim (fun (u : Entry) => Path (Verdict GovState) (rpGo (lgAmends (lgCons u r)) s) (afGo (lgCons u r) s))
          (fun (i : Intent) (q : Quote) (c : Certificate) (h : Height) => ih s)
          (fun (a : Amendment) (c : Certificate) (h : Height) =>
            elim (fun (v : Verdict GovState) => Path (Verdict GovState) (vdThen GovState GovState v (rpGo (lgAmends r))) (vdThen GovState GovState v (afGo r)))
              (fun (t : GovState) => ih t)
              (fun (w : Reason) => refl)
              (gsAmend s a c h))
          (fun (k : Key) (t : Token) (x : Amount) (h : Height) => ih s)
          (fun (k : Key) (t : Token) (x : Amount) (c : Certificate) (h : Height) => ih s) e) l
law def g1Fix : (p : Params) -> (l : Log) -> Path (Verdict Params) (vdThen GovState Params (govReplay p (lgAmends l)) (fun (s : GovState) => accept Params (ssNext s))) (amendFold p l) :=
  fun (p : Params) (l : Log) =>
    cong (fun (v : Verdict GovState) => vdThen GovState Params v (fun (s : GovState) => accept Params (ssNext s))) (g1Go l (govState p p htZero bkZero))
-- G2 (Q-S7-6 (a)): a fill at the height ssAt s (the height of the last
-- amendment) settles with the old Params ssCur s, by the height order.
law def g2Cur : (s : GovState) -> Path Params (gsCur s (ssAt s)) (ssCur s) :=
  fun (s : GovState) =>
    cong (fun (f : Sum Unit Unit) => elim (fun (g : Sum Unit Unit) => Params) (fun (u : Unit) => ssNext s) (fun (u : Unit) => ssCur s) f) (htLeRefl (ssAt s))
law def g2Same : (s : GovState) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> Path (Verdict GovState) (govStep s (enFill i q c (ssAt s))) (vdThen Outcome GovState (settle (ssCur s) (ssBook s) i q c (ssAt s)) (fun (o : Outcome) => accept GovState (govState (ssCur s) (ssNext s) (ssAt s) (gsBook (itNf i) o (ssBook s))))) :=
  fun (s : GovState) (i : Intent) (q : Quote) (c : Certificate) =>
    cong (fun (p : Params) => vdThen Outcome GovState (settle p (ssBook s) i q c (ssAt s)) (fun (o : Outcome) => accept GovState (govState p (ssNext s) (ssAt s) (gsBook (itNf i) o (ssBook s))))) (g2Cur s)
-- G3 (Q-S7-6 (a)): each Params has t >= t_min (prFloor, by the type).
law def g3Floor : (p : Params) -> Path (Sum Unit Unit) (htLe tMin (prT p)) (inr unit) :=
  fun (p : Params) => prFloor p
-- N1 in the replay form (Q-S7-7 (a)): at a step of the replay, a fill
-- whose nullifier the book has spent gives reject with the reason
-- reused (one cong on n1Reused).
law def n1Replay : (s : GovState) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> (h : Height) -> Path (Sum Unit Unit) (bkHas (itNf i) (ssBook s)) (inr unit) -> Path (Verdict GovState) (govStep s (enFill i q c h)) (reject GovState reused) :=
  fun (s : GovState) (i : Intent) (q : Quote) (c : Certificate) (h : Height) (z : Path (Sum Unit Unit) (bkHas (itNf i) (ssBook s)) (inr unit)) =>
    cong (fun (v : Verdict Outcome) => vdThen Outcome GovState v (fun (o : Outcome) => accept GovState (govState (gsCur s h) (ssNext s) (ssAt s) (gsBook (itNf i) o (ssBook s))))) (n1Reused (gsCur s h) (ssBook s) i q c h z)
