-- keccak-256 on Words (S8b2, Q-S8b-6 (a), Q-S8b2-11 (a)). A Lane is one
-- 64-bit lane of the keccak state: lnLo holds bits 0 to 31 and lnHi holds
-- bits 32 to 63. A KState holds the 25 lanes: lane x + 5 y is ks(x + 5 y).
-- KRounds is the list of the round constants: keccakF is an elim over it.
family Lane := lane (lnLo : Word) (lnHi : Word)
family KState := kstate (ks0 : Lane) (ks1 : Lane) (ks2 : Lane) (ks3 : Lane) (ks4 : Lane) (ks5 : Lane) (ks6 : Lane) (ks7 : Lane) (ks8 : Lane) (ks9 : Lane) (ks10 : Lane) (ks11 : Lane) (ks12 : Lane) (ks13 : Lane) (ks14 : Lane) (ks15 : Lane) (ks16 : Lane) (ks17 : Lane) (ks18 : Lane) (ks19 : Lane) (ks20 : Lane) (ks21 : Lane) (ks22 : Lane) (ks23 : Lane) (ks24 : Lane)
