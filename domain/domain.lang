def lnLet : Lane -> (Lane -> KState) -> KState := fun (a : Lane) (k : Lane -> KState) => k a
def lnXor : Lane -> Lane -> Lane := fun (a : Lane) (b : Lane) => lane (wXor (lnLo a) (lnLo b)) (wXor (lnHi a) (lnHi b))
-- lnChi a b c is a xor ((not b) and c).
def lnChi : Lane -> Lane -> Lane -> Lane :=
  fun (a : Lane) (b : Lane) (c : Lane) => lane (wXor (lnLo a) (wAnd (wNot (lnLo b)) (lnLo c))) (wXor (lnHi a) (wAnd (wNot (lnHi b)) (lnHi c)))
-- lnRot a s t turns a left by s bits, with 0 < s < 32 and t = 32 - s.
def lnRot : Lane -> Word -> Word -> Lane :=
