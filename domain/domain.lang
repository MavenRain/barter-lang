-- (9 + u)(a0 + a1 u) = (9 a0 - a1) + (a0 + 9 a1) u.
def f2MulXi : Fp2 -> Fp2 := fun (a : Fp2) => fp2 (feSub fpMod (f2FeNine (f2A a)) (f2B a)) (feAdd fpMod (f2A a) (f2FeNine (f2B a)))
