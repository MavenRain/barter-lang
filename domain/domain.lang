-- defs. Each def gives the value of the oracle function with the same name
-- (src/crypto/pairing.c). A def that multiplies takes the field product mul
-- as a parameter (the psPerm form): f2FeMulC is the native product and
-- f2FeMulG is the guest feMul (the specification).
def f2FeMulC : Fe -> Fe -> Fe := fun (a : Fe) (b : Fe) => feMulC fpMod a b
def f2FeMulG : Fe -> Fe -> Fe := fun (a : Fe) (b : Fe) => feMul fpMod a b
-- f2FeNeg a is -a. f2FeNine a is 9 a: 3 doubles, then one add.
def f2FeNeg : Fe -> Fe := fun (a : Fe) => feSub fpMod feZero a
