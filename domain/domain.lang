-- feToMont md a is a R mod m. feFromMont md a is a R^-1 mod m.
def feToMont : FeMod -> Fe -> Fe := fun (md : FeMod) (a : Fe) => feMul md a (modR2 md)
def feFromMont : FeMod -> Fe -> Fe := fun (md : FeMod) (a : Fe) => feMul md a feOne
