def lnSwap : Lane -> Lane := fun (a : Lane) => lane (lnHi a) (lnLo a)
-- lnCol a b c d e is the xor of the 5 lanes of one column.
def lnCol : Lane -> Lane -> Lane -> Lane -> Lane -> Lane :=
  fun (a : Lane) (b : Lane) (c : Lane) (d : Lane) (e : Lane) => lnXor (lnXor (lnXor (lnXor a b) c) d) e
-- kfChi rc b0 .. b24 is the chi step on the lanes b (lane x + 5 y at b(x + 5 y)),
-- then the iota step: lane 0 gets the xor of the round constant rc.
def kfChi : Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> Lane -> KState :=
  fun (rc : Lane) (b0 : Lane) (b1 : Lane) (b2 : Lane) (b3 : Lane) (b4 : Lane) (b5 : Lane) (b6 : Lane) (b7 : Lane) (b8 : Lane) (b9 : Lane) (b10 : Lane) (b11 : Lane) (b12 : Lane) (b13 : Lane) (b14 : Lane) (b15 : Lane) (b16 : Lane) (b17 : Lane) (b18 : Lane) (b19 : Lane) (b20 : Lane) (b21 : Lane) (b22 : Lane) (b23 : Lane) (b24 : Lane) =>
    kstate (lnXor (lnChi b0 b1 b2) rc) (lnChi b1 b2 b3) (lnChi b2 b3 b4) (lnChi b3 b4 b0) (lnChi b4 b0 b1)
      (lnChi b5 b6 b7) (lnChi b6 b7 b8) (lnChi b7 b8 b9) (lnChi b8 b9 b5) (lnChi b9 b5 b6)
      (lnChi b10 b11 b12) (lnChi b11 b12 b13) (lnChi b12 b13 b14) (lnChi b13 b14 b10) (lnChi b14 b10 b11)
