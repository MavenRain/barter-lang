-- psFe x k is k x. It binds one field value.
def psFe : Fe -> (Fe -> Fe) -> Fe := fun (x : Fe) (k : Fe -> Fe) => k x
-- psPow5 mul x is x^5 by 3 products.
def psPow5 : (Fe -> Fe -> Fe) -> Fe -> Fe :=
  fun (mul : Fe -> Fe -> Fe) (x : Fe) => psFe (mul x x) (fun (x2 : Fe) => psFe (mul x2 x2) (fun (x4 : Fe) => mul x4 x))
-- psRow mul m0 m1 m2 a b c is m0 a + m1 b + m2 c.
def psRow : (Fe -> Fe -> Fe) -> Fe -> Fe -> Fe -> Fe -> Fe -> Fe -> Fe :=
  fun (mul : Fe -> Fe -> Fe) (m0 : Fe) (m1 : Fe) (m2 : Fe) (a : Fe) (b : Fe) (c : Fe) => feAdd frMod (feAdd frMod (mul m0 a) (mul m1 b)) (mul m2 c)
-- psMix mul a b c is the MDS product of (a, b, c).
def psMix : (Fe -> Fe -> Fe) -> Fe -> Fe -> Fe -> PState :=
  fun (mul : Fe -> Fe -> Fe) (a : Fe) (b : Fe) (c : Fe) => pstate (psRow mul psM00 psM01 psM02 a b c) (psRow mul psM10 psM11 psM12 a b c) (psRow mul psM20 psM21 psM22 a b c)
-- psFull mul a b c s is one full round on s with the round constants a, b, c.
def psFull : (Fe -> Fe -> Fe) -> Fe -> Fe -> Fe -> PState -> PState :=
  fun (mul : Fe -> Fe -> Fe) (a : Fe) (b : Fe) (c : Fe) (s : PState) =>
    psMix mul (psPow5 mul (feAdd frMod (ps0 s) a)) (psPow5 mul (feAdd frMod (ps1 s) b)) (psPow5 mul (feAdd frMod (ps2 s) c))
-- psPart mul a b c s is one partial round: the S-box on element 0 only.
def psPart : (Fe -> Fe -> Fe) -> Fe -> Fe -> Fe -> PState -> PState :=
  fun (mul : Fe -> Fe -> Fe) (a : Fe) (b : Fe) (c : Fe) (s : PState) =>
    psMix mul (psPow5 mul (feAdd frMod (ps0 s) a)) (feAdd frMod (ps1 s) b) (feAdd frMod (ps2 s) c)
-- psRounds mul c s does one round on s for each node of c, the first first.
def psRounds : (Fe -> Fe -> Fe) -> PsRounds -> PState -> PState :=
  fun (mul : Fe -> Fe -> Fe) (c : PsRounds) => elim (fun (k : PsRounds) => PState -> PState)
    (fun (s : PState) => s)
    (fun (a : Fe) (b : Fe) (d : Fe) (t : PsRounds) (ih : PState -> PState) => fun (s : PState) => ih (psFull mul a b d s))
    (fun (a : Fe) (b : Fe) (d : Fe) (t : PsRounds) (ih : PState -> PState) => fun (s : PState) => ih (psPart mul a b d s)) c
-- psPerm mul s is the permutation of s. s and the result are in Montgomery form.
def psPerm : (Fe -> Fe -> Fe) -> PState -> PState := fun (mul : Fe -> Fe -> Fe) (s : PState) => psRounds mul psAll s
-- psMulC is the native product feMulC (Q-S8b-4 (a)). psMulG is the guest
-- feMul, the specification (Q-S8b2-15 (a)).
def psMulC : Fe -> Fe -> Fe := fun (a : Fe) (b : Fe) => feMulC frMod a b
def psMulG : Fe -> Fe -> Fe := fun (a : Fe) (b : Fe) => feMul frMod a b
-- psHash2 mul a b is element 0 of the permutation of (0, a, b). a, b and the
-- result are canonical (Q-S8b2-16 (a)): the product by R^2 puts a value in
-- Montgomery form, and the product by 1 takes it out.
def psHash2 : (Fe -> Fe -> Fe) -> Fe -> Fe -> Fe :=
  fun (mul : Fe -> Fe -> Fe) (a : Fe) (b : Fe) => mul (ps0 (psPerm mul (pstate feZero (mul a (modR2 frMod)) (mul b (modR2 frMod))))) feOne
-- poseidon2 a b is psHash2 with the native product.
def poseidon2 : Fe -> Fe -> Fe := fun (a : Fe) (b : Fe) => psHash2 psMulC a b
-- S8b2 (Q-S8b-6 (a), Q-S8b2-3 (a), Q-S8b2-5 (a), Q-S8b2-6 (a), Q-S8b2-20
-- (a), Q-S8b2-21 (a)): the Schnorr check on BN254 G1 and the message words.
-- A Hash holds a canonical Fr.
family Hash := hash (hsVal : Fr)
-- natWord c n gives the low bits of n, one bit for each step of the PtCount
-- list c (Q-S8b2-24 (a)): bit 0 of n, then natWord of natDiv n 2 one place
-- up. pc32 gives n mod 2^32.
def natWord : PtCount -> Nat -> Word := fun (c : PtCount) => elim (fun (k : PtCount) => Nat -> Word)
  (fun (n : Nat) => 0w)
  (fun (t : PtCount) (ih : Nat -> Word) => fun (n : Nat) => wOr (flagIf (natEq (natMod n 2) 1) 1w 0w) (wShl (ih (natDiv n 2)) 1w)) c
-- natToFr n is kcModR of the 256-bit value of n, a canonical Fr
-- (Q-S8b2-24 (a)). A Nat of the evaluator is less than 2^64, thus limbs 2 to
-- 7 are 0. Limb 1 is natWord of n divided by 2^16 two times.
def natToFr : Nat -> Fe := fun (n : Nat) => kcModR (fe (natWord pc32 n) (natWord pc32 (natDiv (natDiv n 65536) 65536)) 0w 0w 0w 0w 0w 0w)
-- amToFr a and htToFr h give the unary value as a canonical Fr (the value is
-- less than r). Each step adds 1.
def amToFr : Amount -> Fe := fun (a : Amount) => elim (fun (b : Amount) => Fe) feZero (fun (p : Amount) (ih : Fe) => feAdd frMod ih feOne) a
def htToFr : Height -> Fe := fun (h : Height) => elim (fun (g : Height) => Fe) feZero (fun (p : Height) (ih : Fe) => feAdd frMod ih feOne) h
-- scOut md a takes the Montgomery value a out (feMulC by 1, Q-S8b2-21 (a)).
def scOut : FeMod -> Fe -> Fe := fun (md : FeMod) (a : Fe) => feMulC md a feOne
-- msWord, msKey, msWithdraw and msIntent call poseidon2C (Q-S8b2-29 (b)).
-- msWord t x y is poseidon2(t, poseidon2(x, y)) (Q-S8b-5 (a)).
def msWord : Fe -> Fe -> Fe -> Fe := fun (t : Fe) (x : Fe) (y : Fe) => poseidon2C t (poseidon2C x y)
-- msKey p is poseidon2(x mod r, y mod r) of the canonical coordinates of p.
-- p is less than 2 r, thus one conditional subtraction gives the value mod r.
def msKey : Pt1 -> Fe := fun (p : Pt1) => poseidon2C (feCondSub (modM frMod) (scOut fpMod (ptX p))) (feCondSub (modM frMod) (scOut fpMod (ptY p)))
-- The message words of Q-S8b2-3 (a): tag 0 fill, 1 amend, 2 withdraw, 3 intent.
def msFill : Fe -> Fe -> Fe := fun (nf : Fe) (h : Fe) => msWord feZero nf h
def msAmend : Fe -> Fe -> Fe := fun (root : Fe) (h : Fe) => msWord feOne root h
def msWithdraw : Pt1 -> Fe -> Fe -> Fe -> Fe := fun (p : Pt1) (tok : Fe) (amt : Fe) (h : Fe) => msWord (fe 2w 0w 0w 0w 0w 0w 0w 0w) (msKey p) (poseidon2C tok (poseidon2C amt h))
-- msIntent nf tin tout st ws wl dl (Q-S8b2-25 (a)): tag 3 on nf and the
-- right-nested chain of the two tokens, the start amount, the window (the
-- two stored fields winStart, winLenPred) and the deadline.
def msIntent : Fe -> Fe -> Fe -> Fe -> Fe -> Fe -> Fe -> Fe := fun (nf : Fe) (tin : Fe) (tout : Fe) (st : Fe) (ws : Fe) (wl : Fe) (dl : Fe) => msWord (fe 3w 0w 0w 0w 0w 0w 0w 0w) nf (poseidon2C tin (poseidon2C tout (poseidon2C st (poseidon2C ws (poseidon2C wl dl)))))
-- g1Gen is the generator (1, 2) in Montgomery form: R mod p and 2 R mod p.
def g1Gen : Pt1 := pt1 (modR1 fpMod) (feAdd fpMod (modR1 fpMod) (modR1 fpMod))
-- scValid p r s (Q-S8b2-6 (a)) says no when P or R is off the curve, P is
-- the point at infinity, or s is not less than r.
def scValid : Pt1 -> Pt1 -> Fe -> Sum Unit Unit := fun (p : Pt1) (r : Pt1) (s : Fe) => sAnd (ptOnCurve fpMod p) (sAnd (sNot (ptIsInf p)) (sAnd (ptOnCurve fpMod r) (feLt s (modM frMod))))
-- scJacEq a j says yes when the affine a and the Jacobian j are the same
-- point: Z = 0 and a at infinity, or a finite and X = x Z^2, Y = y Z^3.
def scJacEq : Pt1 -> Jac1 -> Sum Unit Unit := fun (a : Pt1) (j : Jac1) =>
  elim (fun (b : Sum Unit Unit) => Sum Unit Unit) (fun (u : Unit) => sAnd (sNot (ptIsInf a)) (sAnd (feEq (jcX j) (feMulC fpMod (ptX a) (feMulC fpMod (jcZ j) (jcZ j)))) (feEq (jcY j) (feMulC fpMod (ptY a) (feMulC fpMod (jcZ j) (feMulC fpMod (jcZ j) (jcZ j))))))) (fun (u : Unit) => ptIsInf a) (feIsZero (jcZ j))
-- scEquation p r s e says yes when s G = R + e P (two ptMulC, no feInv).
def scEquation : Pt1 -> Pt1 -> Fe -> Fe -> Sum Unit Unit := fun (p : Pt1) (r : Pt1) (s : Fe) (e : Fe) => scJacEq (ptMulC fpMod s g1Gen) (ptMadd fpMod (ptMadd fpMod jcInf r) (ptMulC fpMod e p))
-- schnorrCheck p r s m: e = keccak256(R.x, R.y, P.x, P.y, m) mod r on the
-- canonical values (Q-S8b2-13 (a)). The equation runs only when scValid says
-- yes, thus a bad input costs no ptMulC.
def schnorrCheck : Pt1 -> Pt1 -> Fe -> Fe -> Sum Unit Unit := fun (p : Pt1) (r : Pt1) (s : Fe) (m : Fe) =>
  elim (fun (b : Sum Unit Unit) => Sum Unit Unit) (fun (u : Unit) => inl unit) (fun (u : Unit) => scEquation p r s (kcChallenge (scOut fpMod (ptX r)) (scOut fpMod (ptY r)) (scOut fpMod (ptX p)) (scOut fpMod (ptY p)) m)) (scValid p r s)
