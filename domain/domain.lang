def f2FeNine : Fe -> Fe := fun (a : Fe) => feAdd fpMod (f2FeDbl (f2FeDbl (f2FeDbl a))) a
-- f2FeInv mul a is a^(p - 2) with the product mul (the fePowFrom form). It is
-- the inverse of a when a is not 0, and 0 when a is 0.
def f2FePowFrom : (Fe -> Fe -> Fe) -> Fe -> FeBits -> Fe -> Fe :=
  fun (mul : Fe -> Fe -> Fe) (a : Fe) (e : FeBits) => elim (fun (k : FeBits) => Fe -> Fe)
    (fun (x : Fe) => x)
    (fun (t : FeBits) (ih : Fe -> Fe) => fun (x : Fe) => ih (mul x x))
    (fun (t : FeBits) (ih : Fe -> Fe) => fun (x : Fe) => ih (mul (mul x x) a)) e
def f2FeInv : (Fe -> Fe -> Fe) -> Fe -> Fe :=
  fun (mul : Fe -> Fe -> Fe) (a : Fe) => f2FePowFrom mul a (modE fpMod) (modR1 fpMod)
-- Fp2. f2One is 1 in Montgomery form.
def f2Zero : Fp2 := fp2 feZero feZero
def f2One : Fp2 := fp2 (modR1 fpMod) feZero
def f2Add : Fp2 -> Fp2 -> Fp2 := fun (a : Fp2) (b : Fp2) => fp2 (feAdd fpMod (f2A a) (f2A b)) (feAdd fpMod (f2B a) (f2B b))
def f2Sub : Fp2 -> Fp2 -> Fp2 := fun (a : Fp2) (b : Fp2) => fp2 (feSub fpMod (f2A a) (f2A b)) (feSub fpMod (f2B a) (f2B b))
def f2Neg : Fp2 -> Fp2 := fun (a : Fp2) => fp2 (f2FeNeg (f2A a)) (f2FeNeg (f2B a))
def f2Conj : Fp2 -> Fp2 := fun (a : Fp2) => fp2 (f2A a) (f2FeNeg (f2B a))
-- (a0 + a1 u)(b0 + b1 u) = (a0 b0 - a1 b1) + (a0 b1 + a1 b0) u.
def f2Mul : (Fe -> Fe -> Fe) -> Fp2 -> Fp2 -> Fp2 :=
  fun (mul : Fe -> Fe -> Fe) (a : Fp2) (b : Fp2) =>
    fp2 (feSub fpMod (mul (f2A a) (f2A b)) (mul (f2B a) (f2B b))) (feAdd fpMod (mul (f2A a) (f2B b)) (mul (f2B a) (f2A b)))
