-- The domain file. The kernel port (S2, from ratify-lang a2322ef and
-- permit-lang 3d47120) removes the kit sample and adds the kernel prelude.
-- The R1 formers Enc and open are at the end (S4). The barter-lang
-- base types of design sec 3 come after them (S5).
-- Each family, constructor, field and def name here becomes a core name
-- (rule R4). Only this file can declare a family (rule R1).

-- Kan library (ported from sealed-lang, R6 (a)): transport, subst, J and the
-- J rule as a path (JRefl, sealed-lang O11), all by transp.
def transport : (X : Type 0) -> (Y : Type 0) -> Path (Type 0) X Y -> X -> Y :=
  fun (X : Type 0) => fun (Y : Type 0) => fun (p : Path (Type 0) X Y) => fun (a : X) => transp (fun (i : I) => p @ i) i0 a
def subst : (A : Type 0) -> (B : A -> Type 0) -> (x : A) -> (y : A) -> Path A x y -> B x -> B y :=
  fun (A : Type 0) => fun (B : A -> Type 0) => fun (x : A) => fun (y : A) => fun (p : Path A x y) => fun (b : B x) =>
    transp (fun (i : I) => B (p @ i)) i0 b
def J : (A : Type 0) -> (x : A) -> (P : (y : A) -> Path A x y -> Type 0) -> P x refl -> (y : A) -> (p : Path A x y) -> P y p :=
  fun (A : Type 0) => fun (x : A) => fun (P : (y : A) -> Path A x y -> Type 0) => fun (d : P x refl) => fun (y : A) => fun (p : Path A x y) =>
    transp (fun (i : I) => P (p @ i) (fun (j : I) => p @ (i /\ j))) i0 d
def JRefl : (A : Type 0) -> (x : A) -> (P : (y : A) -> Path A x y -> Type 0) -> (d : P x refl) -> Path (P x refl) (J A x P d x refl) d :=
  fun (A : Type 0) => fun (x : A) => fun (P : (y : A) -> Path A x y -> Type 0) => fun (d : P x refl) =>
    fun (i : I) => transp (fun (_ : I) => P x refl) i d
-- Path composition (S2b, R2 (a)): trans by hcomp, with the tube x on ~j
-- and q on j, and the base p.
def trans : (A : Type 0) -> (x : A) -> (y : A) -> (z : A) -> Path A x y -> Path A y z -> Path A x z :=
  fun (A : Type 0) => fun (x : A) => fun (y : A) => fun (z : A) => fun (p : Path A x y) => fun (q : Path A y z) =>
    fun (j : I) => hcomp A (~j \/ j) (fun (i : I) => [ ~j -> x, j -> q @ i ]) (p @ j)
-- Propositions and sets (S4b): the squash1 fold case has the type
-- isProp RES, the squash0 fold case the type isSet RES.
def isProp : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> Path A x y
def isSet : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> isProp (Path A x y)

-- The circle, a higher inductive family (S4a, R1 (a)). The path
-- constructor loop goes from base to base.
family S1 := base | loop (i : I) [ ~i -> base, i -> base ]
-- The propositional truncation (S4b, R5 (a)): squash1 is a path between
-- any two points, so the squash1 fold case has the type isProp RES. A
-- field name is a core name (rule R4), so the names have a family prefix.
family Trunc1 (A : Type 0) := trunc1 (truncOf : A) | squash1 (squashFrom : Trunc1 A) (squashTo : Trunc1 A) (i : I) [ ~i -> squashFrom, i -> squashTo ]
-- The set truncation (S4c, R5 (a)): squash0 is a square between any two
-- paths with the same ends, so the squash0 fold case has the type isSet
-- RES (R8 (a)). The case binds the folded ends and the folded paths.
family Trunc0 (A : Type 0) := trunc0 (trunc0Of : A) | squash0 (squash0From : Trunc0 A) (squash0To : Trunc0 A) (squash0Left : Path (Trunc0 A) squash0From squash0To) (squash0Right : Path (Trunc0 A) squash0From squash0To) (i : I) (j : I) [ ~i -> squash0Left @ j, i -> squash0Right @ j, ~j -> squash0From, j -> squash0To ]
-- The set quotient Quot went in S3 (rule R1: its relation parameter is a
-- value parameter, so it is not a cell signature). The quotients of the
-- DAO are families with no parameter: Orbit, Parity and OrbitN.
-- The size index (S6, O24, USER ruling S6): a domain family, so Nat
-- stays internal.
family Size := sz0 | szS (szPred : Size)
-- The stream comonad (S4, O28): the cofree comonad of the cocell
-- signature with the observation sHead and the cofield sTail. The checker
-- elaborates it (choice (ii)) to the positions Stream.pos, Stream A :=
-- Stream.pos -> A, the destructors sHead and sTail, the walk Stream.walk,
-- the corecursor sCorec and the bisimulation principle StreamBisim.
cofamily Stream (A : Type 0) := sCorec (sHead : A) (sTail : Stream A)
-- Extend and duplicate: sExtend A B f is the corecursor at the seed type
-- Stream A, with the observation f and the step sTail A.
def sExtend : (A : Type 0) -> (B : Type 0) -> (Stream A -> B) -> Stream A -> Stream B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : Stream A -> B) => sCorec B (Stream A) f (sTail A)
def sDuplicate : (A : Type 0) -> Stream A -> Stream (Stream A) :=
  fun (A : Type 0) => sExtend A (Stream A) (fun (x : Stream A) => x)
-- The parity quotient of Size:
-- sizeEven s is sz0 for an even s and szS sz0 for an odd s, and parityEq
-- is a path from parityOf a to parityOf b when a and b have the same
-- parity. The relation is in the field type, so Parity has no parameter.
-- paritySquash has the squash0 shape, so its fold case has the type isSet
-- RES.
def sizeFlip : Size -> Size := fun (s : Size) => elim (fun (t : Size) => Size) (szS sz0) (fun (k : Size) (ih : Size) => sz0) s
def sizeEven : Size -> Size := fun (s : Size) => fold sz0 (fun (r : Size) => sizeFlip r) s
family Parity := parityOf (parityAt : Size)
  | parityEq (parityA : Size) (parityB : Size) (parityR : Path Size (sizeEven parityA) (sizeEven parityB)) (i : I) [ ~i -> parityOf parityA, i -> parityOf parityB ]
  | paritySquash (parityFrom : Parity) (parityTo : Parity) (parityLeft : Path Parity parityFrom parityTo) (parityRight : Path Parity parityFrom parityTo) (i : I) (j : I)
    [ ~i -> parityLeft @ j, i -> parityRight @ j, ~j -> parityFrom, j -> parityTo ]
-- The empty family: one constructor and
-- no base case, so no closed value. The parser needs a constructor, so
-- Empty is not a family with no constructor.
family Empty := emptyLoop (emptyOf : Empty)
-- The bag (S3, design C section 3, rule R1): the free commutative monoid
-- on A. bagOf is the generator, bagUnit the unit and bagOp the operation;
-- bagAssoc, bagComm and bagUnitL are the monoid paths (the right unit
-- follows from bagComm), and bagSquash in the form of Trunc0 squash0
-- makes it a set. A occurs only in the generator field. It was an
-- indexed HIT of lists up to a swap (S6, O20): a Size field and an
-- indexed bagOp have no comm path.
family Bag (A : Type 0) := bagOf (bagGen : A)
  | bagUnit
  | bagOp (opLeft : Bag A) (opRight : Bag A)
  | bagAssoc (assocX : Bag A) (assocY : Bag A) (assocZ : Bag A) (i : I)
    [ ~i -> bagOp A (bagOp A assocX assocY) assocZ, i -> bagOp A assocX (bagOp A assocY assocZ) ]
  | bagComm (commX : Bag A) (commY : Bag A) (i : I)
    [ ~i -> bagOp A commX commY, i -> bagOp A commY commX ]
  | bagUnitL (unitX : Bag A) (i : I)
    [ ~i -> bagOp A (bagUnit A) unitX, i -> unitX ]
  | bagSquash (bagFrom : Bag A) (bagTo : Bag A) (bagLeft : Path (Bag A) bagFrom bagTo) (bagRight : Path (Bag A) bagFrom bagTo) (i : I) (j : I)
    [ ~i -> bagLeft @ j, i -> bagRight @ j, ~j -> bagFrom, j -> bagTo ]
-- The free monoid (rule R1): the cell monad
-- of the monoid signature, with the generator fmEta and a set squash. The
-- cons list List is kit only (the host ABI); a guest List gives REFUSE_CELL,
-- and a guest program uses FreeMon. The bind is the fold (fmFold).
family FreeMon (A : Type 0) := fmEta (fmEtaOf : A)
  | fmUnit
  | fmMul (fmLeft : FreeMon A) (fmRight : FreeMon A)
  | fmAssoc (fmAssocX : FreeMon A) (fmAssocY : FreeMon A) (fmAssocZ : FreeMon A) (i : I)
    [ ~i -> fmMul A (fmMul A fmAssocX fmAssocY) fmAssocZ, i -> fmMul A fmAssocX (fmMul A fmAssocY fmAssocZ) ]
  | fmUnitL (fmUnitLOf : FreeMon A) (i : I)
    [ ~i -> fmMul A (fmUnit A) fmUnitLOf, i -> fmUnitLOf ]
  | fmUnitR (fmUnitROf : FreeMon A) (i : I)
    [ ~i -> fmMul A fmUnitROf (fmUnit A), i -> fmUnitROf ]
  | fmSquash (fmFrom : FreeMon A) (fmTo : FreeMon A) (fmPathL : Path (FreeMon A) fmFrom fmTo) (fmPathR : Path (FreeMon A) fmFrom fmTo) (i : I) (j : I)
    [ ~i -> fmPathL @ j, i -> fmPathR @ j, ~j -> fmFrom, j -> fmTo ]
def fmCons : (A : Type 0) -> A -> FreeMon A -> FreeMon A :=
  fun (A : Type 0) (a : A) (xs : FreeMon A) => fmMul A (fmEta A a) xs
def fmIsSet : (A : Type 0) -> isSet (FreeMon A) :=
  fun (A : Type 0) (x : FreeMon A) (y : FreeMon A) (p : Path (FreeMon A) x y) (q : Path (FreeMon A) x y) => fun (i : I) => fun (j : I) => fmSquash A x y p q i j
-- The universal property: a map from A into a monoid M that is a set
-- extends to FreeMon A. The fold cases are the laws of M.
def fmFold : (A : Type 0) -> (M : Type 0) -> isSet M -> (e : M) -> (op : M -> M -> M) -> ((x : M) -> (y : M) -> (z : M) -> Path M (op (op x y) z) (op x (op y z))) -> ((x : M) -> Path M (op e x) x) -> ((x : M) -> Path M (op x e) x) -> (A -> M) -> FreeMon A -> M :=
  fun (A : Type 0) (M : Type 0) (s : isSet M) (e : M) (op : M -> M -> M) (assoc : (x : M) -> (y : M) -> (z : M) -> Path M (op (op x y) z) (op x (op y z))) (unitL : (x : M) -> Path M (op e x) x) (unitR : (x : M) -> Path M (op x e) x) (f : A -> M) (t : FreeMon A) =>
    fold (fun (a : A) => f a) e (fun (x : M) (y : M) => op x y)
      (fun (x : M) (y : M) (z : M) => fun (i : I) => assoc x y z @ i)
      (fun (x : M) => fun (i : I) => unitL x @ i)
      (fun (x : M) => fun (i : I) => unitR x @ i)
      (fun (x : M) (y : M) (p : Path M x y) (q : Path M x y) => fun (i : I) => fun (j : I) => (s x y p q @ i) @ j) t
def fmBind : (A : Type 0) -> (B : Type 0) -> (A -> FreeMon B) -> FreeMon A -> FreeMon B :=
  fun (A : Type 0) (B : Type 0) (k : A -> FreeMon B) => fmFold A (FreeMon B) (fmIsSet B) (fmUnit B) (fmMul B)
    (fun (x : FreeMon B) (y : FreeMon B) (z : FreeMon B) => fun (i : I) => fmAssoc B x y z i)
    (fun (x : FreeMon B) => fun (i : I) => fmUnitL B x i)
    (fun (x : FreeMon B) => fun (i : I) => fmUnitR B x i) k
def fmMap : (A : Type 0) -> (B : Type 0) -> (A -> B) -> FreeMon A -> FreeMon B :=
  fun (A : Type 0) (B : Type 0) (f : A -> B) => fmBind A B (fun (a : A) => fmEta B (f a))
-- The trace position: a position is an op
-- count. `len A r` is a C builtin (OP_FM_LEN): the domain cannot prove the
-- Nat monoid laws that fmFold needs (S3 survey section 7).
def OpPos : Type 0 := Nat
-- The positions of a bag (S7 B3, Q4): Pos n has n values, the first
-- position at each szS and a lift of each position of the tail. No
-- constructor gives Pos sz0. A domain family, so Fin stays internal (O23).
family Pos : Size -> Type 0 := posFirst (firstSize : Size) : Pos (szS firstSize)
  | posNext (nextSize : Size) (nextPos : Pos nextSize) : Pos (szS nextSize)
-- The words of adjacent swaps (S7 B3, Q5): wordSwap applies the rest,
-- then swaps the first two positions, and wordLift applies the inner
-- word to the tail, then the rest. The orbits of a word action are the
-- orbits of the symmetric group.
family Word : Size -> Type 0 := wordNil (nilSize : Size) : Word nilSize
  | wordSwap (wordAt : Size) (wordRest : Word (szS (szS wordAt))) : Word (szS (szS wordAt))
  | wordLift (liftSize : Size) (liftInner : Word liftSize) (liftRest : Word (szS liftSize)) : Word (szS liftSize)
-- The choice bags and the orbits at each size.
-- ChoiceBag is the old cons Bag at the choice
-- type Sum Unit Unit, and OrbitN n is the quotient of the configurations
-- Pos n -> Sum Unit Unit by the word action. The two families have no
-- parameter, so they are not type constructors (rule R1). sizePred gives
-- the index of a tail, consP puts a choice in front of a configuration,
-- swapFront swaps the first two positions and actW is the word action.
def sizePred : Size -> Size := fun (s : Size) => elim (fun (t : Size) => Size) sz0 (fun (k : Size) (ih : Size) => k) s
def consP : (n : Size) -> Sum Unit Unit -> (Pos n -> Sum Unit Unit) -> Pos (szS n) -> Sum Unit Unit :=
  fun (n : Size) (a : Sum Unit Unit) (t : Pos n -> Sum Unit Unit) (p : Pos (szS n)) =>
    (elim (fun (k : Size) (q : Pos k) => Sum Unit Unit -> (Pos (sizePred k) -> Sum Unit Unit) -> Sum Unit Unit)
      (fun (m : Size) => fun (b : Sum Unit Unit) (u : Pos m -> Sum Unit Unit) => b)
      (fun (m : Size) (q : Pos m) (ih : Sum Unit Unit -> (Pos (sizePred m) -> Sum Unit Unit) -> Sum Unit Unit) => fun (b : Sum Unit Unit) (u : Pos m -> Sum Unit Unit) => u q) p) a t
def swapFront : (m : Size) -> (Pos (szS (szS m)) -> Sum Unit Unit) -> Pos (szS (szS m)) -> Sum Unit Unit :=
  fun (m : Size) (c : Pos (szS (szS m)) -> Sum Unit Unit) =>
    consP (szS m) (c (posNext (szS m) (posFirst m))) (consP m (c (posFirst (szS m))) (fun (p : Pos m) => c (posNext (szS m) (posNext m p))))
def actW : (n : Size) -> Word n -> (Pos n -> Sum Unit Unit) -> Pos n -> Sum Unit Unit :=
  fun (n : Size) (w : Word n) => elim (fun (k : Size) (v : Word k) => (Pos k -> Sum Unit Unit) -> Pos k -> Sum Unit Unit)
    (fun (k : Size) => fun (d : Pos k -> Sum Unit Unit) => d)
    (fun (m : Size) (v : Word (szS (szS m))) (ih : (Pos (szS (szS m)) -> Sum Unit Unit) -> Pos (szS (szS m)) -> Sum Unit Unit) =>
      fun (d : Pos (szS (szS m)) -> Sum Unit Unit) => swapFront m (ih d))
    (fun (m : Size) (u : Word m) (ihu : (Pos m -> Sum Unit Unit) -> Pos m -> Sum Unit Unit) (v : Word (szS m)) (ihv : (Pos (szS m) -> Sum Unit Unit) -> Pos (szS m) -> Sum Unit Unit) =>
      fun (d : Pos (szS m) -> Sum Unit Unit) => ihv (consP m (d (posFirst m)) (ihu (fun (p : Pos m) => d (posNext m p))))) w
family ChoiceBag : Size -> Type 0 := choiceNil : ChoiceBag sz0
  | choiceCons (cbSize : Size) (cbHead : Sum Unit Unit) (cbTail : ChoiceBag cbSize) : ChoiceBag (szS cbSize)
  | choiceSwap (cbSwapSize : Size) (cbFirst : Sum Unit Unit) (cbSecond : Sum Unit Unit) (cbSwapTail : ChoiceBag cbSwapSize) (i : I) : ChoiceBag (szS (szS cbSwapSize))
    [ ~i -> choiceCons (szS cbSwapSize) cbFirst (choiceCons cbSwapSize cbSecond cbSwapTail), i -> choiceCons (szS cbSwapSize) cbSecond (choiceCons cbSwapSize cbFirst cbSwapTail) ]
  | choiceSquash (cbSquashSize : Size) (cbFrom : ChoiceBag cbSquashSize) (cbTo : ChoiceBag cbSquashSize) (cbLeft : Path (ChoiceBag cbSquashSize) cbFrom cbTo) (cbRight : Path (ChoiceBag cbSquashSize) cbFrom cbTo) (i : I) (j : I) : ChoiceBag cbSquashSize
    [ ~i -> cbLeft @ j, i -> cbRight @ j, ~j -> cbFrom, j -> cbTo ]
family OrbitN : Size -> Type 0 := orbitNOf (onSize : Size) (onOf : Pos onSize -> Sum Unit Unit) : OrbitN onSize
  | orbitNEq (onEqSize : Size) (onA : Pos onEqSize -> Sum Unit Unit) (onB : Pos onEqSize -> Sum Unit Unit) (onR : Sigma (w : Word onEqSize) (Path (Pos onEqSize -> Sum Unit Unit) (actW onEqSize w onB) onA)) (i : I) : OrbitN onEqSize
    [ ~i -> orbitNOf onEqSize onA, i -> orbitNOf onEqSize onB ]
  | orbitNSquash (onSqSize : Size) (onFrom : OrbitN onSqSize) (onTo : OrbitN onSqSize) (onLeft : Path (OrbitN onSqSize) onFrom onTo) (onRight : Path (OrbitN onSqSize) onFrom onTo) (i : I) (j : I) : OrbitN onSqSize
    [ ~i -> onLeft @ j, i -> onRight @ j, ~j -> onFrom, j -> onTo ]
-- The charter and its ratifications (S6, O20): an inductive-inductive
-- block. Ratified c is a rule ratified at the charter c, adopt adds a
-- ratified rule to a charter, and adoptTwice is law 4 in the type: a
-- second adoption of the same rule is a path from the first. A squash at
-- each sort in the form of Trunc0 squash0 makes each sort a set. Field
-- names are global (rule R4), so each has the prefix of its constructor.
-- The rule type is Size: the block has no
-- parameter, so it is not a type constructor (rule R1).
family Charter := genesis
  | adopt (adoptBase : Charter) (adoptRule : Ratified adoptBase)
  | adoptTwice (twiceBase : Charter) (twiceRule : Size) (i : I)
    [ ~i -> adopt twiceBase (ratify twiceBase twiceRule), i -> adopt (adopt twiceBase (ratify twiceBase twiceRule)) (ratify (adopt twiceBase (ratify twiceBase twiceRule)) twiceRule) ]
  | charterSquash (charterFrom : Charter) (charterTo : Charter) (charterLeft : Path Charter charterFrom charterTo) (charterRight : Path Charter charterFrom charterTo) (i : I) (j : I)
    [ ~i -> charterLeft @ j, i -> charterRight @ j, ~j -> charterFrom, j -> charterTo ]
and Ratified : Charter -> Type 0 := ratify (ratifyBase : Charter) (ratifyRule : Size) : Ratified ratifyBase
  | ratifiedSquash (ratifiedAt : Charter) (ratifiedFrom : Ratified ratifiedAt) (ratifiedTo : Ratified ratifiedAt) (ratifiedLeft : Path (Ratified ratifiedAt) ratifiedFrom ratifiedTo) (ratifiedRight : Path (Ratified ratifiedAt) ratifiedFrom ratifiedTo) (i : I) (j : I) : Ratified ratifiedAt
    [ ~i -> ratifiedLeft @ j, i -> ratifiedRight @ j, ~j -> ratifiedFrom, j -> ratifiedTo ]

-- Equivalences (S3a, R3 (a)): contractible types, fibers, isEquiv and
-- Equiv as Sigma types (the map, then for each y the center pack x p and
-- the contraction), idEquiv, and isoToEquiv as in agda/cubical
-- isoToIsEquiv. isoCap is the fill at k = i1; isoPath is the first part
-- of the fiber path. The squares are inline, with j flipped.
def isContr : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => Sigma (c : A) ((x : A) -> Path A c x)
def fiber : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (y : B) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (y : B) => Sigma (x : A) (Path B (f x) y)
def isEquiv : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => (y : B) -> isContr (fiber A B f y)
def Equiv : (A : Type 0) -> (B : Type 0) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => Sigma (f : A -> B) (isEquiv A B f)
def idEquiv : (A : Type 0) -> Equiv A A :=
  fun (A : Type 0) => pack (fun (x : A) => x) (fun (y : A) =>
    pack (pack y refl) (fun (z : fiber A A (fun (x : A) => x) y) =>
      fun (i : I) => pack (payload z @ ~i) (fun (j : I) => payload z @ (~i \/ j))))
def isoCap : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) ->
  (y : B) -> (x0 : A) -> (p0 : Path B (f x0) y) -> Path A (g y) x0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  fun (y : B) => fun (x0 : A) => fun (p0 : Path B (f x0) y) =>
    fun (i : I) => hcomp A (i \/ ~i \/ ~i1) (fun (m : I) => [ i -> t x0 @ (i1 /\ m), ~i -> g y, ~i1 -> g (p0 @ ~i) ]) (g (p0 @ ~i))
def isoPath : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) ->
  (y : B) -> (x0 : A) -> (p0 : Path B (f x0) y) -> (x1 : A) -> (p1 : Path B (f x1) y) -> Path A x0 x1 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  fun (y : B) => fun (x0 : A) => fun (p0 : Path B (f x0) y) => fun (x1 : A) => fun (p1 : Path B (f x1) y) =>
    fun (i : I) => hcomp A (i \/ ~i \/ ~i1) (fun (m2 : I) => [ i -> isoCap A B f g t y x1 p1 @ (i1 /\ m2), ~i -> isoCap A B f g t y x0 p0 @ (i1 /\ m2), ~i1 -> g y ]) (g y)
def isoToEquiv : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) ->
  (s : (y : B) -> Path B (f (g y)) y) -> (t : (x : A) -> Path A (g (f x)) x) -> Equiv A B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) =>
  fun (s : (y : B) -> Path B (f (g y)) y) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  pack f (fun (y : B) => pack (pack (g y) (s y)) (fun (z : fiber A B f y) =>
    fun (i : I) => pack (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i) (fun (j : I) =>
      hcomp B (i \/ ~i \/ ~j \/ j) (fun (m4 : I) => [
        i -> s (payload z @ j) @ m4,
        ~i -> s (s y @ j) @ m4,
        ~j -> s (f (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i)) @ m4,
        j -> s y @ m4 ])
      (f (hcomp A (i \/ ~i \/ ~j \/ j) (fun (m3 : I) => [
        i -> hcomp A (~j \/ j \/ m3) (fun (m : I) => [ ~j -> t (witness z) @ (~m3 /\ m), j -> g y, m3 -> g (payload z @ j) ]) (g (payload z @ j)),
        ~i -> hcomp A (~j \/ j \/ m3) (fun (m : I) => [ ~j -> t (g y) @ (~m3 /\ m), j -> g y, m3 -> g (s y @ j) ]) (g (s y @ j)),
        ~j -> t (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i) @ ~m3,
        j -> g y ])
        (hcomp A (i \/ ~i \/ j) (fun (m2 : I) => [
          i -> isoCap A B f g t y (witness z) (payload z) @ (~j /\ m2),
          ~i -> isoCap A B f g t y (g y) (s y) @ (~j /\ m2),
          j -> g y ]) (g y)))))))

-- ua (S3b): the Glue line from A to B. At i0 the type is A through e; at
-- i1 the type is B through idEquiv B. Transport along ua e at a closed
-- value of A gives witness e of the value (uaBeta).
def ua : (A : Type 0) -> (B : Type 0) -> (e : Equiv A B) -> Path (Type 0) A B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (e : Equiv A B) =>
    fun (i : I) => Glue B (~i \/ i) (fun (_ : I) => [ ~i -> pack A e, i -> pack B (idEquiv B) ])
-- uaArrow (S3c): agda/cubical ua-> with a constant C. A path h a from
-- f0 a to f1 (witness e a) for each a gives a path of functions over ua e
-- from f0 to f1. At i0 the hcomp is its ~i tube at j = i1, h a @ i0 =
-- f0 a; at i1 it is its i tube, f1 a. The base is f1 (unglue a).
def uaArrow : (A : Type 0) -> (B : Type 0) -> (C : Type 0) -> (e : Equiv A B) -> (f0 : A -> C) -> (f1 : B -> C) ->
  (h : (a : A) -> Path C (f0 a) (f1 (witness e a))) -> PathP (fun (i : I) => (ua A B e @ i) -> C) f0 f1 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (C : Type 0) => fun (e : Equiv A B) => fun (f0 : A -> C) => fun (f1 : B -> C) =>
  fun (h : (a : A) -> Path C (f0 a) (f1 (witness e a))) =>
    fun (i : I) => fun (a : ua A B e @ i) => hcomp C (~i \/ i) (fun (j : I) => [ ~i -> h a @ ~j, i -> f1 a ]) (f1 (unglue a))

-- A binary tree for the IR tests (S3). fork has
-- two recursive fields, so a fold over a run-time Tree gives
-- REFUSE_RUNTIME_TREE (test/ir/tree.lang). No def here uses it.
family Tree := tip | fork (forkLeft : Tree) (forkRight : Tree)

-- Two blocks for the block rows of the lowering (S3). Signal and Shutter have no recursive field, so a fold over
-- Shutter is a case split: its cases come after the two cases of Signal
-- (test/ir/block.lang). Hop and Echo each have one recursive field of the
-- other family, so the lowering refuses a fold over them (test/ir/hop.lang).
family Signal := sigQuiet | sigLoud (loudLevel : Nat)
and Shutter := winOpen | winShut (shutFor : Nat)
family Hop := hopEnd | hopNext (nextEcho : Echo)
and Echo := echoBack (backHop : Hop)
-- The R1 formers (S4, PLAN section 3, Q-S0-3 (a)). Sealed is the carrier
-- of the identity cell monad Enc of the design (design sec 3): seal is the
-- unit, encBind is the bind and encMap is the map. The family is sealed
-- (rule O7): a program can make a Sealed value, but an elim, a fold or a
-- projection of Sealed in a program def that is not a law gives
-- REFUSE_LAW. open is the law-only monad morphism Enc -> Id (the design
-- decrypt): a program can name open only in a law. In a later slice only
-- settle and the tally (domain words) call it, after a certificate. The
-- unit law and the bind law of open (law S6) are paths by refl and elim.
sealed family Sealed (A : Type 0) := seal (sealOf : A)
def Enc : Type 0 -> Type 0 := fun (A : Type 0) => Sealed A
def encBind : (A : Type 0) -> (B : Type 0) -> Sealed A -> (A -> Sealed B) -> Sealed B :=
  fun (A : Type 0) (B : Type 0) (m : Sealed A) (f : A -> Sealed B) =>
    elim (fun (s : Sealed A) => Sealed B) (fun (a : A) => f a) m
def encMap : (A : Type 0) -> (B : Type 0) -> (A -> B) -> Sealed A -> Sealed B :=
  fun (A : Type 0) (B : Type 0) (g : A -> B) (m : Sealed A) =>
    encBind A B m (fun (a : A) => seal B (g a))
law def open : (A : Type 0) -> Sealed A -> A :=
  fun (A : Type 0) (m : Sealed A) => elim (fun (s : Sealed A) => A) (fun (a : A) => a) m
law def openSeal : (A : Type 0) -> (a : A) -> Path A (open A (seal A a)) a :=
  fun (A : Type 0) (a : A) => refl
law def openBind : (A : Type 0) -> (B : Type 0) -> (m : Sealed A) -> (f : A -> Sealed B) -> Path B (open B (encBind A B m f)) (open B (f (open A m))) :=
  fun (A : Type 0) (B : Type 0) (m : Sealed A) (f : A -> Sealed B) =>
    elim (fun (s : Sealed A) => Path B (open B (encBind A B s f)) (open B (f (open A s)))) (fun (a : A) => refl) m
-- The base types of design sec 3 (S5, Q-S5-1 to Q-S5-8). Amount and Height
-- are inductive families, so their laws are proofs by elim. A program reads
-- a base type only through the words below: an elim, a fold or a
-- projection of a base family, or amSucc or htSucc on a term that is not a
-- literal, gives REFUSE_READ (Q-S5-5 (a)). There is no subtraction and no
-- division on Amount and Height. The compare result is Sum Unit Unit as in
-- consP: inr unit is "at most" and inl unit is "more than". amSelect A x y
-- p q is p when x is at most y, else q. The checker gives each program sum
-- and product a static bound (Q-S5-1 (a)): an Amount input 2^64 - 1, a
-- Height input 2^32 - 1, and REFUSE_BOUND when a bound passes 2^128 - 1.
-- Amount, amLe, amSelect, amMax, amMin and their laws are a hand port of
-- gavel-lang b2da56f.
family Amount := amZero | amSucc (amPred : Amount)
family Height := htZero | htSucc (htPred : Height)
def amLe : Amount -> Amount -> Sum Unit Unit :=
  fun (x : Amount) => elim (fun (a : Amount) => Amount -> Sum Unit Unit)
    (fun (y : Amount) => inr unit)
    (fun (a : Amount) (ih : Amount -> Sum Unit Unit) => fun (y : Amount) =>
      elim (fun (b : Amount) => Sum Unit Unit) (inl unit) (fun (b : Amount) (ihb : Sum Unit Unit) => ih b) y) x
def amSelect : (A : Type 0) -> Amount -> Amount -> A -> A -> A :=
  fun (A : Type 0) (x : Amount) => elim (fun (a : Amount) => Amount -> A -> A -> A)
    (fun (y : Amount) (p : A) (q : A) => p)
    (fun (a : Amount) (ih : Amount -> A -> A -> A) => fun (y : Amount) =>
      elim (fun (b : Amount) => A -> A -> A) (fun (p : A) (q : A) => q) (fun (b : Amount) (ihb : A -> A -> A) => ih b) y) x
def amMax : Amount -> Amount -> Amount :=
  fun (x : Amount) => elim (fun (a : Amount) => Amount -> Amount)
    (fun (y : Amount) => y)
    (fun (a : Amount) (ih : Amount -> Amount) => fun (y : Amount) =>
      elim (fun (b : Amount) => Amount) (amSucc a) (fun (b : Amount) (ihb : Amount) => amSucc (ih b)) y) x
def amMin : Amount -> Amount -> Amount :=
  fun (x : Amount) => elim (fun (a : Amount) => Amount -> Amount)
    (fun (y : Amount) => amZero)
    (fun (a : Amount) (ih : Amount -> Amount) => fun (y : Amount) =>
      elim (fun (b : Amount) => Amount) amZero (fun (b : Amount) (ihb : Amount) => amSucc (ih b)) y) x
-- amAdd x y is the sum. amScale k x is the product of x by the public
-- scalar k (Q-S5-2 (a)): k copies of x.
def amAdd : Amount -> Amount -> Amount :=
  fun (x : Amount) (y : Amount) => elim (fun (a : Amount) => Amount) y (fun (a : Amount) (ih : Amount) => amSucc ih) x
def amScale : Height -> Amount -> Amount :=
  fun (k : Height) (x : Amount) => elim (fun (h : Height) => Amount) amZero (fun (h : Height) (ih : Amount) => amAdd x ih) k
-- The laws of amLe, amMax, amMin and amSelect, by induction on the amounts.
-- "x is at most y" is the path amMax x y = y; leOfMax turns it into the
-- compare form amLe x y = inr unit.
def leRefl : (x : Amount) -> Path (Sum Unit Unit) (amLe x x) (inr unit) :=
  fun (x : Amount) => elim (fun (a : Amount) => Path (Sum Unit Unit) (amLe a a) (inr unit)) refl
    (fun (a : Amount) (ih : Path (Sum Unit Unit) (amLe a a) (inr unit)) => ih) x
def maxLe : (x : Amount) -> (y : Amount) -> Path (Sum Unit Unit) (amLe x (amMax x y)) (inr unit) :=
  fun (x : Amount) => elim (fun (a : Amount) => (y : Amount) -> Path (Sum Unit Unit) (amLe a (amMax a y)) (inr unit))
    (fun (y : Amount) => refl)
    (fun (a : Amount) (ih : (y : Amount) -> Path (Sum Unit Unit) (amLe a (amMax a y)) (inr unit)) => fun (y : Amount) =>
      elim (fun (b : Amount) => Path (Sum Unit Unit) (amLe (amSucc a) (amMax (amSucc a) b)) (inr unit))
        (leRefl a)
        (fun (b : Amount) (ihb : Path (Sum Unit Unit) (amLe (amSucc a) (amMax (amSucc a) b)) (inr unit)) => ih b) y) x
def maxIdem : (x : Amount) -> Path Amount (amMax x x) x :=
  fun (x : Amount) => elim (fun (a : Amount) => Path Amount (amMax a a) a) refl
    (fun (a : Amount) (ih : Path Amount (amMax a a) a) => cong (fun (m : Amount) => amSucc m) ih) x
def maxComm : (x : Amount) -> (y : Amount) -> Path Amount (amMax x y) (amMax y x) :=
  fun (x : Amount) => elim (fun (a : Amount) => (y : Amount) -> Path Amount (amMax a y) (amMax y a))
    (fun (y : Amount) => elim (fun (b : Amount) => Path Amount (amMax amZero b) (amMax b amZero)) refl
      (fun (b : Amount) (ihb : Path Amount (amMax amZero b) (amMax b amZero)) => refl) y)
    (fun (a : Amount) (ih : (y : Amount) -> Path Amount (amMax a y) (amMax y a)) => fun (y : Amount) =>
      elim (fun (b : Amount) => Path Amount (amMax (amSucc a) b) (amMax b (amSucc a))) refl
        (fun (b : Amount) (ihb : Path Amount (amMax (amSucc a) b) (amMax b (amSucc a))) => cong (fun (m : Amount) => amSucc m) (ih b)) y) x
def maxAssoc : (x : Amount) -> (y : Amount) -> (z : Amount) -> Path Amount (amMax (amMax x y) z) (amMax x (amMax y z)) :=
  fun (x : Amount) => elim (fun (a : Amount) => (y : Amount) -> (z : Amount) -> Path Amount (amMax (amMax a y) z) (amMax a (amMax y z)))
    (fun (y : Amount) (z : Amount) => refl)
    (fun (a : Amount) (ih : (y : Amount) -> (z : Amount) -> Path Amount (amMax (amMax a y) z) (amMax a (amMax y z))) => fun (y : Amount) =>
      elim (fun (b : Amount) => (z : Amount) -> Path Amount (amMax (amMax (amSucc a) b) z) (amMax (amSucc a) (amMax b z)))
        (fun (z : Amount) => refl)
        (fun (b : Amount) (ihb : (z : Amount) -> Path Amount (amMax (amMax (amSucc a) b) z) (amMax (amSucc a) (amMax b z))) => fun (z : Amount) =>
          elim (fun (c : Amount) => Path Amount (amMax (amMax (amSucc a) (amSucc b)) c) (amMax (amSucc a) (amMax (amSucc b) c)))
            refl
            (fun (c : Amount) (ihc : Path Amount (amMax (amMax (amSucc a) (amSucc b)) c) (amMax (amSucc a) (amMax (amSucc b) c))) =>
              cong (fun (m : Amount) => amSucc m) (ih b c)) z) y) x
def maxSwap : (x : Amount) -> (y : Amount) -> (z : Amount) -> Path Amount (amMax x (amMax y z)) (amMax y (amMax x z)) :=
  fun (x : Amount) (y : Amount) (z : Amount) =>
    trans Amount (amMax x (amMax y z)) (amMax (amMax x y) z) (amMax y (amMax x z))
      (sym (maxAssoc x y z))
      (trans Amount (amMax (amMax x y) z) (amMax (amMax y x) z) (amMax y (amMax x z))
        (cong (fun (m : Amount) => amMax m z) (maxComm x y))
        (maxAssoc y x z))
def minMax : (x : Amount) -> (y : Amount) -> Path Amount (amMax (amMin x y) (amMax x y)) (amMax x y) :=
  fun (x : Amount) => elim (fun (a : Amount) => (y : Amount) -> Path Amount (amMax (amMin a y) (amMax a y)) (amMax a y))
    (fun (y : Amount) => refl)
    (fun (a : Amount) (ih : (y : Amount) -> Path Amount (amMax (amMin a y) (amMax a y)) (amMax a y)) => fun (y : Amount) =>
      elim (fun (b : Amount) => Path Amount (amMax (amMin (amSucc a) b) (amMax (amSucc a) b)) (amMax (amSucc a) b))
        refl
        (fun (b : Amount) (ihb : Path Amount (amMax (amMin (amSucc a) b) (amMax (amSucc a) b)) (amMax (amSucc a) b)) =>
          cong (fun (m : Amount) => amSucc m) (ih b)) y) x
def selMap : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (x : Amount) -> (y : Amount) -> (p : A) -> (q : A) -> Path B (amSelect B x y (f p) (f q)) (f (amSelect A x y p q)) :=
  fun (A : Type 0) (B : Type 0) (f : A -> B) (x : Amount) => elim (fun (a : Amount) => (y : Amount) -> (p : A) -> (q : A) -> Path B (amSelect B a y (f p) (f q)) (f (amSelect A a y p q)))
    (fun (y : Amount) (p : A) (q : A) => refl)
    (fun (a : Amount) (ih : (y : Amount) -> (p : A) -> (q : A) -> Path B (amSelect B a y (f p) (f q)) (f (amSelect A a y p q))) => fun (y : Amount) =>
      elim (fun (b : Amount) => (p : A) -> (q : A) -> Path B (amSelect B (amSucc a) b (f p) (f q)) (f (amSelect A (amSucc a) b p q)))
        (fun (p : A) (q : A) => refl)
        (fun (b : Amount) (ihb : (p : A) -> (q : A) -> Path B (amSelect B (amSucc a) b (f p) (f q)) (f (amSelect A (amSucc a) b p q))) => ih b) y) x
def selRefl : (A : Type 0) -> (x : Amount) -> (p : A) -> (q : A) -> Path A (amSelect A x x p q) p :=
  fun (A : Type 0) (x : Amount) => elim (fun (a : Amount) => (p : A) -> (q : A) -> Path A (amSelect A a a p q) p)
    (fun (p : A) (q : A) => refl)
    (fun (a : Amount) (ih : (p : A) -> (q : A) -> Path A (amSelect A a a p q) p) => ih) x
def selMax : (x : Amount) -> (y : Amount) -> Path Amount (amSelect Amount x y y x) (amMax x y) :=
  fun (x : Amount) => elim (fun (a : Amount) => (y : Amount) -> Path Amount (amSelect Amount a y y a) (amMax a y))
    (fun (y : Amount) => refl)
    (fun (a : Amount) (ih : (y : Amount) -> Path Amount (amSelect Amount a y y a) (amMax a y)) => fun (y : Amount) =>
      elim (fun (b : Amount) => Path Amount (amSelect Amount (amSucc a) b b (amSucc a)) (amMax (amSucc a) b))
        refl
        (fun (b : Amount) (ihb : Path Amount (amSelect Amount (amSucc a) b b (amSucc a)) (amMax (amSucc a) b)) =>
          trans Amount (amSelect Amount a b (amSucc b) (amSucc a)) (amSucc (amSelect Amount a b b a)) (amSucc (amMax a b))
            (selMap Amount Amount (fun (m : Amount) => amSucc m) a b b a)
            (cong (fun (m : Amount) => amSucc m) (ih b))) y) x
def lubLe : (x : Amount) -> (y : Amount) -> (m : Amount) -> Path Amount (amMax x m) m -> Path Amount (amMax y m) m -> Path Amount (amMax (amMax x y) m) m :=
  fun (x : Amount) (y : Amount) (m : Amount) (p : Path Amount (amMax x m) m) (q : Path Amount (amMax y m) m) =>
    trans Amount (amMax (amMax x y) m) (amMax x (amMax y m)) m (maxAssoc x y m)
      (trans Amount (amMax x (amMax y m)) (amMax x m) m (cong (fun (n : Amount) => amMax x n) q) p)
def leMaxR : (x : Amount) -> (m : Amount) -> (n : Amount) -> Path Amount (amMax x m) m -> Path Amount (amMax x (amMax n m)) (amMax n m) :=
  fun (x : Amount) (m : Amount) (n : Amount) (p : Path Amount (amMax x m) m) =>
    trans Amount (amMax x (amMax n m)) (amMax n (amMax x m)) (amMax n m) (maxSwap x n m) (cong (fun (k : Amount) => amMax n k) p)
def leOfMax : (x : Amount) -> (y : Amount) -> Path Amount (amMax x y) y -> Path (Sum Unit Unit) (amLe x y) (inr unit) :=
  fun (x : Amount) (y : Amount) (p : Path Amount (amMax x y) y) =>
    trans (Sum Unit Unit) (amLe x y) (amLe x (amMax x y)) (inr unit) (cong (fun (m : Amount) => amLe x m) (sym p)) (maxLe x y)
-- The laws of amAdd and amScale: the zero and succ equations hold by refl;
-- amAddZeroR and scaleOne go by induction.
def addZeroL : (y : Amount) -> Path Amount (amAdd amZero y) y :=
  fun (y : Amount) => refl
def addSuccL : (x : Amount) -> (y : Amount) -> Path Amount (amAdd (amSucc x) y) (amSucc (amAdd x y)) :=
  fun (x : Amount) (y : Amount) => refl
def amAddZeroR : (x : Amount) -> Path Amount (amAdd x amZero) x :=
  fun (x : Amount) => elim (fun (a : Amount) => Path Amount (amAdd a amZero) a) refl
    (fun (a : Amount) (ih : Path Amount (amAdd a amZero) a) => cong (fun (m : Amount) => amSucc m) ih) x
def scaleZero : (x : Amount) -> Path Amount (amScale htZero x) amZero :=
  fun (x : Amount) => refl
def scaleSucc : (k : Height) -> (x : Amount) -> Path Amount (amScale (htSucc k) x) (amAdd x (amScale k x)) :=
  fun (k : Height) (x : Amount) => refl
def scaleOne : (x : Amount) -> Path Amount (amScale (htSucc htZero) x) x :=
  fun (x : Amount) => amAddZeroR x
-- The height words have the shape of the amount words: htLe (compare),
-- htSelect (select), htAdd (sum) and htScale (product by a public scalar,
-- Q-S5-2 (a)).
def htLe : Height -> Height -> Sum Unit Unit :=
  fun (x : Height) => elim (fun (a : Height) => Height -> Sum Unit Unit)
    (fun (y : Height) => inr unit)
    (fun (a : Height) (ih : Height -> Sum Unit Unit) => fun (y : Height) =>
      elim (fun (b : Height) => Sum Unit Unit) (inl unit) (fun (b : Height) (ihb : Sum Unit Unit) => ih b) y) x
def htSelect : (A : Type 0) -> Height -> Height -> A -> A -> A :=
  fun (A : Type 0) (x : Height) => elim (fun (a : Height) => Height -> A -> A -> A)
    (fun (y : Height) (p : A) (q : A) => p)
    (fun (a : Height) (ih : Height -> A -> A -> A) => fun (y : Height) =>
      elim (fun (b : Height) => A -> A -> A) (fun (p : A) (q : A) => q) (fun (b : Height) (ihb : A -> A -> A) => ih b) y) x
def htAdd : Height -> Height -> Height :=
  fun (x : Height) (y : Height) => elim (fun (a : Height) => Height) y (fun (a : Height) (ih : Height) => htSucc ih) x
def htScale : Height -> Height -> Height :=
  fun (k : Height) (x : Height) => elim (fun (h : Height) => Height) htZero (fun (h : Height) (ih : Height) => htAdd x ih) k
def htLeRefl : (x : Height) -> Path (Sum Unit Unit) (htLe x x) (inr unit) :=
  fun (x : Height) => elim (fun (a : Height) => Path (Sum Unit Unit) (htLe a a) (inr unit)) refl
    (fun (a : Height) (ih : Path (Sum Unit Unit) (htLe a a) (inr unit)) => ih) x
def htAddZeroR : (x : Height) -> Path Height (htAdd x htZero) x :=
  fun (x : Height) => elim (fun (a : Height) => Path Height (htAdd a htZero) a) refl
    (fun (a : Height) (ih : Path Height (htAdd a htZero) a) => cong (fun (m : Height) => htSucc m) ih) x
def htScaleSucc : (k : Height) -> (x : Height) -> Path Height (htScale (htSucc k) x) (htAdd x (htScale k x)) :=
  fun (k : Height) (x : Height) => refl
def htScaleOne : (x : Height) -> Path Height (htScale (htSucc htZero) x) x :=
  fun (x : Height) => htAddZeroR x
-- The window (design sec 3): a start height and a length. The family
-- keeps the length minus one, so the length htSucc winLenPred is more than
-- zero by construction. A program reads a window only by wStart and wLen.
family Window := window (winStart : Height) (winLenPred : Height)
def wStart : Window -> Height :=
  fun (w : Window) => elim (fun (v : Window) => Height) (fun (s : Height) (l : Height) => s) w
def wLen : Window -> Height :=
  fun (w : Window) => elim (fun (v : Window) => Height) (fun (s : Height) (l : Height) => htSucc l) w
def wLenPos : (w : Window) -> Path (Sum Unit Unit) (htLe (htSucc htZero) (wLen w)) (inr unit) :=
  fun (w : Window) => elim (fun (v : Window) => Path (Sum Unit Unit) (htLe (htSucc htZero) (wLen v)) (inr unit)) (fun (s : Height) (l : Height) => refl) w
-- The token and the nullifier: one constructor over Nat each. tkEq and
-- nfEq are the equality words (inr unit is "equal").
family Token := token (tokId : Nat)
def tkEq : Token -> Token -> Sum Unit Unit :=
  fun (a : Token) (b : Token) => elim (fun (u : Token) => Sum Unit Unit)
    (fun (i : Nat) => elim (fun (v : Token) => Sum Unit Unit)
      (fun (j : Nat) => flagIf (natEq i j) (inr unit) (inl unit)) b) a
family Nullifier := nullifier (nfId : Nat)
def nfEq : Nullifier -> Nullifier -> Sum Unit Unit :=
  fun (a : Nullifier) (b : Nullifier) => elim (fun (u : Nullifier) => Sum Unit Unit)
    (fun (i : Nat) => elim (fun (v : Nullifier) => Sum Unit Unit)
      (fun (j : Nat) => flagIf (natEq i j) (inr unit) (inl unit)) b) a
-- The opaque types (design sec 3): one constructor over Nat each. Their
-- equality words come with the slice that needs them (S6, S7); Hash comes
-- at S8b.
family Key := key (keyId : Nat)
family Sig := sig (sigId : Nat)
family Commitment := commitment (cmtId : Nat)
family Root := root (rootId : Nat)
-- The swap of design sec 4 (S6). Intent, Quote, Transfer and Fill are
-- records: a family with one constructor, so each field is a projection.
-- A domain field name is global (rule R4), so each field name has the
-- prefix of its record. A program reads an Amount or Height field of a
-- record parameter at its width (Q-S6-1 (a)) and a Window field of a
-- record parameter at the Window widths (Q-S6-2 (a)). The decoy index is
-- a Sealed Height (OI-6).
family Intent := intent (itInTok : Token) (itOutTok : Token) (itAmtIn : Sealed Amount) (itMinOut : Sealed Amount) (itDecoy : Sealed Height) (itStartOut : Amount) (itWindow : Window) (itDeadline : Height) (itNf : Nullifier) (itOwner : Key) (itSig : Sig)
family Quote := quote (qtOut : Sealed Amount) (qtSolver : Key)
family Transfer := transfer (trTok : Token) (trAmt : Amount) (trFrom : Key) (trTo : Key)
family Fill := fill (flIntent : Intent) (flQuote : Quote) (flLegIn : Transfer) (flLegOut : Transfer) (flHeight : Height)
-- The reasons of a rejected settle. S6 uses reused, expired, badPair,
-- badProof and belowFloor. badCert, belowTMin, badPrice and noFunds come
-- with S7, badShare with S8b.
family Reason := badProof | badShare | expired | reused | badPair | belowFloor | badCert | belowTMin | badPrice | noFunds
-- A verdict is accept with a value or reject with a reason. The value
-- field is vdVal, because vdOk is the name of a law of S6.
family Verdict (A : Type 0) := accept (vdVal : A) | reject (vdWhy : Reason)
-- The outcome of a settle is two transfers. unfilled comes with the replay
-- of S7.
family Outcome := settled (stIn : Transfer) (stOut : Transfer) | unfilled
-- The spent nullifiers: the spent field of the Book of S7 (Q-S6-6 (a), Q-S7-5 (a)).
family Spent := spNil | spCons (spHead : Nullifier) (spTail : Spent)
-- sAnd, sOr and sNot on the flag Sum Unit Unit (inr unit is "yes"): a hand
-- port of gavel-lang 1bc4437.
def sAnd : Sum Unit Unit -> Sum Unit Unit -> Sum Unit Unit :=
  fun (a : Sum Unit Unit) (b : Sum Unit Unit) => elim (fun (s : Sum Unit Unit) => Sum Unit Unit) (fun (u : Unit) => inl unit) (fun (u : Unit) => b) a
def sOr : Sum Unit Unit -> Sum Unit Unit -> Sum Unit Unit :=
  fun (a : Sum Unit Unit) (b : Sum Unit Unit) => elim (fun (s : Sum Unit Unit) => Sum Unit Unit) (fun (u : Unit) => b) (fun (u : Unit) => inr unit) a
def sNot : Sum Unit Unit -> Sum Unit Unit :=
  fun (a : Sum Unit Unit) => elim (fun (s : Sum Unit Unit) => Sum Unit Unit) (fun (u : Unit) => inr unit) (fun (u : Unit) => inl unit) a
-- vdCheck A s w v is v when s says yes, else reject A w.
def vdCheck : (A : Type 0) -> Sum Unit Unit -> Reason -> Verdict A -> Verdict A :=
  fun (A : Type 0) (s : Sum Unit Unit) (w : Reason) (v : Verdict A) =>
    elim (fun (k : Sum Unit Unit) => Verdict A) (fun (u : Unit) => reject A w) (fun (u : Unit) => v) s
-- spHas n l says yes when the nullifier n is in l.
def spHas : Nullifier -> Spent -> Sum Unit Unit :=
  fun (n : Nullifier) (l : Spent) =>
    elim (fun (k : Spent) => Sum Unit Unit) (inl unit) (fun (g : Nullifier) (t : Spent) (ih : Sum Unit Unit) => sOr (nfEq n g) ih) l
-- sgVrf k g says yes when the signature g is from the key k. It is a
-- stand-in: at S8b the match becomes the proof check.
def sgVrf : Key -> Sig -> Sum Unit Unit :=
  fun (k : Key) (g : Sig) => elim (fun (u : Key) => Sum Unit Unit)
    (fun (i : Nat) => elim (fun (v : Sig) => Sum Unit Unit)
      (fun (j : Nat) => flagIf (natEq i j) (inr unit) (inl unit)) g) k
-- encMap2 (Q-S6-3 (a)) maps a word with two arguments over two sealed
-- values: encBind on the first value, encMap on the second value.
def encMap2 : (A : Type 0) -> (B : Type 0) -> (C : Type 0) -> (A -> B -> C) -> Sealed A -> Sealed B -> Sealed C :=
  fun (A : Type 0) (B : Type 0) (C : Type 0) (g : A -> B -> C) (m : Sealed A) (n : Sealed B) =>
    encBind A C m (fun (a : A) => encMap B C (fun (b : B) => g a b) n)
-- wClamp w h is the height h clamped into [wStart w, wStart w + wLen w].
def wClamp : Window -> Height -> Height :=
  fun (w : Window) (h : Height) =>
    htSelect Height h (wStart w) (wStart w)
      (htSelect Height (htAdd (wStart w) (wLen w)) h (htAdd (wStart w) (wLen w)) h)
-- The decay floor of design sec 4 (Q-S6-5 (a)). At the clamped height hc
-- the floor is so - (so - m)(hc - s)/wl, with the window start s, the
-- window length wl, startOut so and minOut m. The test o >= floor is
-- wl*o + hc*so + s*m >= wl*so + hc*m + s*so: it has no subtraction and
-- no division. decayTest wl s hc o so m says yes when the quote output o
-- is at or above the floor. Bounds: wl <= 2^32, s <= 2^32 - 1,
-- hc < 2^33 and each amount <= 2^64 - 1, thus each product is below 2^97
-- and each side is below 2^98, in the word.
def decayTest : Height -> Height -> Height -> Amount -> Amount -> Amount -> Sum Unit Unit :=
  fun (wl : Height) (s : Height) (hc : Height) (o : Amount) (so : Amount) (m : Amount) =>
    amLe (amAdd (amScale wl so) (amAdd (amScale hc m) (amScale s so)))
      (amAdd (amScale wl o) (amAdd (amScale hc so) (amScale s m)))
-- decayAt i h o m is the decay test of the intent i at the height h, for
-- the open quote output o and the open minOut m. It does not use open.
def decayAt : Intent -> Height -> Amount -> Amount -> Sum Unit Unit :=
  fun (i : Intent) (h : Height) (o : Amount) (m : Amount) =>
    decayTest (wLen (itWindow i)) (wStart (itWindow i)) (wClamp (itWindow i) h) o (itStartOut i) m
-- cross i q h is the sealed decay test: the quote output and minOut stay
-- sealed (Q-S6-3 (a)).
def cross : Intent -> Quote -> Height -> Sealed (Sum Unit Unit) :=
  fun (i : Intent) (q : Quote) (h : Height) =>
    encMap2 Amount Amount (Sum Unit Unit) (fun (o : Amount) (m : Amount) => decayAt i h o m) (qtOut q) (itMinOut i)
-- settleOut i q is the two transfers of a fill: amtIn from the owner to
-- the solver, and the quote output from the solver to the owner.
def settleOut : Intent -> Quote -> Outcome :=
  fun (i : Intent) (q : Quote) =>
    settled (transfer (itInTok i) (open Amount (itAmtIn i)) (itOwner i) (qtSolver q))
      (transfer (itOutTok i) (open Amount (qtOut q)) (qtSolver q) (itOwner i))
-- The laws of the swap (S6, design sec 4). vdOk and vdBad are the two
-- steps down a chain of checks: a check with the flag yes gives the rest
-- of the chain, and a check with the flag no gives reject with its reason.
law def vdOk : (A : Type 0) -> (f : Sum Unit Unit) -> (w : Reason) -> (v : Verdict A) -> Path (Sum Unit Unit) f (inr unit) -> Path (Verdict A) (vdCheck A f w v) v :=
  fun (A : Type 0) (f : Sum Unit Unit) (w : Reason) (v : Verdict A) (p : Path (Sum Unit Unit) f (inr unit)) =>
    cong (fun (b : Sum Unit Unit) => vdCheck A b w v) p
law def vdBad : (A : Type 0) -> (f : Sum Unit Unit) -> (w : Reason) -> (v : Verdict A) -> Path (Sum Unit Unit) f (inl unit) -> Path (Verdict A) (vdCheck A f w v) (reject A w) :=
  fun (A : Type 0) (f : Sum Unit Unit) (w : Reason) (v : Verdict A) (p : Path (Sum Unit Unit) f (inl unit)) =>
    cong (fun (b : Sum Unit Unit) => vdCheck A b w v) p
-- S2 (Q-S6-5 (a)): open of a sealed map with two arguments is the map of
-- the open values. Thus the sealed decay test cross gives the decay test
-- of the open quote output and the open minOut.
law def openMap2 : (A : Type 0) -> (B : Type 0) -> (C : Type 0) -> (g : A -> B -> C) -> (m : Sealed A) -> (n : Sealed B) -> Path C (open C (encMap2 A B C g m n)) (g (open A m) (open B n)) :=
  fun (A : Type 0) (B : Type 0) (C : Type 0) (g : A -> B -> C) (m : Sealed A) (n : Sealed B) =>
    elim (fun (s : Sealed A) => Path C (open C (encMap2 A B C g s n)) (g (open A s) (open B n)))
      (fun (a : A) =>
        elim (fun (t : Sealed B) => Path C (open C (encMap2 A B C g (seal A a) t)) (g a (open B t))) (fun (b : B) => refl) n) m
law def s2Cross : (i : Intent) -> (q : Quote) -> (h : Height) -> Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (decayAt i h (open Amount (qtOut q)) (open Amount (itMinOut i))) :=
  fun (i : Intent) (q : Quote) (h : Height) =>
    openMap2 Amount Amount (Sum Unit Unit) (fun (o : Amount) (m : Amount) => decayAt i h o m) (qtOut q) (itMinOut i)
-- S5: the outcome of a fill entry is its two legs. Both legs are in one
-- entry, or the entry is not in the log.
def fillOutcome : Fill -> Outcome :=
  fun (f : Fill) => settled (flLegIn f) (flLegOut f)
law def s5Fill : (f : Fill) -> Path Outcome (fillOutcome f) (settled (flLegIn f) (flLegOut f)) :=
  fun (f : Fill) => refl
-- The governance of design sec 5 (S7). Members is the committee: a list of
-- keys. A Pair is a token pair that the Params admit for a swap.
family Members := mbNil | mbCons (mbHead : Key) (mbTail : Members)
family Pair := tradePair (paIn : Token) (paOut : Token)
family Pairs := paNil | paCons (paHead : Pair) (paTail : Pairs)
-- The price list of langc serve (Q-S0-11 (b), Q-S7-1 (a)): three tiers in
-- cents. The genesis tiers are 1, 5 and 20. Each tier is in the range 1 to
-- 20: pcTier x says yes when 1 <= x <= pcMax, and pcIn says yes when the
-- three tiers are in the range.
family Prices := prices (pcLow : Amount) (pcBuild : Amount) (pcExport : Amount)
def pcMax : Amount :=
  amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc (amSucc amZero)))))))))))))))))))
-- amCase x is inl unit at zero, else inr of the predecessor. amLeLin x y is
-- amLe x y in about x * y steps. The eval of an elim computes each recursive
-- value first, thus the inner elim of amLe takes about C(x + y, x) steps
-- (amLe 20 20 reaches the arena limit). amLeLin does a case on amCase y in
-- place of the inner elim.
def amCase : Amount -> Sum Unit Amount :=
  fun (x : Amount) => elim (fun (a : Amount) => Sum Unit Amount) (inl unit) (fun (a : Amount) (ih : Sum Unit Amount) => inr a) x
def amLeLin : Amount -> Amount -> Sum Unit Unit :=
  fun (x : Amount) => elim (fun (a : Amount) => Amount -> Sum Unit Unit)
    (fun (y : Amount) => inr unit)
    (fun (a : Amount) (ih : Amount -> Sum Unit Unit) => fun (y : Amount) =>
      elim (fun (s : Sum Unit Amount) => Sum Unit Unit) (fun (u : Unit) => inl unit) (fun (b : Amount) => ih b) (amCase y)) x
def pcTier : Amount -> Sum Unit Unit :=
  fun (x : Amount) => sAnd (amLeLin (amSucc amZero) x) (amLeLin x pcMax)
def pcIn : Prices -> Sum Unit Unit :=
  fun (p : Prices) => sAnd (pcTier (pcLow p)) (sAnd (pcTier (pcBuild p)) (pcTier (pcExport p)))
-- tMin is the static floor of the threshold (Q-S0-9 (a)): 2.
def tMin : Height := htSucc (htSucc htZero)
-- Params (Q-S7-1 (a)): the committee, the threshold prT, the amend quorum
-- prQuorum, the token pairs, the price list and two proof fields. prFloor
-- is the floor tMin <= prT (law G3) and prRange is the price range. A
-- proof field names an earlier field. A closed Params with a proof field
-- that the kernel cannot check gives REFUSE_FLOOR.
family Params := params (prMembers : Members) (prT : Height) (prQuorum : Height) (prPairs : Pairs) (prPrices : Prices) (prFloor : Path (Sum Unit Unit) (htLe tMin prT) (inr unit)) (prRange : Path (Sum Unit Unit) (pcIn prPrices) (inr unit))
-- A statement is what a certificate signs (Q-S7-3 (a)): a fill (the
-- nullifier and the height) or an amendment (the Root digest and the
-- height), or a withdrawal (the key, the token, the amount and the
-- height; USER ruling, S7 session 5). A certificate is a statement and
-- a list of signatures.
family Statement := smFill (smNf : Nullifier) (smAt : Height) | smAmend (smRoot : Root) (smAmAt : Height) | smWithdraw (smWdKey : Key) (smWdTok : Token) (smWdAmt : Amount) (smWdAt : Height)
family Sigs := csNil | csCons (csKey : Key) (csSig : Sig) (csRest : Sigs)
family Certificate := certificate (ctStmt : Statement) (ctSigs : Sigs)
-- The equality words of S7 (inr unit is "equal").
def keyEq : Key -> Key -> Sum Unit Unit :=
  fun (a : Key) (b : Key) => elim (fun (u : Key) => Sum Unit Unit)
    (fun (i : Nat) => elim (fun (v : Key) => Sum Unit Unit)
      (fun (j : Nat) => flagIf (natEq i j) (inr unit) (inl unit)) b) a
def rootEq : Root -> Root -> Sum Unit Unit :=
  fun (a : Root) (b : Root) => elim (fun (u : Root) => Sum Unit Unit)
    (fun (i : Nat) => elim (fun (v : Root) => Sum Unit Unit)
      (fun (j : Nat) => flagIf (natEq i j) (inr unit) (inl unit)) b) a
def htEq : Height -> Height -> Sum Unit Unit :=
  fun (a : Height) (b : Height) => sAnd (htLe a b) (htLe b a)
def amEq : Amount -> Amount -> Sum Unit Unit :=
  fun (a : Amount) (b : Amount) => sAnd (amLeLin a b) (amLeLin b a)
def smEq : Statement -> Statement -> Sum Unit Unit :=
  fun (s : Statement) (t : Statement) =>
    elim (fun (u : Statement) => Sum Unit Unit)
      (fun (n : Nullifier) (h : Height) => elim (fun (v : Statement) => Sum Unit Unit)
        (fun (m : Nullifier) (g : Height) => sAnd (nfEq n m) (htEq h g))
        (fun (r : Root) (g : Height) => inl unit)
        (fun (j : Key) (o : Token) (y : Amount) (g : Height) => inl unit) t)
      (fun (r : Root) (h : Height) => elim (fun (v : Statement) => Sum Unit Unit)
        (fun (m : Nullifier) (g : Height) => inl unit)
        (fun (o : Root) (g : Height) => sAnd (rootEq r o) (htEq h g))
        (fun (j : Key) (o : Token) (y : Amount) (g : Height) => inl unit) t)
      (fun (k : Key) (w : Token) (x : Amount) (h : Height) => elim (fun (v : Statement) => Sum Unit Unit)
        (fun (m : Nullifier) (g : Height) => inl unit)
        (fun (o : Root) (g : Height) => inl unit)
        (fun (j : Key) (o : Token) (y : Amount) (g : Height) => sAnd (keyEq k j) (sAnd (tkEq w o) (sAnd (amEq x y) (htEq h g)))) t) s
-- mbHas k m says yes when the key k is in the committee m. csHas k s says
-- yes when s has a signature from the key k (sgVrf until S8b).
def mbHas : Key -> Members -> Sum Unit Unit :=
  fun (k : Key) (m : Members) =>
    elim (fun (t : Members) => Sum Unit Unit) (inl unit) (fun (j : Key) (r : Members) (ih : Sum Unit Unit) => sOr (keyEq k j) ih) m
def csHas : Key -> Sigs -> Sum Unit Unit :=
  fun (k : Key) (s : Sigs) =>
    elim (fun (t : Sigs) => Sum Unit Unit) (inl unit) (fun (j : Key) (g : Sig) (r : Sigs) (ih : Sum Unit Unit) => sOr (sAnd (keyEq k j) (sgVrf k g)) ih) s
-- ctCount m s is the count of the distinct members of m with a signature
-- in s: a member counts once, at its last place in m.
def ctCount : Members -> Sigs -> Height :=
  fun (m : Members) (s : Sigs) =>
    elim (fun (t : Members) => Height) htZero
      (fun (k : Key) (r : Members) (ih : Height) =>
        elim (fun (b : Sum Unit Unit) => Height) (fun (u : Unit) => ih) (fun (u : Unit) => htSucc ih) (sAnd (csHas k s) (sNot (mbHas k r)))) m
-- ctCheck m k s c (Q-S7-3 (a), gavel-lang checkCert) says yes when the
-- certificate c signs the statement s and at least k distinct members of
-- m signed it.
def ctCheck : Members -> Height -> Statement -> Certificate -> Sum Unit Unit :=
  fun (m : Members) (k : Height) (s : Statement) (c : Certificate) =>
    sAnd (smEq s (ctStmt c)) (htLe k (ctCount m (ctSigs c)))
-- vdWith A s w gives reject A w when s says no. When s says yes, it gives
-- k of the path from s to yes: thus k can build a proof field.
def vdWith : (A : Type 0) -> (s : Sum Unit Unit) -> Reason -> (Path (Sum Unit Unit) s (inr unit) -> Verdict A) -> Verdict A :=
  fun (A : Type 0) (s : Sum Unit Unit) (w : Reason) =>
    elim (fun (b : Sum Unit Unit) => (Path (Sum Unit Unit) b (inr unit) -> Verdict A) -> Verdict A)
      (fun (u : Unit) (g : Path (Sum Unit Unit) (inl u) (inr unit) -> Verdict A) => reject A w)
      (fun (u : Unit) => elim (fun (v : Unit) => (Path (Sum Unit Unit) (inr v) (inr unit) -> Verdict A) -> Verdict A)
        (fun (g : Path (Sum Unit Unit) (inr unit) (inr unit) -> Verdict A) => g refl) u) s
-- certOpen A p c s x is the certified open (Q-S7-3 (a)): reject badCert
-- when c does not give prT p signatures of the members of p on s, else
-- accept of the open value of x.
def certOpen : (A : Type 0) -> Params -> Certificate -> Statement -> Sealed A -> Verdict A :=
  fun (A : Type 0) (p : Params) (c : Certificate) (s : Statement) (x : Sealed A) =>
    vdCheck A (ctCheck (prMembers p) (prT p) s c) badCert (accept A (open A x))
-- The amendment of design sec 5 (Q-S7-2 (a)): the new committee, the
-- threshold, the quorum, the pairs, the prices and the Root digest of the
-- text. It has no proof fields: amend builds them.
family Amendment := amendment (adMembers : Members) (adT : Height) (adQuorum : Height) (adPairs : Pairs) (adPrices : Prices) (adRoot : Root)
-- The log entries (Q-S7-6 (a)): a fill, an amendment, a deposit and a
-- withdrawal, each with its height. The Log is not indexed by Params.
family Entry := enFill (efIntent : Intent) (efQuote : Quote) (efCert : Certificate) (efAt : Height) | enAmend (eaAmend : Amendment) (eaCert : Certificate) (eaAt : Height) | enDeposit (edKey : Key) (edTok : Token) (edAmt : Amount) (edAt : Height) | enWithdraw (ewKey : Key) (ewTok : Token) (ewAmt : Amount) (ewCert : Certificate) (ewAt : Height)
family Log := lgNil | lgCons (lgHead : Entry) (lgTail : Log)
-- The book of S7 (Q-S7-5 (a)): a journal of account rows and the spent
-- nullifiers. A credit adds the row (k, t, x, 0) and a debit adds the row
-- (k, t, 0, x). The balance of the key k at the token t is the sum of the
-- credits less the sum of the debits of the rows of k and t.
family Acct := acct (acKey : Key) (acTok : Token) (acCredit : Amount) (acDebit : Amount)
family Accts := acNil | acCons (acHead : Acct) (acTail : Accts)
family Book := book (bkAccts : Accts) (bkSpent : Spent)
-- The state of the replay: the Params in force, the Params of the next
-- height (G2), the height of the last amendment and the book. The name is
-- GovState, because State is the program state of a guest (USER ruling,
-- S7 session 3).
family GovState := govState (ssCur : Params) (ssNext : Params) (ssAt : Height) (ssBook : Book)
-- acMine k t a says yes when the row a is of the key k and the token t.
-- acIn and acOut are the sums of the credits and of the debits of k and t.
def acMine : Key -> Token -> Acct -> Sum Unit Unit :=
  fun (k : Key) (t : Token) (a : Acct) => sAnd (keyEq k (acKey a)) (tkEq t (acTok a))
def acIn : Key -> Token -> Accts -> Amount :=
  fun (k : Key) (t : Token) (l : Accts) =>
    elim (fun (r : Accts) => Amount) amZero
      (fun (a : Acct) (r : Accts) (ih : Amount) =>
        elim (fun (s : Sum Unit Unit) => Amount) (fun (u : Unit) => ih) (fun (u : Unit) => amAdd (acCredit a) ih) (acMine k t a)) l
def acOut : Key -> Token -> Accts -> Amount :=
  fun (k : Key) (t : Token) (l : Accts) =>
    elim (fun (r : Accts) => Amount) amZero
      (fun (a : Acct) (r : Accts) (ih : Amount) =>
        elim (fun (s : Sum Unit Unit) => Amount) (fun (u : Unit) => ih) (fun (u : Unit) => amAdd (acDebit a) ih) (acMine k t a)) l
-- The book words: bkCredit and bkDebit add a row. bkCan k t x b says yes
-- when k can pay x of t: the debits and x are at most the credits
-- (amLeLin). bkSpend adds a spent nullifier; bkHas says yes when the
-- nullifier is spent.
def bkCredit : Key -> Token -> Amount -> Book -> Book :=
  fun (k : Key) (t : Token) (x : Amount) (b : Book) => book (acCons (acct k t x amZero) (bkAccts b)) (bkSpent b)
def bkDebit : Key -> Token -> Amount -> Book -> Book :=
  fun (k : Key) (t : Token) (x : Amount) (b : Book) => book (acCons (acct k t amZero x) (bkAccts b)) (bkSpent b)
def bkCan : Key -> Token -> Amount -> Book -> Sum Unit Unit :=
  fun (k : Key) (t : Token) (x : Amount) (b : Book) => amLeLin (amAdd (acOut k t (bkAccts b)) x) (acIn k t (bkAccts b))
def bkSpend : Nullifier -> Book -> Book :=
  fun (n : Nullifier) (b : Book) => book (bkAccts b) (spCons n (bkSpent b))
def bkHas : Nullifier -> Book -> Sum Unit Unit :=
  fun (n : Nullifier) (b : Book) => spHas n (bkSpent b)
-- The pair check of settle: the two tokens are not equal and the Params
-- list the pair. paHas a b l says yes when l has the pair (a, b).
def paHas : Token -> Token -> Pairs -> Sum Unit Unit :=
  fun (a : Token) (b : Token) (l : Pairs) =>
    elim (fun (t : Pairs) => Sum Unit Unit) (inl unit) (fun (r : Pair) (s : Pairs) (ih : Sum Unit Unit) => sOr (sAnd (tkEq a (paIn r)) (tkEq b (paOut r))) ih) l
def paOk : Params -> Intent -> Sum Unit Unit :=
  fun (p : Params) (i : Intent) => sAnd (sNot (tkEq (itInTok i) (itOutTok i))) (paHas (itInTok i) (itOutTok i) (prPairs p))
-- The funds of a fill (Q-S7-5 (a)): fdFlag b i q says yes when the owner
-- can pay amtIn of the in token and the solver can pay the quote output
-- of the out token. fdPick f i q is the two transfers of settleOut on yes
-- and unfilled on no.
def fdFlag : Book -> Intent -> Quote -> Sum Unit Unit :=
  fun (b : Book) (i : Intent) (q : Quote) =>
    sAnd (bkCan (itOwner i) (itInTok i) (open Amount (itAmtIn i)) b) (bkCan (qtSolver q) (itOutTok i) (open Amount (qtOut q)) b)
def fdPick : Sum Unit Unit -> Intent -> Quote -> Outcome :=
  fun (f : Sum Unit Unit) (i : Intent) (q : Quote) =>
    elim (fun (s : Sum Unit Unit) => Outcome) (fun (u : Unit) => unfilled) (fun (u : Unit) => settleOut i q) f
-- settle p b i q c h (S7, Q-S7-3 (a), Q-S7-5 (a)) is a chain of checks,
-- with the first check outermost: reused (the spent nullifiers of the
-- book b), expired, badPair (the pairs of the Params p), badProof,
-- badCert, belowFloor. Then the funds tail gives the two transfers or
-- unfilled. Each check has a named tail: settleRest is the checks 2 to 6,
-- settlePair 3 to 6, settleProof 4 to 6, settleCert 5 and 6, settleFloor
-- the check 6 and settleFunds the funds tail. The certificate c signs the
-- fill statement (the nullifier and the height h), and the floor test
-- opens the sealed values only after the certificate check (the shape of
-- certOpen).
def settleFunds : Book -> Intent -> Quote -> Outcome :=
  fun (b : Book) (i : Intent) (q : Quote) => fdPick (fdFlag b i q) i q
def settleFloor : Book -> Intent -> Quote -> Height -> Verdict Outcome :=
  fun (b : Book) (i : Intent) (q : Quote) (h : Height) =>
    vdCheck Outcome (open (Sum Unit Unit) (cross i q h)) belowFloor (accept Outcome (settleFunds b i q))
def settleCert : Params -> Book -> Intent -> Quote -> Certificate -> Height -> Verdict Outcome :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) =>
    vdCheck Outcome (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) badCert (settleFloor b i q h)
def settleProof : Params -> Book -> Intent -> Quote -> Certificate -> Height -> Verdict Outcome :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) =>
    vdCheck Outcome (sgVrf (itOwner i) (itSig i)) badProof (settleCert p b i q c h)
def settlePair : Params -> Book -> Intent -> Quote -> Certificate -> Height -> Verdict Outcome :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) =>
    vdCheck Outcome (paOk p i) badPair (settleProof p b i q c h)
def settleRest : Params -> Book -> Intent -> Quote -> Certificate -> Height -> Verdict Outcome :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) =>
    vdCheck Outcome (htLe h (itDeadline i)) expired (settlePair p b i q c h)
def settle : Params -> Book -> Intent -> Quote -> Certificate -> Height -> Verdict Outcome :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) =>
    vdCheck Outcome (sNot (bkHas (itNf i) b)) reused (settleRest p b i q c h)
-- govAmend p a c h (design sec 5, Q-S7-2 (a)) gives reject badCert when c
-- does not give prQuorum p signatures of the members of p on the
-- amendment statement (the Root digest of a and the height h), reject
-- belowTMin when the new threshold is below tMin, and reject badPrice
-- when a new price tier is out of the range. Else it gives accept of the
-- new Params, with the two paths of vdWith as the proof fields. The name
-- is govAmend, because amend is a guest name (rule R4, USER ruling, S7
-- session 4).
def govAmend : Params -> Amendment -> Certificate -> Height -> Verdict Params :=
  fun (p : Params) (a : Amendment) (c : Certificate) (h : Height) =>
    vdCheck Params (ctCheck (prMembers p) (prQuorum p) (smAmend (adRoot a) h) c) badCert
      (vdWith Params (htLe tMin (adT a)) belowTMin
        (fun (f : Path (Sum Unit Unit) (htLe tMin (adT a)) (inr unit)) =>
          vdWith Params (pcIn (adPrices a)) badPrice
            (fun (g : Path (Sum Unit Unit) (pcIn (adPrices a)) (inr unit)) =>
              accept Params (params (adMembers a) (adT a) (adQuorum a) (adPairs a) (adPrices a) f g))))
-- S1 on the settle of S7: when the six flags and the funds flag are yes,
-- settle gives accept with the two transfers of settleOut. When the six
-- flags are yes and the funds flag is no, settle gives accept with
-- unfilled. When the flags before a check are yes and the flag of that
-- check is no, settle gives reject with its reason. Each law is a trans
-- chain of vdOk, then one vdBad or one cong on the funds flag.
law def s1Accept : (p : Params) -> (b : Book) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> (h : Height) -> Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit) -> Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit) -> Path (Sum Unit Unit) (paOk p i) (inr unit) -> Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i)) (inr unit) -> Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inr unit) -> Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (inr unit) -> Path (Sum Unit Unit) (fdFlag b i q) (inr unit) -> Path (Verdict Outcome) (settle p b i q c h) (accept Outcome (settleOut i q)) :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) (p1 : Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit)) (p2 : Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit)) (p3 : Path (Sum Unit Unit) (paOk p i) (inr unit)) (p4 : Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i)) (inr unit)) (p5 : Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inr unit)) (p6 : Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (inr unit)) (p7 : Path (Sum Unit Unit) (fdFlag b i q) (inr unit)) =>
    trans (Verdict Outcome) (settle p b i q c h) (settleRest p b i q c h) (accept Outcome (settleOut i q))
      (vdOk Outcome (sNot (bkHas (itNf i) b)) reused (settleRest p b i q c h) p1)
      (trans (Verdict Outcome) (settleRest p b i q c h) (settlePair p b i q c h) (accept Outcome (settleOut i q))
        (vdOk Outcome (htLe h (itDeadline i)) expired (settlePair p b i q c h) p2)
        (trans (Verdict Outcome) (settlePair p b i q c h) (settleProof p b i q c h) (accept Outcome (settleOut i q))
          (vdOk Outcome (paOk p i) badPair (settleProof p b i q c h) p3)
          (trans (Verdict Outcome) (settleProof p b i q c h) (settleCert p b i q c h) (accept Outcome (settleOut i q))
            (vdOk Outcome (sgVrf (itOwner i) (itSig i)) badProof (settleCert p b i q c h) p4)
            (trans (Verdict Outcome) (settleCert p b i q c h) (settleFloor b i q h) (accept Outcome (settleOut i q))
              (vdOk Outcome (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) badCert (settleFloor b i q h) p5)
              (trans (Verdict Outcome) (settleFloor b i q h) (accept Outcome (settleFunds b i q)) (accept Outcome (settleOut i q))
                (vdOk Outcome (open (Sum Unit Unit) (cross i q h)) belowFloor (accept Outcome (settleFunds b i q)) p6)
                (cong (fun (f : Sum Unit Unit) => accept Outcome (fdPick f i q)) p7))))))
law def s1Unfilled : (p : Params) -> (b : Book) -> (i : Intent) -> (q : Quote) -> (c : Certificate) -> (h : Height) -> Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit) -> Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit) -> Path (Sum Unit Unit) (paOk p i) (inr unit) -> Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i)) (inr unit) -> Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inr unit) -> Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (inr unit) -> Path (Sum Unit Unit) (fdFlag b i q) (inl unit) -> Path (Verdict Outcome) (settle p b i q c h) (accept Outcome unfilled) :=
  fun (p : Params) (b : Book) (i : Intent) (q : Quote) (c : Certificate) (h : Height) (p1 : Path (Sum Unit Unit) (sNot (bkHas (itNf i) b)) (inr unit)) (p2 : Path (Sum Unit Unit) (htLe h (itDeadline i)) (inr unit)) (p3 : Path (Sum Unit Unit) (paOk p i) (inr unit)) (p4 : Path (Sum Unit Unit) (sgVrf (itOwner i) (itSig i)) (inr unit)) (p5 : Path (Sum Unit Unit) (ctCheck (prMembers p) (prT p) (smFill (itNf i) h) c) (inr unit)) (p6 : Path (Sum Unit Unit) (open (Sum Unit Unit) (cross i q h)) (inr unit)) (z7 : Path (Sum Unit Unit) (fdFlag b i q) (inl unit)) =>
    trans (Verdict Outcome) (settle p b i q c h) (settleRest p b i q c h) (accept Outcome unfilled)
