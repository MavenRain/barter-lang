-- The BN254 moduli (quorum-lang src/crypto/bn254.h): r for Fr, p for Fp.
def frMod : FeMod := feMod (fe 0xf0000001w 0x43e1f593w 0x79b97091w 0x2833e848w 0x8181585dw 0xb85045b6w 0xe131a029w 0x30644e72w) 0xefffffffw (fe 0xae216da7w 0x1bb8e645w 0xe35c59e3w 0x53fe3ab1w 0x53bb8085w 0x8c49833dw 0x7f4e44a5w 0x0216d0b1w) (fe 0x4ffffffbw 0xac96341cw 0x9f60cd29w 0x36fc7695w 0x7879462ew 0x666ea36fw 0x9a07df2fw 0x0e0a77c1w) frE0
def fpMod : FeMod := feMod (fe 0xd87cfd47w 0x3c208c16w 0x6871ca8dw 0x97816a91w 0x8181585dw 0xb85045b6w 0xe131a029w 0x30644e72w) 0xe4866389w (fe 0x538afa89w 0xf32cfc5bw 0xd44501fbw 0xb5e71911w 0x0a417ff6w 0x47ab1effw 0xcab8351fw 0x06d89f71w) (fe 0xc58f0d9dw 0xd35d438dw 0xf5c70b3dw 0x0a78eb28w 0x7879462cw 0x666ea36fw 0x9a07df2fw 0x0e0a77c1w) fpE0
-- fePowFrom md a e x is x^(2^n) a^e for the n bits of e (the top bit first),
-- in Montgomery form. Each bit squares the value, and a 1 bit then multiplies
-- it by a.
def fePowFrom : FeMod -> Fe -> FeBits -> Fe -> Fe :=
  fun (md : FeMod) (a : Fe) (e : FeBits) => elim (fun (k : FeBits) => Fe -> Fe)
    (fun (x : Fe) => x)
    (fun (t : FeBits) (ih : Fe -> Fe) => fun (x : Fe) => ih (feMul md x x))
    (fun (t : FeBits) (ih : Fe -> Fe) => fun (x : Fe) => ih (feMul md (feMul md x x) a)) e
-- fePow md a e is a^e. The start value is R mod m (1 in Montgomery form).
def fePow : FeMod -> Fe -> FeBits -> Fe :=
  fun (md : FeMod) (a : Fe) (e : FeBits) => fePowFrom md a e (modR1 md)
-- feInv md a is a^(m - 2) (Fermat). It is the inverse of a when a is not 0,
-- and 0 when a is 0.
def feInv : FeMod -> Fe -> Fe := fun (md : FeMod) (a : Fe) => fePow md a (modE md)
-- The scalar field Fr (modulus r, frMod) and the base field Fp (modulus p,
-- fpMod). A value is an Fe in Montgomery form.
def Fr : Type 0 := Fe
def Fp : Type 0 := Fe
-- S8b2 (USER ruling Q-S8b2-1 (a)): the BN254 group G1, y^2 = x^3 + 3 over
-- Fp. A Pt1 is an affine point. Its coordinates are in Montgomery form. The
-- point (0, 0) is the point at infinity (it is not on the curve). Each op
-- takes the modulus md (fpMod for G1) and does the steps of bn254.c
-- (quorum-lang src/crypto): ec0_jac_double, ec0_jac_add_affine,
-- ec0_jac_affine and ec0_mul.
family Pt1 := pt1 (ptX : Fe) (ptY : Fe)
-- A Jac1 is a point (X, Y, Z) in Jacobian form: the affine point (X / Z^2,
-- Y / Z^3). Z = 0 is the point at infinity.
family Jac1 := jac1 (jcX : Fe) (jcY : Fe) (jcZ : Fe)
-- A step count for the bit loop of ptMul (pc32 holds 32 steps).
family PtCount := pcEnd | pcStep (pcNext : PtCount)
def ptInf : Pt1 := pt1 feZero feZero
def jcInf : Jac1 := jac1 feZero feZero feZero
-- jcLet x k is k x, and ptLet x k is k x. Each binds one field value.
def jcLet : Fe -> (Fe -> Jac1) -> Jac1 := fun (x : Fe) (k : Fe -> Jac1) => k x
def ptLet : Fe -> (Fe -> Pt1) -> Pt1 := fun (x : Fe) (k : Fe -> Pt1) => k x
-- ptIsInf p is inr unit when p is (0, 0).
def ptIsInf : Pt1 -> Sum Unit Unit := fun (p : Pt1) => feAll (feIsZero (ptX p)) (fun (u : Unit) => feIsZero (ptY p))
-- ptEq p q is inr unit when p and q have the same coordinates.
def ptEq : Pt1 -> Pt1 -> Sum Unit Unit := fun (p : Pt1) (q : Pt1) => feAll (feEq (ptX p) (ptX q)) (fun (u : Unit) => feEq (ptY p) (ptY q))
-- ptOnCurve md p is inr unit when each coordinate is less than the modulus
-- and p is the point at infinity or y^2 = x^3 + 3. The constant 3 in
-- Montgomery form is 3 times modR1 md.
def ptOnCurve : FeMod -> Pt1 -> Sum Unit Unit :=
  fun (md : FeMod) (p : Pt1) =>
    feAll (feLt (ptX p) (modM md)) (fun (u : Unit) =>
    feAll (feLt (ptY p) (modM md)) (fun (u1 : Unit) =>
    either (fun (u2 : Unit) => feEq (feMul md (ptY p) (ptY p)) (feAdd md (feMul md (feMul md (ptX p) (ptX p)) (ptX p)) (feAdd md (feAdd md (modR1 md) (modR1 md)) (modR1 md))))
      (fun (u2 : Unit) => feYes)
      (ptIsInf p)))
-- ptDbl md a is 2 a (ec0_jac_double): S = 4 X Y^2, M = 3 X^2, X3 = M^2 - 2 S,
-- Y3 = M (S - X3) - 8 Y^4, Z3 = 2 Y Z. It is the point at infinity when Z = 0
-- or Y = 0.
def ptDbl : FeMod -> Jac1 -> Jac1 :=
