-- the inverse ni of that sum.
def f2InvBy : (Fe -> Fe -> Fe) -> Fp2 -> Fe -> Fp2 :=
  fun (mul : Fe -> Fe -> Fe) (a : Fp2) (ni : Fe) => fp2 (mul (f2A a) ni) (f2FeNeg (mul (f2B a) ni))
