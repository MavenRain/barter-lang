    lnLet (lnXor c1 (lnRot c3 1w 31w)) (fun (d2 : Lane) =>
    lnLet (lnXor c2 (lnRot c4 1w 31w)) (fun (d3 : Lane) =>
    lnLet (lnXor c3 (lnRot c0 1w 31w)) (fun (d4 : Lane) =>
