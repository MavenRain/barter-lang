-- Q-S5-7 (a): the table keeps the bound of twice; one more product
-- goes above the 128-bit word: REFUSE_BOUND.
def twice : Height -> Amount -> Amount :=
  fun (k : Height) (a : Amount) => amScale k (amScale k a)
def thrice : Height -> Amount -> Amount :=
  fun (k : Height) (a : Amount) => amScale k (twice k a)
