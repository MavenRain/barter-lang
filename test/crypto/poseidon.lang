-- The Poseidon oracle rows (S8b2, Q-S8b2-18 (a)). A psPermC row compares the
-- guest permutation with the native product (Q-S8b2-15 (a)) with
-- poseidon_perm of the C oracle (src/crypto/poseidon.c) on a canonical state:
-- oPsPerm puts each element in Montgomery form and psOut takes each result
-- out. A psHashC row compares poseidon2 with element 0 of the C permutation of
-- (0, a, b), and a psHashG row does the same with the guest feMul (the
-- specification). These rows are not in test/crypto/crypto.lang: each heavy
-- family of rows has its own kit file (Q-S8b2-14 (a)). This is a kit file
-- outside the Wasm set. test/gate.sh evaluates each row with `langc --kit
-- eval`.
def psOut : PState -> Fe -> Fe -> Fe -> Nat := fun (s : PState) (u : Fe) (v : Fe) (w : Fe) => either (fun (x : Unit) => 0) (fun (x : Unit) => 1) (feAll (feEq (psMulC (ps0 s) feOne) u) (fun (x : Unit) => feAll (feEq (psMulC (ps1 s) feOne) v) (fun (y : Unit) => feEq (psMulC (ps2 s) feOne) w)))
def oPsPerm : Fe -> Fe -> Fe -> Fe -> Fe -> Fe -> Nat := fun (a : Fe) (b : Fe) (c : Fe) (u : Fe) (v : Fe) (w : Fe) => psOut (psPerm psMulC (pstate (psMulC a (modR2 frMod)) (psMulC b (modR2 frMod)) (psMulC c (modR2 frMod)))) u v w
def oPsHash : (Fe -> Fe -> Fe) -> Fe -> Fe -> Fe -> Nat := fun (mul : Fe -> Fe -> Fe) (a : Fe) (b : Fe) (h : Fe) => either (fun (x : Unit) => 0) (fun (x : Unit) => 1) (feEq (psHash2 mul a b) h)
def psPermC : Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Nat := fun (a0 : Word) (a1 : Word) (a2 : Word) (a3 : Word) (a4 : Word) (a5 : Word) (a6 : Word) (a7 : Word) (b0 : Word) (b1 : Word) (b2 : Word) (b3 : Word) (b4 : Word) (b5 : Word) (b6 : Word) (b7 : Word) (c0 : Word) (c1 : Word) (c2 : Word) (c3 : Word) (c4 : Word) (c5 : Word) (c6 : Word) (c7 : Word) (u0 : Word) (u1 : Word) (u2 : Word) (u3 : Word) (u4 : Word) (u5 : Word) (u6 : Word) (u7 : Word) (v0 : Word) (v1 : Word) (v2 : Word) (v3 : Word) (v4 : Word) (v5 : Word) (v6 : Word) (v7 : Word) (w0 : Word) (w1 : Word) (w2 : Word) (w3 : Word) (w4 : Word) (w5 : Word) (w6 : Word) (w7 : Word) => oPsPerm (fe a0 a1 a2 a3 a4 a5 a6 a7) (fe b0 b1 b2 b3 b4 b5 b6 b7) (fe c0 c1 c2 c3 c4 c5 c6 c7) (fe u0 u1 u2 u3 u4 u5 u6 u7) (fe v0 v1 v2 v3 v4 v5 v6 v7) (fe w0 w1 w2 w3 w4 w5 w6 w7)
def psHashC : Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Nat := fun (a0 : Word) (a1 : Word) (a2 : Word) (a3 : Word) (a4 : Word) (a5 : Word) (a6 : Word) (a7 : Word) (b0 : Word) (b1 : Word) (b2 : Word) (b3 : Word) (b4 : Word) (b5 : Word) (b6 : Word) (b7 : Word) (h0 : Word) (h1 : Word) (h2 : Word) (h3 : Word) (h4 : Word) (h5 : Word) (h6 : Word) (h7 : Word) => oPsHash psMulC (fe a0 a1 a2 a3 a4 a5 a6 a7) (fe b0 b1 b2 b3 b4 b5 b6 b7) (fe h0 h1 h2 h3 h4 h5 h6 h7)
def psHashG : Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Nat := fun (a0 : Word) (a1 : Word) (a2 : Word) (a3 : Word) (a4 : Word) (a5 : Word) (a6 : Word) (a7 : Word) (b0 : Word) (b1 : Word) (b2 : Word) (b3 : Word) (b4 : Word) (b5 : Word) (b6 : Word) (b7 : Word) (h0 : Word) (h1 : Word) (h2 : Word) (h3 : Word) (h4 : Word) (h5 : Word) (h6 : Word) (h7 : Word) => oPsHash psMulG (fe a0 a1 a2 a3 a4 a5 a6 a7) (fe b0 b1 b2 b3 b4 b5 b6 b7) (fe h0 h1 h2 h3 h4 h5 h6 h7)
-- A psHashN row compares the native poseidon2C (Q-S8b2-30 (a)) with element
-- 0 of the C permutation of (0, a, b), as a psHashC row does. A psHashD row
-- compares poseidon2C with the guest poseidon2 (the specification) on a and b.
def oPsHashN : Fe -> Fe -> Fe -> Nat := fun (a : Fe) (b : Fe) (h : Fe) => either (fun (x : Unit) => 0) (fun (x : Unit) => 1) (feEq (poseidon2C a b) h)
def psHashN : Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Nat := fun (a0 : Word) (a1 : Word) (a2 : Word) (a3 : Word) (a4 : Word) (a5 : Word) (a6 : Word) (a7 : Word) (b0 : Word) (b1 : Word) (b2 : Word) (b3 : Word) (b4 : Word) (b5 : Word) (b6 : Word) (b7 : Word) (h0 : Word) (h1 : Word) (h2 : Word) (h3 : Word) (h4 : Word) (h5 : Word) (h6 : Word) (h7 : Word) => oPsHashN (fe a0 a1 a2 a3 a4 a5 a6 a7) (fe b0 b1 b2 b3 b4 b5 b6 b7) (fe h0 h1 h2 h3 h4 h5 h6 h7)
def psHashD : Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Word -> Nat :=
  fun (a0 : Word) (a1 : Word) (a2 : Word) (a3 : Word) (a4 : Word) (a5 : Word) (a6 : Word) (a7 : Word) (b0 : Word) (b1 : Word) (b2 : Word) (b3 : Word) (b4 : Word) (b5 : Word) (b6 : Word) (b7 : Word) =>
    either (fun (x : Unit) => 0) (fun (x : Unit) => 1) (feEq (poseidon2C (fe a0 a1 a2 a3 a4 a5 a6 a7) (fe b0 b1 b2 b3 b4 b5 b6 b7)) (poseidon2 (fe a0 a1 a2 a3 a4 a5 a6 a7) (fe b0 b1 b2 b3 b4 b5 b6 b7)))
