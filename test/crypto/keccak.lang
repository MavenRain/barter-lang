-- The keccak oracle rows (S8b2, Q-S8b2-14 (a)). oKeccak, oHash160 and
-- oChallenge compare the guest keccak (Q-S8b2-11 (a)) with keccak256 of the C
-- oracle (src/crypto/keccak.c). A kcBlock row gives one padded block as 17
-- lanes (each lane lo, then hi), then the digest as one big-endian number. A
-- kcHash row and a kcChal row give the five 32-byte words of the Schnorr
-- challenge input, then the digest (kcHash) or the digest mod r (kcChal,
-- Q-S8b2-13 (a)). These rows are not in test/crypto/crypto.lang: the check of
-- the keccak defs and a guest ptMul row in one file do not fit in the 1 GiB
-- arena. This is a kit file outside the Wasm set. test/gate.sh evaluates each
-- row with `langc --kit eval`.
def oKeccak : KState -> Fe -> Nat := fun (s : KState) (c : Fe) => either (fun (u : Unit) => 0) (fun (u : Unit) => 1) (feEq (kcDigest (keccakF s)) c)
def oHash160 : Fe -> Fe -> Fe -> Fe -> Fe -> Fe -> Nat := fun (a : Fe) (b : Fe) (c : Fe) (d : Fe) (e : Fe) (h : Fe) => either (fun (u : Unit) => 0) (fun (u : Unit) => 1) (feEq (kcHash160 a b c d e) h)
def oChallenge : Fe -> Fe -> Fe -> Fe -> Fe -> Fe -> Nat := fun (a : Fe) (b : Fe) (c : Fe) (d : Fe) (e : Fe) (h : Fe) => either (fun (u : Unit) => 0) (fun (u : Unit) => 1) (feEq (kcChallenge a b c d e) h)
