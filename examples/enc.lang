-- The Enc monad of the R1 table (S4, PLAN section 3). A program seals a
-- value, maps over it and binds it. It cannot open it: only a law can
-- name open, and a law has no run time. The parameter of Sealed is a base
-- type (Q-S5-3 (a)): Amount here.
def sealedOne : Enc Amount := seal Amount (amSucc amZero)
def sealedTwo : Enc Amount := encMap Amount Amount (fun (n : Amount) => amMax n (amSucc (amSucc amZero))) sealedOne
def boundTwo : Enc Amount := encBind Amount Amount sealedOne (fun (n : Amount) => seal Amount (amMax n (amSucc (amSucc amZero))))
def openTwo : Path Amount (open Amount sealedTwo) (amSucc (amSucc amZero)) := refl
def mapIsBind : Path (Enc Amount) sealedTwo boundTwo := refl
