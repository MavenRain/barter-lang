-- The spend check and settle of design sec 4 on literals (S6, laws S1
-- and N1, Q-S6-4 (a)), kit mode: a guest program gets a Nullifier, a
-- Token or a Key only as an input, thus this file makes them from Nat
-- literals. The spent set holds the nullifier 1. The intent sells 3 of
-- the token 1 for the token 2, with startOut 4, minOut 2, the window
-- that starts at height 1 with the length 2, and the deadline 5. At
-- height 2 the decay floor is 3. The general laws are in
-- domain/domain.lang.
def nfA : Nullifier := nullifier 1
def nfB : Nullifier := nullifier 2
def spentA : Spent := spCons nfA spNil
def hasA : Sum Unit Unit := spHas nfA spentA
def hasB : Sum Unit Unit := spHas nfB spentA
def hasARefl : Path (Sum Unit Unit) hasA (inr unit) := refl
def hasBRefl : Path (Sum Unit Unit) hasB (inl unit) := refl
def ht1 : Height := htSucc htZero
def ht2 : Height := htSucc ht1
def ht5 : Height := htSucc (htSucc (htSucc ht2))
def amt2 : Amount := amSucc (amSucc amZero)
def amt3 : Amount := amSucc amt2
def amt4 : Amount := amSucc amt3
def intentA : Intent := intent (token 1) (token 2) (seal Amount amt3) (seal Amount amt2) (seal Height htZero) amt4 (window ht1 ht1) ht5 nfA (key 7) (sig 7)
def quoteA : Quote := quote (seal Amount amt3) (key 9)
def quoteLow : Quote := quote (seal Amount amt2) (key 9)
-- The nullifier 1 is spent: reject with the reason reused.
def reusedRow : Verdict Outcome := settle spentA intentA quoteA ht2
def reusedRefl : Path (Verdict Outcome) reusedRow (reject Outcome reused) := refl
-- No nullifier is spent and the quote output 3 is at the floor: accept.
def freshRow : Verdict Outcome := settle spNil intentA quoteA ht2
def freshRefl : Path (Verdict Outcome) freshRow (accept Outcome (settled (transfer (token 1) amt3 (key 7) (key 9)) (transfer (token 2) amt3 (key 9) (key 7)))) := refl
-- The quote output 2 is below the floor 3: reject with the reason
-- belowFloor.
def lowRow : Verdict Outcome := settle spNil intentA quoteLow ht2
def lowRefl : Path (Verdict Outcome) lowRow (reject Outcome belowFloor) := refl
